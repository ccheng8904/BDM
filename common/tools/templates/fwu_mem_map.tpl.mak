#*******************************************************************************
#  PROJECT          Generic SW
#*******************************************************************************
#  Description      File contains make variables and definitions for FWU modules
#                   This file is automatically generated, any modification will
#                   be rewritten at the start of build!
#*******************************************************************************
<$macro_start(macro.fwu_module)>
# Module: $1
<$ifdef(module.start_address, define(_mod.start_address, module.start_address))>
<$ifdef(module.size, exec(define(_mod.end_address, calc($(_mod.start_address) + $(module.size) - 1)), define(_mod.size, module.size)))>
<$ifdef(module.end_address, exec(define(_mod.end_address, module.end_address), define(_mod.size, calc($(module.end_address) - $(_mod.start_address) + 1))))>
# Make variables
$1_START_ADDRESS ?= <$subst("0x",,hex(_mod.start_address))>
$1_END_ADDRESS ?= <$subst("0x",,hex(_mod.end_address))>
$1_SIZE ?= <$subst("0x",,hex(_mod.size))>
# Definitions
defines += $1_START_ADDRESS=UINT32_C(<$hex(_mod.start_address)>)
defines += $1_END_ADDRESS=UINT32_C(<$hex(_mod.end_address)>)
defines += $1_SIZE=UINT32_C(<$hex(_mod.size)>)

<$define(_mod.start_address, calc($(_mod.end_address) + 1))>
<$macro_end>

<$foreach(module, $(FWU_MODULE_LIST), macro(macro.fwu_module, module.name))>
