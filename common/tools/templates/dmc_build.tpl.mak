#*******************************************************************************
#  COMPONENT        <$macro("$1_$2 ",$(dmodule),$(dvariant))>
#*******************************************************************************
#  Description      Data component build file
#                   This file is automatically generated, any modification will
#                   be rewritten at the start of build!
#*******************************************************************************

defines += DMODULE_PRESENT
defines += DMODULE_<$toupper($(dmodule))>


# translation units not related to a component
ifeq ($(FW_update_type),FWU3)
     src += <$macro("$1_$2/ModuleHeader_$2.c",$(dmodule),$(dvariant))>
endif
src += <$macro("$1_$2/$1_$2.c",$(dmodule),$(dvariant))>

# additional search paths
search_path += $(app_path)/prog/<$macro("$1_$2 ",$(dmodule),$(dvariant))>
search_path += $(app_path)/prog/dmc

# Version settings (needed for ident.json and ModuleHeader)
# if 'version_build' is not defined git hash will be used
<$macro("uid_$1_$2",$(dmodule),$(dvariant))>              = 12345
<$macro("version_major_$1_$2",$(dmodule),$(dvariant))>    = 1
<$macro("version_minor_$1_$2",$(dmodule),$(dvariant))>    = 2
<$macro("version_revision_$1_$2",$(dmodule),$(dvariant))> = 3
<$macro("version_build_$1_$2",$(dmodule),$(dvariant))>    = 4711
dbus_target_node       ?= 0x$(dbus_node_address)0
release_note           ?= "Make short hint for this release"

<$macro_start(versiondefs)>
defines +=UID_$2_<$toupper($(dvariant))>=UINT64_C(#(call calc,#(uid_$3_$1)))
defines +=VERSION_MAJOR_$2_<$toupper($(dvariant))>=UINT16_C(#(call calc,#(version_major_$3_$1)))
defines +=VERSION_MINOR_$2_<$toupper($(dvariant))>=UINT16_C(#(call calc,#(version_minor_$3_$1)))
defines +=VERSION_REVISION_$2_<$toupper($(dvariant))>=UINT16_C(#(call calc,#(version_revision_$3_$1)))
defines +=VERSION_BUILD_$2_<$toupper($(dvariant))>=UINT32_C(#(call calc,#(version_build_$3_$1)))
<$macro_end>
<$subst("#","$",macro(versiondefs, $(dvariant), toupper($(dmodule)), $(dmodule)))>
# fill unused memory and patch CRC
ifeq ($(FW_update_type),FWU3)
<$macro_start(patchopts)>
    patchbin_opt_proj += -f(0x#(FWU_$1_START_ADDRESS)+#(crc_offset),0x#(FWU_$1_END_ADDRESS)):0xFF
    patchbin_opt_proj += -CRC(0x#(FWU_$1_START_ADDRESS)+#(crc_offset),0x#(FWU_$1_END_ADDRESS))(0x#(FWU_$1_START_ADDRESS)):#(crctype)
else
    patchbin_opt_proj += -f(0x#(FWU_$1_START_ADDRESS),0x#(call calcx,0x#(FWU_$1_END_ADDRESS)-#(crc_offset))):0xFF
    patchbin_opt_proj += -CRC(0x#(FWU_$1_START_ADDRESS),0x#(call calcx,0x#(FWU_$1_END_ADDRESS)-#(crc_offset)))(0x#(call calcx,0x#(FWU_$1_END_ADDRESS)-#(crc_offset)+0x01)):#(crctype)
endif
<$macro_end>
<$subst("#","$",macro(patchopts, toupper($(dmodule))))>
