search_path += common/prog/dbus
search_path += common/prog/MSP/compiler/$(cc_build_path)
search_path += $(msp_path)
search_path += common/prog/MSP
# search_path += $(platform)
search_path += common/prog/ped_fw
search_path += $(app_path)/prog/ped_fw
search_path += $(app_path)/prog/$(msp)
search_path_notcc_cmsis += common/prog/MSP/compiler/nonCCparsers/CMSIS
search_path_notcc += common/prog/MSP/compiler/nonCCparsers
search_path_notcc += $(search_path_notcc_cmsis)

# following search paths are for dbus only which currently is used in old and new frame work as well
# TODO: remove these paths after DBus has been adapted
search_path += common/prog/ped_fw/utility
search_path += common/prog/ped_fw/timer
search_path += common/prog/std_lib
search_path += common/prog/FuncSafe


# leagacy search paths define 'legacy_search_paths' if legacy source need to be translated
ifdef legacy_search_paths
    search_path += common/prog/ped_fw/basic
    search_path += common/prog/ped_fw/schedule
    search_path += common/prog/ped_fw/beat
    search_path += common/prog/ped_fw/seg
    search_path += common/prog/ped_fw/mpx
    search_path += common/prog/ped_fw/stdcrc
    search_path += common/prog/ped_fw/testSupport
    search_path += common/prog/ped_fw/testengine
    search_path += common/prog/ped_fw/veeprom
    search_path += common/prog/ped_fw/exteeprom
    search_path += common/prog/ped_fw/nvmem
    search_path += common/prog/ped_fw/flash
endif

# first paths to search
search_path_implicit += $(sdk_prog_path)
search_path_implicit += $(app_prog_path)

# the following search paths are used in implicit rules
# they search relative to the processed source file path: $(dir $<)
search_path_implicit += $(subst common/prog/,$(app_path)/prog/,$(dir $(patsubst %/,%,$(dir $<))))
search_path_implicit += $(subst common/prog/,$(app_path)/prog/,$(dir $<))
search_path_implicit += $(subst common/prog/,$(app_path)/prog/,$(dir $<))$(platform)

search_path_implicit += $(subst $(app_path)/prog/,common/prog/,$(dir $(patsubst %/,%,$(dir $<))))
search_path_implicit += $(subst $(app_path)/prog/,common/prog/,$(dir $<))
search_path_implicit += $(subst $(app_path)/prog/,common/prog/,$(dir $<))$(platform)


# Include common definitions build file
include common/build/common/defines.mak

# Files generated by make
varHeader           = $(app_path)/prog/$(variant).h
variant_export_xml  = $(out_path)/$(variant)/variant_export.xml
common_export_xml   = $(out_path)/common_export.xml

# Code generator log file
code_gen_log    = $(out_path)/$(variant)/code_gen.log


# Take all LinkerScript.* configuration templates from MSP/$(platform)/cfg_templates
linker_scripts ?= $(patsubst $(msp_path)/cfg_templates%,$(msp)%,$(wildcard $(msp_path)/cfg_templates/LinkerScript.*))

cfgFiles = $(cfg_hdr) $(cfg_files) $(addsuffix .c,$(cfg_obj)) $(cfg_src) $(linker_scripts)
genFiles = $(gen_hdr) $(gen_src) $(gen_files)


# set the placement and name of generated BP2 file for Winflash
# the position of definition this make variable must be before including ccTools.mak file
winflash_cfg_file ?= $(bin_path)/winflash_cfg.bp2

# include ccache makefile - must be before including of ccTools
include common/build/mixed/ccache.mak

# include the settings for selected compiler tool chain
include common/build/$(cc_build_path)/ccTools.mak

#include the settings and recipes for coverage and unit testing
include common/build/mixed/utest_cov.mak

ifdef cc_build_path
    ifeq ($(wildcard $(cc)),)
        $(info Compiler tolchain $(dir $(cc)) not found. Please check if your tool is present on this path)
    endif
endif

ifneq ($(cc_build_path), gccIntel)
link: patchbin
else
link: maksym $(MAKEFILE_LIST)
endif

sym_info: link
	@$(call prntGr,application symbols:)
	@$(python) $(local_tool_path)\Python\filterSymbols.py -s $(sym_file) $(addprefix -n , $(watch_Symbols))

# Targets for which dependencies are not calculated
no_dep_targets += init initcfg gencfg clean cl clean_all rmbin test_derivative debug all help ccinfo var_header -B -sB -wB --always-make

# If PSoC platform, include psoc_creator.mak
ifneq (,$(findstring psoc,$(platform)))
    include common/build/mixed/psoc_creator.mak
endif

ccinfo:
	@$(call prntYd,-------- COMPILER INFO ---------)
ifneq ($(wildcard $(cc)),)
	@$(call prntlineBlueYellow,COMPILER PATH: ,$(cc))
	@$(call prntB,COMPILER INFO:)
	@$(subst /,\,$(cc)) $(cc_ver_query)
endif
	@$(call prntlineWhiteNCyanSCyan,COMPILER OPTIONS:, $(copt), $(ccopt))
	@$(call prntYd,--------------------------------)


include common/build/mixed/help.mak
include common/build/mixed/maksym.mak
ifeq ($(FW_update_type),FWU4)
    include common/build/secure_boot/secure_boot.mak
endif
include common/build/mixed/patchbin.mak
include common/build/mixed/release.mak
include common/build/mixed/bin_gen.mak
include common/build/mixed/dbus_integration.mak
include common/build/lint/lint.mak
include common/build/clangformat/format.mak
include common/build/doxygen/doxygen.mak
include common/build/axivion/axivion.mak
include common/tools/python/pteng/pteng.mak
include common/build/flash/winFlash.mak
include common/build/flash/st-link.mak
include common/build/flash/gdlink.mak
include common/build/flash/psFlash.mak
include common/build/flash/pp_flash.mak
include common/build/flash/rfp.mak
include common/build/flash/jflash.mak
include common/build/flash/sl_commander.mak
-include ext/vectorcast/vectorcast.mak
include common/build/common/misra_help.mak
include common/build/artifactory/artifactory.mak
include common/build/mixed/git.mak
include common/build/mixed/memory.mak
include common/build/mixed/depend.mak
include common/build/mixed/check.mak
include common/build/Test/dtest_codegen.mak
include $(post_build_include)

# Dummy force target used to force execute target
FORCE:


# Target to clean single variant
.PHONY: clean
clean:
	@echo --- Cleaning all ---
	@$(call deltree,$(out_path)/$(variant))
	@$(call deldebug_extended)
	@$(call touch,$(app_path)/build/common_config.mak)
	@echo --- Cleaning done ---


# Target to clean all variants - delete out folder
.PHONY: clean_all cl
cl clean_all:
	@echo --- Cleaning all variants ---
	@$(call deltree,$(out_path))
	@$(call deldebug_extended)
	@$(call touch,$(app_path)/build/common_config.mak)
	@echo --- Cleaning all variants done ---


# debug target for printing content of make variable "make debug var=<variable>"
debug_output = $(foreach vars, $($(var)), $(info $(vars)))
.PHONY: debug

debug:
	@$(eval $(debug_output))
	@echo.


defines += $(add_defines)


# target for creating directories
%/: $(pre_build)
	$(call mkdir, $@)


relink: rmbin link
rmbin:
	@echo --- Removing binaries ---
	@$(call deltree, $(bin_path))


# Code generator entry for generating variant header file
code_gen += var_header
var_header_template     = $(template_folder)\variant_header.tpl.h
var_header_output       = $(varHeader)

# Process follow files as standard generated files
gen_hdr += build_date.h build_version.h


preproc_file += linker_script
linker_script_template  = $(linkerScriptTemplate)
linker_script_output    = $(linkerScript)
linker_script_defines   = UINT32_C(x)=x $(defines_cl)
linker_script_copt      = -undef -imacros $(varHeader) -I$(app_prog_path)/ped_fw -I$(app_prog_path)
linker_script_depend    = $(MAKEFILE_LIST) $(varHeader)


# calculation of two make variables intended for microcontroller file (BP2 file) template
DEFAULT_SPEED := $(call calc,$(strip $(dbus_default_baudrate)) * 100)
APP_SPEED := $(DEFAULT_SPEED)

preproc_file += winflash_cfg
winflash_cfg_output     = $(winflash_cfg_file)
winflash_cfg_defines    = DEFAULT_SPEED=$(DEFAULT_SPEED) APP_SPEED=$(APP_SPEED) MCU_NAME=$(call lower,$(derivative)) UINT32_C(x)=x
winflash_cfg_copt       = -undef -imacros $(varHeader)
winflash_cfg_depend     = $(varHeader)

# Include code generator makefile
include common/build/code_gen/code_gen.mak
include common/build/mixed/preproc.mak


# Main initialization target called after application setup
.PHONY: init
init: initcfg $(init_targets)



#include make_export at last to not miss any make variable
include common/build/mixed/make_export.mak

$(info +++++ building variant $(variant) by using compiler $(cc_build_path) +++++)
