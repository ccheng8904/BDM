<?xml version="1.0" encoding="utf-8"?>
<Configuration Key="ir2rfg" Unset="false">

  <!-- CAUTION: The settings in this configuration file have side
       effects on the result interpretation for many analyses. Adjust
       the settings before starting a continuous montitoring. Do not
       change the configuration during a continuous monitoring, as
       this will most likely break the continuous violation tracking.
  -->

  <Node Key="LanguageHandling" Unset="false">

    <!-- Controls which edges are not generated.

	 If Macro_Invocation is disabled, no macro nodes and
	 invokations will be inserted into the resulting views. In
	 this case, nodes and edges will be created for the
	 preprocessed source.

	 CAUTION: This has side effects on the result interpretation
	 for many analyses. Do not use this for CI builds at all.
    -->
    <Node Key="EdgeHandling" Unset="false">
      <Node Key="Macro_Invocation" Unset="false">
        <Binding Key="Disable_Edge" Unset="false" Value="false"/>
      </Node>
    </Node>

    <!-- Controls generation of declaration views:
         Declaration Facts
         File

	 CAUTION: This has side effects on the result interpretation
	 for many analyses and the necessary configuration options for
	 many analysis steps. Do not switch between CI build as it
	 breaks continuous violation tracking during CI builds.
    -->
    <Binding Key="Create_Declaration_Views" Unset="false" Value="true"/>

    <!-- Controls generation of definition views:
	 Code Facts
	 Module

         CAUTION: This has side effects on the result interpretation
	 for many analyses and the necessary configuration options for
	 many analysis steps. Do not switch between CI build as it
	 breaks continuous violation tracking during CI builds.
    -->
    <Binding Key="Create_Definition_Views" Unset="false" Value="true"/>

    <!-- Controls whether OO relationships are flattened out.

         CAUTION: This has side effects on the result interpretation
	 for many analyses. Do not switch between CI build as it
	 breaks continuous violation tracking during CI builds.
    -->
    <Binding Key="Prepare_OO" Unset="false" Value="true"/>

    <!-- Controls whether namespace nodes are generated.

         CAUTION: This has side effects on the result interpretation
	 for many analyses. Do not switch between CI build as it
	 breaks continuous violation tracking during CI builds.
    -->
    <Binding Key="Namespaces" Unset="false" Value="true"/>

    <!-- Controls whether anonymous base types of typedefs are
         represented (as type nodes with name "?").

	 CAUTION: This has side effects on the result interpretation
	 for many analyses. Do not switch between CI build as it
	 breaks continuous violation tracking during CI builds.
    -->
    <Binding Key="MergeTypedefToAnonymous" Unset="false" Value="true"/>

    <!-- Controls whether multiple edges of the same kind are created
         between the same nodes.
	 
	 CAUTION: This has side effects on the result interpretation
	 for many analyses. Do not use this for CI builds at all.
    -->
    <Binding Key="MultipleEdges" Unset="false" Value="false"/>

    <!-- Controls whether static variables and functions are kept
         separate. 

	 CAUTION: This has side effects on the result interpretation
	 for many analyses. Do not switch between CI build as it
	 breaks continuous violation tracking during CI builds.
    -->
    <Binding Key="Separate_Statics" Unset="false" Value="false"/>

    <!-- Controls whether linknames are hashed based on SHA1.  

         CAUTION: Do not switch between CI build as it breaks
         continuous violation tracking completely.
    -->
    <Binding Key="Hashing" Unset="false" Value="false"/>
    
    <!-- Controls whether linknames are forced to really be disjoint
         within an RFG.

         CAUTION: Do not switch between CI build as it breaks
         continuous violation tracking during CI builds.
    -->
    <Binding Key="CheckDuplicates" Unset="false" Value="false"/>

    <!-- Controls whether routine nodes get Source.Body_Start_X and
         Source.Body_End_X attributes. 

        CAUTION: For backward compatibility only.  Will be removed in
        later releases. Use the Source.Region_Start and
        Source.Region_End attributes instead.
    -->
    <Binding Key="BodySLocs" Unset="false" Value="false"/>

  </Node>

</Configuration>
