#  Description      settings and targets for doxygen
#*******************************************************************************

# by default MCU header files are excluded from doxygen input
doxy_no_sfr ?= true
doxy_exclude_cfg_opt ?= EXCLUDE=
ifeq ($(doxy_no_sfr), true)
    doxy_exclude_files  += $(foreach mcu_header, $(msp_processor_includes),$(addprefix $(CURDIR)/,$(mcu_header)))
    doxy_exclude_cfg_opt += $(doxy_exclude_files)
endif

# by default a list of source files is used as doxygen input
doxy_use_dirs ?= false
doxy_no_chm   ?= false

# by default all files from dependency list file (dep file) will be included as doxygen input
doxy_include_depfiles ?= true

# the doxygen will not print any messages during its execution when make variable doxy_quiet is true 
# Note: the default value for doxygen itself is QUIET=NO.
doxy_quiet          ?= true

#no_dep_targets += 

# 'doxy_input' can be overloaded in common_config.mak to create documentation compoment only
# e.g. for BootManager only: doxy_input = $(sdk_prog_path)/firmware_update/BootManager
# or for one file only: doxy_input = $(call find_files,$(make_search_path),ped_fw/flash/flash.c)
# In Windows 10 envinronment the string is just cut off after 8191 characters
doxy_src        ?= $(call find_files,$(make_search_path),$(sources))
doxy_dirs        = $(call unique,$(foreach doxy_src_file,$(doxy_src),$(dir $(doxy_src_file))))
max_printf_string_length = 8191

# setting doxy_input to a list of source files or a list of folders depending on total count of characters in doxy_src
# in 'big projects' total count of characters in doxy_src may exceeded maximal length of string printable by print function
ifeq (true, $(call greater_then,$(call biglength,doxy_src),$(max_printf_string_length)))
    doxy_input ?= $(doxy_dirs)
    doxy_input_notification = Info: Because of high number of input files, list of directories was generated to be used as an input for doxy. Please note, that generation of doxy output may take longer.
else
    ifeq ($(doxy_use_dirs),true)
# usage of directory list is forced instead of using list of source files as source for doxygen
        doxy_input ?= $(doxy_dirs)
        doxy_input_notification = A list of directories was used as an input for doxy.
    else
        doxy_input ?= $(doxy_src)
        doxy_input_notification = A list of source files was used as an input for doxy.
    endif
endif
# doxygen related variables setting
doxy_bin_path       ?= $(doxy_path)/bin
doxy                ?= $(doxy_bin_path)/Doxygen.exe
ms_help_compiler    ?= $(doxy_path)/MS_HelpCompiler/hhc.exe
doxy_build_path      = common/build/doxygen
doxy_path_out       ?= $(out_path)/$(variant)/doxy
latex_path_out      ?= $(doxy_path_out)/latex
doxy_cfg            ?= $(doxy_path_out)/doxy.cfg
doxy_msg_filter_file ?=$(local_tool_path)/mixed/doxy_msg_filters.awk

chm_File = ../$(variant_base).chm

doxy_enabled_sections += $(variant_base)
doxy_file_patterns    ?= *.c *.h *.cpp *.hpp *.s *.S *.markdown *.md
doxy_project_name     ?= $(variant_base)
# Hint: project can customize this doxy_project_number. It will be placed next to name of variant in documentation.
# this value is only placeholder
doxy_project_number   ?= 12345
doxy_project_brief    ?= My short description about a project $(doxy_project_name).

# latex to pdf script related options setting
latex2pdf_debug ?= false
latex2pdf_opt  = -i refman.tex
latex2pdf_opt += -o refman.pdf
latex2pdf_opt += -p $(latex_path_out)/
latex2pdf_opt += -f $(doxy_path_out)/
# switch for debuging latex to pdf script (for internal usage only)
ifeq ($(latex2pdf_debug),true)
    latex2pdf_opt += -t
endif

# doxygen related options setting
doxyopt +=\# Doxyfile generated by Doxygen version $(doxygen_version)\n
doxyopt +=@INCLUDE_PATH          = $(doxy_bin_path) $(doxy_build_path)\n
doxyopt +=@INCLUDE               = Doxyfile\n
doxyopt +=@INCLUDE               = DoxyStd.cfg\n
doxyopt +=CASE_SENSE_NAMES       = NO\n
doxyopt +=OPTIMIZE_OUTPUT_FOR_C  = YES\n
doxyopt +=PREDEFINED             = $(call prepost,\",$(defines_tool),\") \"DOXY_DEVELOPERS_DOC\" \"__DOXYGEN__\"\n
doxyopt +=PROJECT_NAME           = \"$(doxy_project_name)\"\n
doxyopt +=PROJECT_NUMBER         = \"$(doxy_project_number)\"\n
doxyopt +=PROJECT_BRIEF          = \"$(doxy_project_brief)\"\n
doxyopt +=HTML_OUTPUT            = $(doxy_path_out)/html\n
doxyopt +=HTML_FOOTER            = $(doxy_path_out)/html/footerFile.html\n
doxyopt +=HTML_HEADER            = $(doxy_path_out)/html/headerFile.html\n
# Hint: Batch file for some reason not called, current solution: call help compiler in doxy recipe
doxyopt +=HHC_LOCATION           = $(subst /,\,$(ms_help_compiler))\n
doxyopt +=CHM_FILE               = $(chm_File)\n
doxyopt +=IMAGE_PATH             = $(doxy_image_path)\n
doxyopt +=FILE_PATTERNS          = $(doxy_file_patterns)\n
doxyopt +=DOT_PATH               = $(doxy_path)/Graphviz/Bin\n
doxyopt +=PLANTUML_JAR_PATH      = $(doxy_path)/PlantUML\n
ifeq ($(doxy_no_chm), true)
doxyopt +=GENERATE_HTMLHELP      = NO\n
else
doxyopt +=GENERATE_HTMLHELP      = YES\n
endif
ifeq ($(doxy_quiet), true)
doxyopt +=QUIET                  = YES\n
else
doxyopt +=QUIET                  = NO\n
endif
doxyopt +=WARNINGS               = YES\n
doxyopt +=WARN_IF_UNDOCUMENTED   = YES\n
doxyopt +=WARN_LOGFILE           = $(doxy_path_out)/doxy.log\n
# If the GENERATE_LATEX tag is set to YES, doxygen will generate LATEX output
doxyopt +=GENERATE_LATEX         = YES\n
doxyopt +=LATEX_OUTPUT           = $(latex_path_out)\n
doxyopt +=LATEX_HEADER           = $(doxy_build_path)/header.tex\n
doxyopt +=LATEX_FOOTER           = $(doxy_build_path)/footer.tex\n
# To get the best results for PDF output the PDF_HYPERLINKS is set to YES
# PDF file will contain links instead of page references.
doxyopt +=PDF_HYPERLINKS         = YES\n
doxyopt +=USE_PDFLATEX           = YES\n
doxyopt +=ENABLE_PREPROCESSING   = YES\n
doxyopt +=ENABLED_SECTIONS       = $(doxy_enabled_sections)\n
doxyopt +=EXCLUDE_PATTERNS       = $(doxy_exclude_patterns)\n
# If the EXTRACT_ALL tag is set to YES, doxygen will assume all entities in documentation are documented,
# even if no documentation was available.
doxyopt +=EXTRACT_ALL            = $(doxy_extract_all)\n

# if source code has to be excluded from doxygen document then set 'doxy_exclude_src' to true 
# in common_config.mak file
# Hint: if doxy_exclude_src is not set, then we can go to the sources files in chm or html documentation 
#       but not in pdf documentation
ifeq ($(doxy_exclude_src), true)
# If the SOURCE_BROWSER tag is set to YES then a list of source files will be generated.
# Documented entities will be cross-referenced with these sources.
# The default value is: NO.
# Note: To get rid of all source code in the generated output, make sure that 
# also VERBATIM_HEADERS is set to NO.
    doxyopt += SOURCE_BROWSER = NO\n
# If the VERBATIM_HEADERS tag is set the YES then doxygen will generate a verbatim 
# copy of the header file for each class for which an include is specified.
# The default value is: YES.
    doxyopt += VERBATIM_HEADERS = NO\n
endif
# if only one file or directory to be documented set 'no_aditional_includes' to true 
# in common_config.mak file
ifeq ($(no_aditional_includes), true)
    doxyopt2 +=SEARCH_INCLUDES        = NO\n
else
    doxyopt2 +=SEARCH_INCLUDES        = YES\n
    doxyopt2 +=INCLUDE_PATH           = $(search_path)\n
endif


# The INPUT tag is used to specify the files and/or directories that contain documented source files.
# You may enter file names like myfile.cpp or directories like /usr/src/myproject.
# Separate the files or directories with spaces. See also FILE_PATTERNS and EXTENSION_MAPPING
# Note: If this tag is empty the current directory is searched.

ifdef version
    versionstring = Version $(version)
endif


# call Doxygen for SW-Documentation
# *********************************
doxy: $(doxy_cfg)
	@echo --- generating Documentation ---
ifeq ($(doxy_quiet), filtered)
# doxygen is executed in non-quiet mode and its output is filtered
	@$(subst /,\,$(doxy)) $(doxy_path_out)/doxy.cfg | $(subst /,\,$(gawk)) -f $(doxy_msg_filter_file)
else ifeq ($(doxy_quiet), $(filter $(doxy_quiet), false true))
# doxygen is executed either in fully quiet or in non-quiet mode - it depends on the setting of doxy_quiet option.
	@$(doxy) $(doxy_path_out)/doxy.cfg
endif

# set 'doxy_include_depfiles' to 'false' when one file or directory to be documented only
# in common_config.mak file
$(doxy_cfg): dep $(MAKEFILE_LIST)
	@echo --- generating Doxygen-Configfile ---
	@$(call mkdir,$(dir $@))
	@$(call mkdir,$(dir $@)/html)
	@$(perl) $(local_tool_path)/mixed/doxy_config_generator.pl "$(doxyopt)" >$(doxy_path_out)/doxy.cfg
	@$(perl) $(local_tool_path)/mixed/doxy_config_generator.pl "$(doxyopt2)" >>$(doxy_path_out)/doxy.cfg
	@echo INPUT=$(doxy_input) >>$(doxy_path_out)/doxy.cfg
	@echo $(doxy_input_notification)
ifeq ($(doxy_include_depfiles), true)
	@$(perl) $(local_tool_path)/mixed/doxy_config_generator.pl "INPUT+=" >>$(doxy_path_out)/doxy.cfg
ifeq ($(doxy_no_sfr), true)
	@$(perl) $(local_tool_path)/mixed/scan_dep.pl --filedep $(out_path)/$(variant)/$(variant_base).dep $(doxy_exclude_files) >>$(doxy_path_out)/doxy.cfg
else
	@$(perl) $(local_tool_path)/mixed/scan_dep.pl --filedep $(out_path)/$(variant)/$(variant_base).dep >>$(doxy_path_out)/doxy.cfg
endif
endif
	@$(perl) $(local_tool_path)/mixed/doxy_config_generator.pl "\n" >>$(doxy_path_out)/doxy.cfg
	@echo $(doxy_exclude_cfg_opt) >>$(doxy_path_out)/doxy.cfg
	@$(call copy,$(doxy_build_path)/Logo.PNG,$(doxy_path_out)/html/Logo.PNG)
	@$(call copy,$(doxy_build_path)/footerFile.html,$(doxy_path_out)/html/footerFile.html)
	@$(call copy,$(doxy_build_path)/headerFile.html,$(doxy_path_out)/html/headerFile.html)


export PATH := $(tex_path)/;$(PATH)

pdf:     $(variant_base).pdf

$(variant_base).pdf: doxy
	@echo --- generating PDF-Documentation ---
	@$(perl) -i.bak -p -e "s/~TITLE~/$(doxy_project_name)/g;s/~VERSION~/$(versionstring)/g" $(latex_path_out)/refman.tex
	@$(perl) $(local_tool_path)/mixed/latex2pdf.pl  $(latex2pdf_opt) -d $@
	@echo --------PDF-Documentation done--------

