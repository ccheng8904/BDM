 217:common/prog/MSP/CMSIS/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "l" (r)
 218:common/prog/MSP/CMSIS/cmsis_gcc.h **** #else
 219:common/prog/MSP/CMSIS/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=r" (r)
 220:common/prog/MSP/CMSIS/cmsis_gcc.h **** #define __CMSIS_GCC_RW_REG(r) "+r" (r)
