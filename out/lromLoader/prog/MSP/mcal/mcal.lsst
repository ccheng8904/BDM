  54:common/prog/std_lib/std_callback.h **** /** \brief    Type definition for standard callback functions
  55:common/prog/std_lib/std_callback.h ****  *
  56:common/prog/std_lib/std_callback.h ****  *  \param    objPtr:       pointer to user defined object/instance
  57:common/prog/std_lib/std_callback.h ****  *  \param    eventFlags:   event flags specifying which event is pending
  58:common/prog/std_lib/std_callback.h ****  *  \param    eventData:    event data to be processed by callback function
  59:common/prog/std_lib/std_callback.h ****  *
  60:common/prog/std_lib/std_callback.h ****  *  \return   standard return value (0-OK / <0-ERROR)
