  26:common/prog/std_lib/std_callback.h **** /** \file
  27:common/prog/std_lib/std_callback.h ****  *
  28:common/prog/std_lib/std_callback.h ****  *  \ingroup  standardLibrary
  29:common/prog/std_lib/std_callback.h ****  *
  30:common/prog/std_lib/std_callback.h ****  *  \brief    Public definitions and declarations for unit STDCB.
  31:common/prog/std_lib/std_callback.h ****  *
  32:common/prog/std_lib/std_callback.h ****  *  \details  Standard callback library for adding, removing and executing of
  33:common/prog/std_lib/std_callback.h ****  *            callback functions. All callbacks are defined by STDCB_Callback
  34:common/prog/std_lib/std_callback.h ****  *            structure and arranged in linked list. When executing callbacks,
  35:common/prog/std_lib/std_callback.h ****  *            only those callback functions are executed, that have enabled
  36:common/prog/std_lib/std_callback.h ****  *            specific event by event mask in callback structure. This allows 
  37:common/prog/std_lib/std_callback.h ****  *            attaching multiple callbacks to one callbacks list, where each 
  38:common/prog/std_lib/std_callback.h ****  *            callbacks responds to different event (e.g. received / transmitted
  39:common/prog/std_lib/std_callback.h ****  *            data or error event).
  40:common/prog/std_lib/std_callback.h ****  */
  41:common/prog/std_lib/std_callback.h **** 
  42:common/prog/std_lib/std_callback.h **** 
