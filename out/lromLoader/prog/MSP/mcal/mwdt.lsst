  54:common/prog/math/mathDiv.h **** #ifndef MTDIV_WIDTH_16
  55:common/prog/math/mathDiv.h **** #define MTDIV_WIDTH_32
  56:common/prog/math/mathDiv.h **** #endif // MTDIV_WIDTH_16
  57:common/prog/math/mathDiv.h **** 
  58:common/prog/math/mathDiv.h **** /******************************************************************************/
  59:common/prog/math/mathDiv.h **** /* PUBLIC TYPE DEFINITIONS                                                    */
  60:common/prog/math/mathDiv.h **** /******************************************************************************/
  61:common/prog/math/mathDiv.h **** 
  62:common/prog/math/mathDiv.h **** /** \brief    Divisor and result type.
  63:common/prog/math/mathDiv.h ****  *
  64:common/prog/math/mathDiv.h ****  *  \note     Divisor and result type is dependent on MTDIV_WIDTH_xx setting.
  65:common/prog/math/mathDiv.h ****  */
  66:common/prog/math/mathDiv.h **** #ifdef MTDIV_WIDTH_16
  67:common/prog/math/mathDiv.h **** typedef uint16_t    MTDIV_width_t;
  68:common/prog/math/mathDiv.h **** #else
  69:common/prog/math/mathDiv.h **** typedef uint32_t    MTDIV_width_t;
  70:common/prog/math/mathDiv.h **** #endif
