  85:common/prog/math/mathDiv.h **** 
  86:common/prog/math/mathDiv.h **** /** \brief    Main division and modulo function.
  87:common/prog/math/mathDiv.h ****  *
  88:common/prog/math/mathDiv.h ****  *  \note     This function performs division and modulo calculation and is
  89:common/prog/math/mathDiv.h ****  *            intended mainly for internal use. Be careful when using this 
  90:common/prog/math/mathDiv.h ****  *            function, as divisor and result width are dependent
  91:common/prog/math/mathDiv.h ****  *            on MTDIV_WIDTH_xx setting. By calling this function you get
  92:common/prog/math/mathDiv.h ****  *            either quotient or modulo, depending on div parameter.
  93:common/prog/math/mathDiv.h ****  *
  94:common/prog/math/mathDiv.h ****  *  \param    dividend:  the dividend
  95:common/prog/math/mathDiv.h ****  *  \param    divisor:   the divider
  96:common/prog/math/mathDiv.h ****  *
  97:common/prog/math/mathDiv.h ****  *  \return   struct MTDIV_Result containing both quotient and remainder.
  98:common/prog/math/mathDiv.h ****  */
  99:common/prog/math/mathDiv.h **** extern struct MTDIV_Result MTDIV_div_mod(uint32_t dividend, MTDIV_width_t divisor);
 100:common/prog/math/mathDiv.h **** 
 101:common/prog/math/mathDiv.h **** 
 102:common/prog/math/mathDiv.h **** /** \brief    Division 32bit by 16bit, result fits into 16bit
 103:common/prog/math/mathDiv.h ****  *
 104:common/prog/math/mathDiv.h ****  *  \note     Be careful, the maximum result is 0xFFFF. You should be sure, that
 105:common/prog/math/mathDiv.h ****  *            your result fits into uint16_t.
 106:common/prog/math/mathDiv.h ****  *
 107:common/prog/math/mathDiv.h ****  *  \param    dividend:  the dividend
 108:common/prog/math/mathDiv.h ****  *  \param    divisor:   the divider
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccPwWU88.s 			page 7


 109:common/prog/math/mathDiv.h ****  *
 110:common/prog/math/mathDiv.h ****  *  \return   result of division
 111:common/prog/math/mathDiv.h ****  */
 112:common/prog/math/mathDiv.h **** static inline uint16_t MTDIV_div_32_16(uint32_t dividend, uint16_t divisor)
 113:common/prog/math/mathDiv.h **** {
 114:common/prog/math/mathDiv.h ****   #ifdef NO_CORE_DEVIDER
 115:common/prog/math/mathDiv.h ****     return (uint16_t)MTDIV_div_mod(dividend, (MTDIV_width_t)divisor).quotient;
 116:common/prog/math/mathDiv.h ****   #else
 117:common/prog/math/mathDiv.h ****     return (uint16_t)(dividend / (uint32_t)divisor);
 118:common/prog/math/mathDiv.h ****   #endif
 119:common/prog/math/mathDiv.h **** }
 120:common/prog/math/mathDiv.h **** 
 121:common/prog/math/mathDiv.h **** 
 122:common/prog/math/mathDiv.h **** /** \brief    Modulo 32bit by 16bit, result fits into 16bit
 123:common/prog/math/mathDiv.h ****  *
 124:common/prog/math/mathDiv.h ****  *  \note     Be careful, the maximum result is 0xFFFF. You should be sure, that
 125:common/prog/math/mathDiv.h ****  *            your result fits into uint16_t.
 126:common/prog/math/mathDiv.h ****  *
 127:common/prog/math/mathDiv.h ****  *  \param    dividend:  the dividend
 128:common/prog/math/mathDiv.h ****  *  \param    divisor:   the divider
 129:common/prog/math/mathDiv.h ****  *
 130:common/prog/math/mathDiv.h ****  *  \return   modulo of division
 131:common/prog/math/mathDiv.h ****  */
 132:common/prog/math/mathDiv.h **** static inline uint16_t MTDIV_mod_32_16(uint32_t dividend, uint16_t divisor)
 133:common/prog/math/mathDiv.h **** {
 134:common/prog/math/mathDiv.h ****   #ifdef NO_CORE_DEVIDER
