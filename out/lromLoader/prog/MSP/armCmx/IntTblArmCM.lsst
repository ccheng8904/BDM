 181:common/prog/MSP/armCmx/IntTblArmCM.c **** /** \brief    Core interrupt table array definition.
 182:common/prog/MSP/armCmx/IntTblArmCM.c ****  *
 183:common/prog/MSP/armCmx/IntTblArmCM.c ****  *  \details  Interrupt table consists of ITBL_coreVectors - common for all
 184:common/prog/MSP/armCmx/IntTblArmCM.c ****  *            Cortex M devices and from ITBL_peripheralVectors defined in
 185:common/prog/MSP/armCmx/IntTblArmCM.c ****  *            IntTbl.c. This interrupt table is usually located at the start
 186:common/prog/MSP/armCmx/IntTblArmCM.c ****  *            of the application.
 187:common/prog/MSP/armCmx/IntTblArmCM.c ****  */
 188:common/prog/MSP/armCmx/IntTblArmCM.c **** #ifndef NO_ISR_SUPPORT
 189:common/prog/MSP/armCmx/IntTblArmCM.c **** #if defined(CORTEX_M0) || defined(CORTEX_M0_PLUS)
 190:common/prog/MSP/armCmx/IntTblArmCM.c **** SDEF_SetSegmentConst(vectorsCore)
 191:common/prog/MSP/armCmx/IntTblArmCM.c **** /** Cortex M0 and M0+ core vector table*/
 192:common/prog/MSP/armCmx/IntTblArmCM.c **** const ITBL_fptr SYMBOL_USED ITBL_coreVectors[] =
 193:common/prog/MSP/armCmx/IntTblArmCM.c **** {
 194:common/prog/MSP/armCmx/IntTblArmCM.c **** // ||Handler function name||    ||Priority||        ||Address offset||
 195:common/prog/MSP/armCmx/IntTblArmCM.c ****    /*lint -e{923, 9029}  cast tested to work correctly for ARM CortexMx */
 196:common/prog/MSP/armCmx/IntTblArmCM.c ****    // AXIVION Next Line MisraC2012-11.1
 197:common/prog/MSP/armCmx/IntTblArmCM.c ****    (ITBL_fptr)STACK_TOP         //  none              0x0000
 198:common/prog/MSP/armCmx/IntTblArmCM.c ****    // Cortex internal interrupts
 199:common/prog/MSP/armCmx/IntTblArmCM.c ****    ,ITBL_vResetHandler          //  -3                0x0004
 200:common/prog/MSP/armCmx/IntTblArmCM.c ****    ,NMI_Handler                 //  -2                0x0008
 201:common/prog/MSP/armCmx/IntTblArmCM.c ****    ,HardFault_Handler           //  -1                0x000C
 202:common/prog/MSP/armCmx/IntTblArmCM.c ****    ,ITBL_vSpuriousIsr           //  none
 203:common/prog/MSP/armCmx/IntTblArmCM.c ****    ,ITBL_vSpuriousIsr           //  none
