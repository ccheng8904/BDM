 127:common/prog/MSP/armCmx/IntTblArmCM.c ****     #else
 128:common/prog/MSP/armCmx/IntTblArmCM.c ****         #define VTOR_VALUE (uint32_t)(((uint32_t)ITBL_coreVectors)-((uint32_t)ITBL_fixedVectors));
