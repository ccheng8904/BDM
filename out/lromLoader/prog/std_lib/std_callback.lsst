  18:common/prog/std_lib/std_callback.c **** /** \file
  19:common/prog/std_lib/std_callback.c ****  *
  20:common/prog/std_lib/std_callback.c ****  *  \ingroup  standardLibrary
  21:common/prog/std_lib/std_callback.c ****  *
  22:common/prog/std_lib/std_callback.c ****  *  \brief    Public definitions and declarations for unit STDCB.
  23:common/prog/std_lib/std_callback.c ****  *
  24:common/prog/std_lib/std_callback.c ****  *  \details  Standard callback library for adding, removing and executing of
  25:common/prog/std_lib/std_callback.c ****  *            callback functions. All callbacks are defined by STDCB_Callback
  26:common/prog/std_lib/std_callback.c ****  *            structure and arranged in linked list. When executing callbacks,
  27:common/prog/std_lib/std_callback.c ****  *            only those callback functions are executed, that have enabled
  28:common/prog/std_lib/std_callback.c ****  *            specific event by event mask in callback structure. This allows 
  29:common/prog/std_lib/std_callback.c ****  *            attaching multiple callbacks to one callbacks list, where each 
  30:common/prog/std_lib/std_callback.c ****  *            callbacks responds to different event (e.g. received / transmitted
  31:common/prog/std_lib/std_callback.c ****  *            data or error event).
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccuzF6ne.s 			page 2


