  91:common/prog/firmware_update/BootLoader/BLcom.c **** /****************** BLCOM_receiveFrame ****************************************/
  92:common/prog/firmware_update/BootLoader/BLcom.c **** enum BLCOM_rxResult BLCOM_receiveFrame(uint8_t *buffer, uint16_t length, uint16_t timeout)
  93:common/prog/firmware_update/BootLoader/BLcom.c **** {
  94:common/prog/firmware_update/BootLoader/BLcom.c ****     uint16_t index  = 0u;
  95:common/prog/firmware_update/BootLoader/BLcom.c ****     /* Set timeout for first time, but in case of invalid received command do not reset timeout.
  96:common/prog/firmware_update/BootLoader/BLcom.c ****         This will ensure jump from Bootloader to user app even in case when
  97:common/prog/firmware_update/BootLoader/BLcom.c ****         unexpected DBus traffic appears on the communication line.*/
  98:common/prog/firmware_update/BootLoader/BLcom.c ****     if ((BLCOM_rxErrorFlag == false) || (BLCOM_reloadTime == 0u)) { BLCOM_setTimeOut(timeout);}
  99:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_initTransmission();
 100:common/prog/firmware_update/BootLoader/BLcom.c ****     while (!TESTUB(BLCOM_isTimeOut)())
 101:common/prog/firmware_update/BootLoader/BLcom.c ****     {
 102:common/prog/firmware_update/BootLoader/BLcom.c ****         BLCOM_triggerWdg();
 103:common/prog/firmware_update/BootLoader/BLcom.c ****         if (BLCOM_isDataAvailable())
 104:common/prog/firmware_update/BootLoader/BLcom.c ****         {   /* next data byte available */
 105:common/prog/firmware_update/BootLoader/BLcom.c ****             uint8_t rxData = BLCOM_receiveData();
 106:common/prog/firmware_update/BootLoader/BLcom.c ****             if (index < length)
 107:common/prog/firmware_update/BootLoader/BLcom.c ****             {   /* last byte (checksum) not reached */
 108:common/prog/firmware_update/BootLoader/BLcom.c ****                 buffer[index++] = rxData;
 109:common/prog/firmware_update/BootLoader/BLcom.c ****                 BLCOM_updateChecksum(rxData);
 110:common/prog/firmware_update/BootLoader/BLcom.c ****             }
 111:common/prog/firmware_update/BootLoader/BLcom.c ****             else
 112:common/prog/firmware_update/BootLoader/BLcom.c ****             {   /* return whether rx was successful or not*/
 113:common/prog/firmware_update/BootLoader/BLcom.c ****                 return BLCOM_checkRxResult(rxData);
 114:common/prog/firmware_update/BootLoader/BLcom.c ****             }
 115:common/prog/firmware_update/BootLoader/BLcom.c ****         }
 116:common/prog/firmware_update/BootLoader/BLcom.c ****     }
 117:common/prog/firmware_update/BootLoader/BLcom.c ****     return BLCOM_rxTimeOut;
 118:common/prog/firmware_update/BootLoader/BLcom.c **** }
 119:common/prog/firmware_update/BootLoader/BLcom.c **** 
 120:common/prog/firmware_update/BootLoader/BLcom.c **** 
 121:common/prog/firmware_update/BootLoader/BLcom.c **** /****************** BLCOM_sendByte ********************************************/
 122:common/prog/firmware_update/BootLoader/BLcom.c **** void BLCOM_sendByte(uint8_t data)
 123:common/prog/firmware_update/BootLoader/BLcom.c **** {
 124:common/prog/firmware_update/BootLoader/BLcom.c **** #if (defined(MSPM0_SERIES_G) && (CORE_CLOCK==80U))
 125:common/prog/firmware_update/BootLoader/BLcom.c ****     HSUP_vDelay(10); // for time critical reason this delay is required for TI MSPM0 platform
 126:common/prog/firmware_update/BootLoader/BLcom.c **** #elif defined(MSPM0_SERIES_G) && (CORE_CLOCK!=80U) && (CORE_CLOCK!=32U)
 127:common/prog/firmware_update/BootLoader/BLcom.c ****     #pragma error "HSUP_vDelay adjustment might be necessary"
 128:common/prog/firmware_update/BootLoader/BLcom.c **** #endif
 129:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_setTxData(data);
 130:common/prog/firmware_update/BootLoader/BLcom.c ****     while (BLCOM_isTxOnGoing())
 131:common/prog/firmware_update/BootLoader/BLcom.c ****     {
 132:common/prog/firmware_update/BootLoader/BLcom.c ****         BLCOM_triggerWdg();
 133:common/prog/firmware_update/BootLoader/BLcom.c ****     }
 134:common/prog/firmware_update/BootLoader/BLcom.c **** #ifndef BLCOM_RxNotDelayed
 135:common/prog/firmware_update/BootLoader/BLcom.c **** /* Hint, if it is for sure, that TX event happens before RX event, this is not required 
 136:common/prog/firmware_update/BootLoader/BLcom.c ****  * It is important, that the sent byte will be received and ignored, but it is not guaranteed,
 137:common/prog/firmware_update/BootLoader/BLcom.c ****  * that the the receive is finished directly after transmit finished.
 138:common/prog/firmware_update/BootLoader/BLcom.c ****  * To be sure the following code is switched on by default.
 139:common/prog/firmware_update/BootLoader/BLcom.c ****  */
 140:common/prog/firmware_update/BootLoader/BLcom.c ****     {
 141:common/prog/firmware_update/BootLoader/BLcom.c ****         static const uint16_t BLCOM_rxTmo = 3000u; ///< Receive Time-out in us
 142:common/prog/firmware_update/BootLoader/BLcom.c ****         uint16_t timeStamp = TIM_uiGetCircleMicroSeconds();
 143:common/prog/firmware_update/BootLoader/BLcom.c ****         while (!BLCOM_isDataAvailable() &&
 144:common/prog/firmware_update/BootLoader/BLcom.c ****               ( (uint16_t)(TIM_uiGetCircleMicroSeconds() - timeStamp ) < BLCOM_rxTmo ))
 145:common/prog/firmware_update/BootLoader/BLcom.c ****         {BLCOM_triggerWdg();}
 146:common/prog/firmware_update/BootLoader/BLcom.c ****     }
 147:common/prog/firmware_update/BootLoader/BLcom.c **** #endif
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccIDMngw.s 			page 4


 148:common/prog/firmware_update/BootLoader/BLcom.c ****     (void)BLCOM_receiveData(); // read back transmitted byte
 149:common/prog/firmware_update/BootLoader/BLcom.c **** #ifdef EFR32BG21
 150:common/prog/firmware_update/BootLoader/BLcom.c ****     HSUP_vDelay(5); // for some reason this delay required for EFR platform
 151:common/prog/firmware_update/BootLoader/BLcom.c **** #endif
 152:common/prog/firmware_update/BootLoader/BLcom.c **** }
 153:common/prog/firmware_update/BootLoader/BLcom.c **** 
 154:common/prog/firmware_update/BootLoader/BLcom.c **** 
 155:common/prog/firmware_update/BootLoader/BLcom.c **** /****************** BLCOM_sendBuffer ******************************************/
 156:common/prog/firmware_update/BootLoader/BLcom.c **** void BLCOM_sendBuffer(const uint8_t *buffer, uint16_t length)
 157:common/prog/firmware_update/BootLoader/BLcom.c **** {
 158:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_initTransmission();
 159:common/prog/firmware_update/BootLoader/BLcom.c ****     while (length-- > 0u)
 160:common/prog/firmware_update/BootLoader/BLcom.c ****     {
 161:common/prog/firmware_update/BootLoader/BLcom.c ****         BLCOM_sendByte(*buffer);
 162:common/prog/firmware_update/BootLoader/BLcom.c ****         BLCOM_updateChecksum(*buffer++);
 163:common/prog/firmware_update/BootLoader/BLcom.c ****     }
 164:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_sendByte(BLCOM_checksum);
 165:common/prog/firmware_update/BootLoader/BLcom.c **** }
 166:common/prog/firmware_update/BootLoader/BLcom.c **** 
 167:common/prog/firmware_update/BootLoader/BLcom.c **** 
 168:common/prog/firmware_update/BootLoader/BLcom.c **** void BLCOM_sendAck(uint8_t ack)
 169:common/prog/firmware_update/BootLoader/BLcom.c **** {
 170:common/prog/firmware_update/BootLoader/BLcom.c ****     if (BLCOM_firstFrameReceived)
 171:common/prog/firmware_update/BootLoader/BLcom.c ****     {
 172:common/prog/firmware_update/BootLoader/BLcom.c ****         BLCOM_sendByte(ack);
 173:common/prog/firmware_update/BootLoader/BLcom.c ****     }
 174:common/prog/firmware_update/BootLoader/BLcom.c **** }
 175:common/prog/firmware_update/BootLoader/BLcom.c **** 
 176:common/prog/firmware_update/BootLoader/BLcom.c **** /****************** BLCOM_setBaudrate *****************************************/
 177:common/prog/firmware_update/BootLoader/BLcom.c **** void BLCOM_setBaudrate(uint16_t baudrate)
 178:common/prog/firmware_update/BootLoader/BLcom.c **** {
 179:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_Configure(baudrate);
 180:common/prog/firmware_update/BootLoader/BLcom.c **** }
