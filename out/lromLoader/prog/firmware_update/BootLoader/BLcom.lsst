 183:common/prog/firmware_update/BootLoader/BLcom.c **** {
 184:common/prog/firmware_update/BootLoader/BLcom.c ****   #ifndef VARIANT_RAMLOADER
 185:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_initUart();
 186:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_enableUart();
 187:common/prog/firmware_update/BootLoader/BLcom.c ****     (void)_TIM_bGetInitConfig();
 188:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_firstFrameReceived = false;
 189:common/prog/firmware_update/BootLoader/BLcom.c ****   #else
 190:common/prog/firmware_update/BootLoader/BLcom.c ****     // frame already received in ROM-Loader
 191:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_firstFrameReceived = true;
 192:common/prog/firmware_update/BootLoader/BLcom.c ****   #endif
 193:common/prog/firmware_update/BootLoader/BLcom.c ****   #ifdef MCAL_INCLUDED
 194:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_initWdgCfgStruct();
 195:common/prog/firmware_update/BootLoader/BLcom.c ****   #endif
 196:common/prog/firmware_update/BootLoader/BLcom.c ****     BLCOM_reloadTime = 0u;
 197:common/prog/firmware_update/BootLoader/BLcom.c **** }
