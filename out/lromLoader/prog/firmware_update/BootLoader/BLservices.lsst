 377:common/prog/firmware_update/BootLoader/BLservices.c **** static enum BLCOM_rxResult BLSRV_programmeData(uint16_t address, uint16_t length)
 378:common/prog/firmware_update/BootLoader/BLservices.c **** {
 379:common/prog/firmware_update/BootLoader/BLservices.c ****     enum BLCOM_rxResult rxResult;
 380:common/prog/firmware_update/BootLoader/BLservices.c ****     uint32_t phy_address = BLSRV_getTargetAddress(address);
 381:common/prog/firmware_update/BootLoader/BLservices.c **** 
 382:common/prog/firmware_update/BootLoader/BLservices.c ****     BLCOM_sendByte(BL_ACKNOWLEDGE_OK);  // command received successfully
 383:common/prog/firmware_update/BootLoader/BLservices.c ****     rxResult = BLCOM_receiveFrame(BLSRV_dataBuffer, length, BLSRV_dataTimeout);
 384:common/prog/firmware_update/BootLoader/BLservices.c ****     if (rxResult == BLCOM_rxSuccess)
 385:common/prog/firmware_update/BootLoader/BLservices.c ****     {   
 386:common/prog/firmware_update/BootLoader/BLservices.c ****         BLCOM_sendByte(BL_ACKNOWLEDGE_OK); // data received successfully
 387:common/prog/firmware_update/BootLoader/BLservices.c ****         
 388:common/prog/firmware_update/BootLoader/BLservices.c ****         if (BLMAL_writeBuffer(phy_address, length, BLSRV_dataBuffer))
 389:common/prog/firmware_update/BootLoader/BLservices.c ****         {   // success
 390:common/prog/firmware_update/BootLoader/BLservices.c ****             BLCOM_sendByte(BL_FLASH_CMD_OK);
 391:common/prog/firmware_update/BootLoader/BLservices.c ****         }
 392:common/prog/firmware_update/BootLoader/BLservices.c ****         else
 393:common/prog/firmware_update/BootLoader/BLservices.c ****         {   // programming/flashing error
 394:common/prog/firmware_update/BootLoader/BLservices.c ****             BLCOM_sendByte(BL_FLASH_CMD_FAILED);
 395:common/prog/firmware_update/BootLoader/BLservices.c ****         }
 396:common/prog/firmware_update/BootLoader/BLservices.c ****     }
 397:common/prog/firmware_update/BootLoader/BLservices.c ****     return rxResult;
 398:common/prog/firmware_update/BootLoader/BLservices.c **** }
