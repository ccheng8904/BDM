 401:common/prog/firmware_update/BootLoader/BLservices.c **** static enum BLCOM_rxResult BLSRV_readData(uint16_t address, uint16_t length)
 402:common/prog/firmware_update/BootLoader/BLservices.c **** {
 403:common/prog/firmware_update/BootLoader/BLservices.c ****     uint32_t phy_address = BLSRV_getTargetAddress(address);
 404:common/prog/firmware_update/BootLoader/BLservices.c ****     
 405:common/prog/firmware_update/BootLoader/BLservices.c ****     BLCOM_sendByte(BL_ACKNOWLEDGE_OK);
 406:common/prog/firmware_update/BootLoader/BLservices.c ****     if(BLMAL_readBuffer(phy_address, length, BLSRV_dataBuffer))
 407:common/prog/firmware_update/BootLoader/BLservices.c ****     {
 408:common/prog/firmware_update/BootLoader/BLservices.c ****         BLCOM_sendBuffer(BLSRV_dataBuffer, length);
 409:common/prog/firmware_update/BootLoader/BLservices.c ****     }
 410:common/prog/firmware_update/BootLoader/BLservices.c ****     else
 411:common/prog/firmware_update/BootLoader/BLservices.c ****     {   // reading failed
