 349:common/prog/firmware_update/BootLoader/BLservices.c **** static enum BLCOM_rxResult BLSRV_pageErase(uint16_t address, uint16_t length)
 350:common/prog/firmware_update/BootLoader/BLservices.c **** {
 351:common/prog/firmware_update/BootLoader/BLservices.c ****     (void)length;
 352:common/prog/firmware_update/BootLoader/BLservices.c ****     uint32_t phy_address = BLSRV_getTargetAddress(address);
 353:common/prog/firmware_update/BootLoader/BLservices.c ****     
 354:common/prog/firmware_update/BootLoader/BLservices.c ****     BLCOM_sendByte(BL_ACKNOWLEDGE_OK);
 355:common/prog/firmware_update/BootLoader/BLservices.c ****     if (BLMAL_eraseBlock(phy_address))
 356:common/prog/firmware_update/BootLoader/BLservices.c ****     {   // success
 357:common/prog/firmware_update/BootLoader/BLservices.c ****         BLCOM_sendByte(BL_FLASH_CMD_OK);
 358:common/prog/firmware_update/BootLoader/BLservices.c ****     }
 359:common/prog/firmware_update/BootLoader/BLservices.c ****     else
 360:common/prog/firmware_update/BootLoader/BLservices.c ****     {
 361:common/prog/firmware_update/BootLoader/BLservices.c ****         BLCOM_sendByte(BL_FLASH_CMD_FAILED);
 362:common/prog/firmware_update/BootLoader/BLservices.c ****     }
 363:common/prog/firmware_update/BootLoader/BLservices.c ****     return (BLCOM_rxSuccess);
 364:common/prog/firmware_update/BootLoader/BLservices.c **** }
