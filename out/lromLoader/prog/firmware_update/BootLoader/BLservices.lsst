 456:common/prog/firmware_update/BootLoader/BLservices.c **** static bool BLSRV_isCrcCorrect(uint32_t address, uint32_t length, uint32_t crcExpected)
 457:common/prog/firmware_update/BootLoader/BLservices.c **** {
 458:common/prog/firmware_update/BootLoader/BLservices.c ****     CRC_crc_t crc = CRC_Init();
 459:common/prog/firmware_update/BootLoader/BLservices.c ****     while(length > 0u)
 460:common/prog/firmware_update/BootLoader/BLservices.c ****     {
 461:common/prog/firmware_update/BootLoader/BLservices.c ****         uint32_t readSize = UTI_MIN(BLSRV_BUFFER_SIZE,length);
 462:common/prog/firmware_update/BootLoader/BLservices.c ****         if(!BLMAL_readBuffer(address, readSize, BLSRV_dataBuffer))
 463:common/prog/firmware_update/BootLoader/BLservices.c ****         {   // no crc result due to read error!
 464:common/prog/firmware_update/BootLoader/BLservices.c ****             return false;
 465:common/prog/firmware_update/BootLoader/BLservices.c ****         }
 466:common/prog/firmware_update/BootLoader/BLservices.c ****         crc = CRC_Update(crc, readSize, BLSRV_dataBuffer);
 467:common/prog/firmware_update/BootLoader/BLservices.c ****         address += readSize;
 468:common/prog/firmware_update/BootLoader/BLservices.c ****         length  -= readSize;
 469:common/prog/firmware_update/BootLoader/BLservices.c ****     }
 470:common/prog/firmware_update/BootLoader/BLservices.c ****     crc = CRC_Finish(crc);
 471:common/prog/firmware_update/BootLoader/BLservices.c ****     return ((uint32_t)crc == crcExpected);
 472:common/prog/firmware_update/BootLoader/BLservices.c **** }
