 419:common/prog/firmware_update/BootLoader/BLservices.c **** {
 420:common/prog/firmware_update/BootLoader/BLservices.c ****     enum BLCOM_rxResult rxResult;
 421:common/prog/firmware_update/BootLoader/BLservices.c ****     const uint8_t crcStartAddrPos  = 0u;
 422:common/prog/firmware_update/BootLoader/BLservices.c ****     const uint8_t crcEndAddrPos    = 4u;
 423:common/prog/firmware_update/BootLoader/BLservices.c ****     const uint8_t crcExpectedPos   = 8u;
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\cc0zy6v3.s 			page 11


 424:common/prog/firmware_update/BootLoader/BLservices.c ****     const uint8_t crcCmdDataLength = 0xC;
 425:common/prog/firmware_update/BootLoader/BLservices.c ****     
 426:common/prog/firmware_update/BootLoader/BLservices.c ****     (void)address;
 427:common/prog/firmware_update/BootLoader/BLservices.c ****     (void)length;// use crcCmdDataLength instead (robustness)
 428:common/prog/firmware_update/BootLoader/BLservices.c ****     BLCOM_sendByte(BL_ACKNOWLEDGE_OK);
 429:common/prog/firmware_update/BootLoader/BLservices.c ****     rxResult = BLCOM_receiveFrame(BLSRV_dataBuffer, crcCmdDataLength, BLSRV_dataTimeout);
 430:common/prog/firmware_update/BootLoader/BLservices.c ****     if (rxResult == BLCOM_rxSuccess)
 431:common/prog/firmware_update/BootLoader/BLservices.c ****     {   
 432:common/prog/firmware_update/BootLoader/BLservices.c ****         uint32_t crcStartAddr = BLSRV_u32FromBuffer(&BLSRV_dataBuffer[crcStartAddrPos]);
 433:common/prog/firmware_update/BootLoader/BLservices.c ****         uint32_t crcEndAddr   = BLSRV_u32FromBuffer(&BLSRV_dataBuffer[crcEndAddrPos]);
 434:common/prog/firmware_update/BootLoader/BLservices.c ****         uint32_t crcExpected  = BLSRV_u32FromBuffer(&BLSRV_dataBuffer[crcExpectedPos]);
 435:common/prog/firmware_update/BootLoader/BLservices.c ****         uint32_t crcLength    =  (uint32_t)(crcEndAddr-crcStartAddr) + 1u;
 436:common/prog/firmware_update/BootLoader/BLservices.c **** 
 437:common/prog/firmware_update/BootLoader/BLservices.c ****         BLCOM_sendByte(BL_ACKNOWLEDGE_OK); // CRC data reception OK
 438:common/prog/firmware_update/BootLoader/BLservices.c ****         if(TESTUB(BLSRV_isCrcCorrect)(crcStartAddr, crcLength, crcExpected))
 439:common/prog/firmware_update/BootLoader/BLservices.c ****         {
 440:common/prog/firmware_update/BootLoader/BLservices.c ****           #if defined (BTM_FIRMWARE_UPDATE)
 441:common/prog/firmware_update/BootLoader/BLservices.c ****             /* Inform gecko boot loader to install the image to internal flash after reset.
 442:common/prog/firmware_update/BootLoader/BLservices.c ****                The reset will be managed by command BL_JUMP_APPLICATION */
 443:common/prog/firmware_update/BootLoader/BLservices.c ****             GBTL_installAfterReset();
 444:common/prog/firmware_update/BootLoader/BLservices.c ****           #endif
 445:common/prog/firmware_update/BootLoader/BLservices.c ****             BLCOM_sendByte(BL_CRC_OK);
 446:common/prog/firmware_update/BootLoader/BLservices.c ****         }
 447:common/prog/firmware_update/BootLoader/BLservices.c ****         else
 448:common/prog/firmware_update/BootLoader/BLservices.c ****         {
 449:common/prog/firmware_update/BootLoader/BLservices.c ****             BLCOM_sendByte(BL_CRC_FAILED);
 450:common/prog/firmware_update/BootLoader/BLservices.c ****         }
 451:common/prog/firmware_update/BootLoader/BLservices.c ****     }
 452:common/prog/firmware_update/BootLoader/BLservices.c ****     return rxResult;
 453:common/prog/firmware_update/BootLoader/BLservices.c **** }
