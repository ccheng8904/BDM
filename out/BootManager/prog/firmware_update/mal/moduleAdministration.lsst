 527:common/prog/firmware_update/mal/moduleAdministration.c **** /** \brief    This interface checks if the consistency of memory fragments
 528:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 529:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \param    partition:   pointer to partition table entry
 530:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 531:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \return   true if module fragments are consistent or for unfragmented modules, otherwise false
 532:common/prog/firmware_update/mal/moduleAdministration.c ****  */
 533:common/prog/firmware_update/mal/moduleAdministration.c **** static bool MAL_isConsistencyOk(const struct MAL_partition_s * partition)
 534:common/prog/firmware_update/mal/moduleAdministration.c **** {
 535:common/prog/firmware_update/mal/moduleAdministration.c ****     if(partition != NULL)
 536:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 537:common/prog/firmware_update/mal/moduleAdministration.c ****         for(uint8_t depModCnt=0u; depModCnt < MAL_maxFragments; depModCnt++)
 538:common/prog/firmware_update/mal/moduleAdministration.c ****         {
 539:common/prog/firmware_update/mal/moduleAdministration.c ****             uint32_t buildId = MAL_getBuildId(partition);
 540:common/prog/firmware_update/mal/moduleAdministration.c ****             if(partition->dep_module == MAL_NO_MODULE)
 541:common/prog/firmware_update/mal/moduleAdministration.c ****             {   //+++ normal loop exit +++
 542:common/prog/firmware_update/mal/moduleAdministration.c ****                 return true;
 543:common/prog/firmware_update/mal/moduleAdministration.c ****             }
 544:common/prog/firmware_update/mal/moduleAdministration.c ****           #ifdef FWU_FLEX_PARTITION_USED
 545:common/prog/firmware_update/mal/moduleAdministration.c ****             if(partition->mod_number == MAL_FLEX_PARTITION)
 546:common/prog/firmware_update/mal/moduleAdministration.c ****             {   // fragmented flex table not allowed
 547:common/prog/firmware_update/mal/moduleAdministration.c ****                 break;
 548:common/prog/firmware_update/mal/moduleAdministration.c ****             }
 549:common/prog/firmware_update/mal/moduleAdministration.c ****           #endif
 550:common/prog/firmware_update/mal/moduleAdministration.c ****             /* handle next module fragment */
 551:common/prog/firmware_update/mal/moduleAdministration.c ****             partition = MAL_GetMemModule(partition->dep_module);
 552:common/prog/firmware_update/mal/moduleAdministration.c ****             if(buildId != MAL_getBuildId(partition))
 553:common/prog/firmware_update/mal/moduleAdministration.c ****             {   // fragmented module is not consistent!
 554:common/prog/firmware_update/mal/moduleAdministration.c ****                 break;
 555:common/prog/firmware_update/mal/moduleAdministration.c ****             }
 556:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 557:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 558:common/prog/firmware_update/mal/moduleAdministration.c ****     return MAL_handleIntegrityError(partition, BMDAT_ER_CONSISTENCY);
 559:common/prog/firmware_update/mal/moduleAdministration.c **** }
