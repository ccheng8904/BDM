 145:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 146:common/prog/firmware_update/mal/moduleAdministration.c ****     else
 147:common/prog/firmware_update/mal/moduleAdministration.c ****     {   /* index out of range */
