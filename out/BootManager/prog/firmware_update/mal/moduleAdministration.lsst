 137:common/prog/firmware_update/mal/moduleAdministration.c **** 
 138:common/prog/firmware_update/mal/moduleAdministration.c **** const struct MAL_partition_s * MAL_GetMemModuleByIndex(uint8_t index)
 139:common/prog/firmware_update/mal/moduleAdministration.c **** {
