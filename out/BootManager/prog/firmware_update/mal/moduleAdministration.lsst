 101:common/prog/firmware_update/mal/moduleAdministration.c **** void MAL_initPartition(void)
 102:common/prog/firmware_update/mal/moduleAdministration.c **** {
 103:common/prog/firmware_update/mal/moduleAdministration.c ****     MAL_ModuleCount = 0u;
