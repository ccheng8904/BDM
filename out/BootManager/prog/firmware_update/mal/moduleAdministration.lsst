 400:common/prog/firmware_update/mal/moduleAdministration.c **** /** \brief    returns the size of a module inside a defined partition
 401:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 402:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \details  If the module size is bigger than the host partition
 403:common/prog/firmware_update/mal/moduleAdministration.c ****  *            zero will be returned.
 404:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 405:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \param    partition:   pointer to requested partition
 406:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 407:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \return   module length or zero in case of corrupted header
 408:common/prog/firmware_update/mal/moduleAdministration.c ****  */
 409:common/prog/firmware_update/mal/moduleAdministration.c **** static uint32_t MAL_getModuleSize(const struct MAL_partition_s * partition)
 410:common/prog/firmware_update/mal/moduleAdministration.c **** {
 411:common/prog/firmware_update/mal/moduleAdministration.c ****     const struct MAL_ModuleHeader_s * header = MAL_PartitionToHeader(partition);
 412:common/prog/firmware_update/mal/moduleAdministration.c ****     uint32_t modSize = 0u;
 413:common/prog/firmware_update/mal/moduleAdministration.c ****     if(header != NULL) // invalid partition
 414:common/prog/firmware_update/mal/moduleAdministration.c ****     {
