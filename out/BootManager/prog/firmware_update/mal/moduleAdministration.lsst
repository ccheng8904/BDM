 438:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 439:common/prog/firmware_update/mal/moduleAdministration.c ****         if(!MAL_isIntegrityOk(partition))
 440:common/prog/firmware_update/mal/moduleAdministration.c ****         {
 441:common/prog/firmware_update/mal/moduleAdministration.c ****             return false;
 442:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 443:common/prog/firmware_update/mal/moduleAdministration.c ****         if(!MAL_isConsistencyOk(partition))
 444:common/prog/firmware_update/mal/moduleAdministration.c ****         {
 445:common/prog/firmware_update/mal/moduleAdministration.c ****             return false;
 446:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 447:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 448:common/prog/firmware_update/mal/moduleAdministration.c ****     return true;
 449:common/prog/firmware_update/mal/moduleAdministration.c **** }
