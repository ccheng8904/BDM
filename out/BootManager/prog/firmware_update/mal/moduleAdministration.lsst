 373:common/prog/firmware_update/mal/moduleAdministration.c **** #ifdef FWU_FLEX_PARTITION_USED
 374:common/prog/firmware_update/mal/moduleAdministration.c **** /** delivers a pointer to the flash partition table
 375:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 376:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \details This interface returns the pointer to the flex partition table
 377:common/prog/firmware_update/mal/moduleAdministration.c ****              It also checks the validity of the table. In case of corrupted
 378:common/prog/firmware_update/mal/moduleAdministration.c ****              flex table NULL will be returned
 379:common/prog/firmware_update/mal/moduleAdministration.c ****     \return pointer to flex partition table or NULL in case of corrupted partition table
 380:common/prog/firmware_update/mal/moduleAdministration.c ****  */
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccCVeIE4.s 			page 19


 381:common/prog/firmware_update/mal/moduleAdministration.c **** static const struct MAL_partition_s * MAL_GetFlexPartitionTable(void)
 382:common/prog/firmware_update/mal/moduleAdministration.c **** {
 383:common/prog/firmware_update/mal/moduleAdministration.c ****     const struct MAL_partition_s *flexPat;
 384:common/prog/firmware_update/mal/moduleAdministration.c ****     flexPat = MAL_searchMemModule( MAL_FLEX_PARTITION,
 385:common/prog/firmware_update/mal/moduleAdministration.c ****                                      MAL_DataAnchor.partitionTblFix,
 386:common/prog/firmware_update/mal/moduleAdministration.c ****                                      (uint8_t)MAL_FIX_PARTITION_ENTRIES
 387:common/prog/firmware_update/mal/moduleAdministration.c ****                                     );
 388:common/prog/firmware_update/mal/moduleAdministration.c ****    #if defined(VARIANT_BOOTMANAGER)
 389:common/prog/firmware_update/mal/moduleAdministration.c ****     // return pointer to flex partition table if not corrupted, otherwise NULL
 390:common/prog/firmware_update/mal/moduleAdministration.c ****     return MAL_isIntegrityOk(flexPat) ? flexPat : NULL;
 391:common/prog/firmware_update/mal/moduleAdministration.c ****   #else
 392:common/prog/firmware_update/mal/moduleAdministration.c ****     // integrity check is done already in boot manager
 393:common/prog/firmware_update/mal/moduleAdministration.c ****     return flexPat;
 394:common/prog/firmware_update/mal/moduleAdministration.c ****   #endif
 395:common/prog/firmware_update/mal/moduleAdministration.c **** }
 396:common/prog/firmware_update/mal/moduleAdministration.c **** #endif
