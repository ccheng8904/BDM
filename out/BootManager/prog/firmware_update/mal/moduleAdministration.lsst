 422:common/prog/firmware_update/mal/moduleAdministration.c **** /** \brief    This interface checks the integrity of an application module
 423:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 424:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \param    partition:   pointer to partition table entry
 425:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 426:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \note     Interface \sa MAL_initPartition must be called first
 427:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \return   true if application integrity is OK, otherwise false
 428:common/prog/firmware_update/mal/moduleAdministration.c ****  */
 429:common/prog/firmware_update/mal/moduleAdministration.c **** static bool MAL_isApplicationIntegrityOk(void)
 430:common/prog/firmware_update/mal/moduleAdministration.c **** {
 431:common/prog/firmware_update/mal/moduleAdministration.c ****     const uint8_t modCount = MAL_GetMemModuleCount();
 432:common/prog/firmware_update/mal/moduleAdministration.c ****     for(uint8_t modIndex = 0u; modIndex < modCount; modIndex++)
 433:common/prog/firmware_update/mal/moduleAdministration.c ****     {   // do for all partition entries
 434:common/prog/firmware_update/mal/moduleAdministration.c ****         const struct MAL_partition_s *partition = MAL_GetMemModuleByIndex(modIndex);
 435:common/prog/firmware_update/mal/moduleAdministration.c ****         if(MAL_isBuildInApplication(partition))
 436:common/prog/firmware_update/mal/moduleAdministration.c ****         {   // skip build-in application, as they are independent of product app
 437:common/prog/firmware_update/mal/moduleAdministration.c ****             continue;
