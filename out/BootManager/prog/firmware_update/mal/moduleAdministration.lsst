 152:common/prog/firmware_update/mal/moduleAdministration.c **** 
 153:common/prog/firmware_update/mal/moduleAdministration.c **** uint32_t MAL_getPartitionSize(const struct MAL_partition_s * partition)
 154:common/prog/firmware_update/mal/moduleAdministration.c **** {
 155:common/prog/firmware_update/mal/moduleAdministration.c ****     uint32_t partitionSize = 0u;
 156:common/prog/firmware_update/mal/moduleAdministration.c ****     if(partition != NULL)
 157:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 158:common/prog/firmware_update/mal/moduleAdministration.c ****         partitionSize = (uint32_t)((partition->physical_end.addr - partition->physical_start.addr) 
 159:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 160:common/prog/firmware_update/mal/moduleAdministration.c ****     return partitionSize;
 161:common/prog/firmware_update/mal/moduleAdministration.c **** }
 162:common/prog/firmware_update/mal/moduleAdministration.c **** 
 163:common/prog/firmware_update/mal/moduleAdministration.c **** 
 164:common/prog/firmware_update/mal/moduleAdministration.c **** const struct MAL_ModuleHeader_s * MAL_PartitionToHeader( const struct MAL_partition_s *partition )
 165:common/prog/firmware_update/mal/moduleAdministration.c **** {
 166:common/prog/firmware_update/mal/moduleAdministration.c ****     static struct MAL_ModuleHeader_s moduleHeaderInRam;
 167:common/prog/firmware_update/mal/moduleAdministration.c ****     static const struct MAL_partition_s *actualPartition = NULL;
 168:common/prog/firmware_update/mal/moduleAdministration.c ****     if(partition == NULL)
 169:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 170:common/prog/firmware_update/mal/moduleAdministration.c ****         return NULL;
 171:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 172:common/prog/firmware_update/mal/moduleAdministration.c ****     if(actualPartition != partition)
 173:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 174:common/prog/firmware_update/mal/moduleAdministration.c ****         if(MAL_copyModuleHeaderToRAM(partition, &moduleHeaderInRam) != true)
 175:common/prog/firmware_update/mal/moduleAdministration.c ****         {
 176:common/prog/firmware_update/mal/moduleAdministration.c ****             return NULL;
 177:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 178:common/prog/firmware_update/mal/moduleAdministration.c ****         actualPartition = partition;
 179:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 180:common/prog/firmware_update/mal/moduleAdministration.c ****     return &moduleHeaderInRam;
 181:common/prog/firmware_update/mal/moduleAdministration.c **** }
 182:common/prog/firmware_update/mal/moduleAdministration.c **** 
 183:common/prog/firmware_update/mal/moduleAdministration.c **** 
 184:common/prog/firmware_update/mal/moduleAdministration.c **** bool MAL_isBuildInApplication(const struct MAL_partition_s * partition)
 185:common/prog/firmware_update/mal/moduleAdministration.c **** {
 186:common/prog/firmware_update/mal/moduleAdministration.c ****     if(partition != NULL)
 187:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 188:common/prog/firmware_update/mal/moduleAdministration.c ****         enum MAL_ModuleEnum moduleId = partition->mod_number;
 189:common/prog/firmware_update/mal/moduleAdministration.c ****         return ((moduleId == MAL_PROGRAMMER_ID) || (moduleId == MAL_BP2_LOADER_ID));
 190:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 191:common/prog/firmware_update/mal/moduleAdministration.c ****     else
 192:common/prog/firmware_update/mal/moduleAdministration.c ****     {   // no valid partition given
 193:common/prog/firmware_update/mal/moduleAdministration.c ****         return false;
 194:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 195:common/prog/firmware_update/mal/moduleAdministration.c **** 
 196:common/prog/firmware_update/mal/moduleAdministration.c **** }
 197:common/prog/firmware_update/mal/moduleAdministration.c **** 
 198:common/prog/firmware_update/mal/moduleAdministration.c **** 
 199:common/prog/firmware_update/mal/moduleAdministration.c **** #if defined(VARIANT_BOOTMANAGER)
 200:common/prog/firmware_update/mal/moduleAdministration.c **** bool MAL_isModuleIntegrityOk(const struct MAL_partition_s * partitionToStart)
 201:common/prog/firmware_update/mal/moduleAdministration.c **** {
 202:common/prog/firmware_update/mal/moduleAdministration.c ****     if(MAL_isBuildInApplication(partitionToStart))
 203:common/prog/firmware_update/mal/moduleAdministration.c ****     {   // check integrity of build-in application
 204:common/prog/firmware_update/mal/moduleAdministration.c ****         return MAL_isIntegrityOk(partitionToStart);
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccCVeIE4.s 			page 5


 205:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 206:common/prog/firmware_update/mal/moduleAdministration.c ****     else
 207:common/prog/firmware_update/mal/moduleAdministration.c ****     {   // check the integrity of product application
 208:common/prog/firmware_update/mal/moduleAdministration.c ****         return MAL_isApplicationIntegrityOk();
 209:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 210:common/prog/firmware_update/mal/moduleAdministration.c **** }
 211:common/prog/firmware_update/mal/moduleAdministration.c **** #endif
 212:common/prog/firmware_update/mal/moduleAdministration.c **** 
 213:common/prog/firmware_update/mal/moduleAdministration.c **** 
 214:common/prog/firmware_update/mal/moduleAdministration.c **** #if defined(APP_VARIANT)
 215:common/prog/firmware_update/mal/moduleAdministration.c **** bool MAL_writeFirmwareIDs(void)
 216:common/prog/firmware_update/mal/moduleAdministration.c **** {
 217:common/prog/firmware_update/mal/moduleAdministration.c ****     /*lint -save -e934 Taking address of near auto variable [MISRA 2012 Rule 1.3, required], not a 
 218:common/prog/firmware_update/mal/moduleAdministration.c ****     struct MAL_fw_id_array firmwareIdTable;
 219:common/prog/firmware_update/mal/moduleAdministration.c ****     uint8_t fwidToWrite = 0;
 220:common/prog/firmware_update/mal/moduleAdministration.c ****     uint8_t moduleCount = MAL_GetMemModuleCount();
 221:common/prog/firmware_update/mal/moduleAdministration.c ****     uint32_t CrcLength = (sizeof(struct MAL_fw_id_entry) * FWU_FW_ID_MAX_COUNT);
 222:common/prog/firmware_update/mal/moduleAdministration.c **** 
 223:common/prog/firmware_update/mal/moduleAdministration.c ****     /* Initialize firmwareIdTable with empty entries */
 224:common/prog/firmware_update/mal/moduleAdministration.c ****     OTP_initializeFirmwareIDArray(&firmwareIdTable);
 225:common/prog/firmware_update/mal/moduleAdministration.c **** 
 226:common/prog/firmware_update/mal/moduleAdministration.c ****     /* Go trough each partition/module header and append FW ID */
 227:common/prog/firmware_update/mal/moduleAdministration.c ****     for(uint8_t moduleIndex = 0; moduleIndex < moduleCount; moduleIndex++)
 228:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 229:common/prog/firmware_update/mal/moduleAdministration.c ****         const struct MAL_partition_s *partition = MAL_GetMemModuleByIndex(moduleIndex);
 230:common/prog/firmware_update/mal/moduleAdministration.c ****         const struct MAL_ModuleHeader_s * header = MAL_PartitionToHeader(partition);
 231:common/prog/firmware_update/mal/moduleAdministration.c ****         
 232:common/prog/firmware_update/mal/moduleAdministration.c ****         /* Built in applications does not require FWID to be written */
 233:common/prog/firmware_update/mal/moduleAdministration.c ****         if(!MAL_isBuildInApplication(partition))
 234:common/prog/firmware_update/mal/moduleAdministration.c ****         {
 235:common/prog/firmware_update/mal/moduleAdministration.c ****             /* Problem with partition/module header should be caught by BM */
 236:common/prog/firmware_update/mal/moduleAdministration.c ****             if((partition != NULL) && (header != NULL))
 237:common/prog/firmware_update/mal/moduleAdministration.c ****             {
 238:common/prog/firmware_update/mal/moduleAdministration.c ****                 if((partition->mod_attributes & MAL_CTX_MF_NO_COMPATIBILITY_CHECK) == 0u)
 239:common/prog/firmware_update/mal/moduleAdministration.c ****                 {
 240:common/prog/firmware_update/mal/moduleAdministration.c ****                     /* mod_attributes does not contain module flag bit MAL_CTX_MF_NO_COMPATIBILITY_
 241:common/prog/firmware_update/mal/moduleAdministration.c ****                      * module's sw_version ID will be part of FWID table */
 242:common/prog/firmware_update/mal/moduleAdministration.c ****                     firmwareIdTable.entries[fwidToWrite].mod_number = partition->mod_number;
 243:common/prog/firmware_update/mal/moduleAdministration.c ****                     UTI_vMemCopy(header->sw_version.version.ID, firmwareIdTable.entries[fwidToWrite
 244:common/prog/firmware_update/mal/moduleAdministration.c ****                     fwidToWrite++;
 245:common/prog/firmware_update/mal/moduleAdministration.c ****                 }
 246:common/prog/firmware_update/mal/moduleAdministration.c ****             }
 247:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 248:common/prog/firmware_update/mal/moduleAdministration.c ****         
 249:common/prog/firmware_update/mal/moduleAdministration.c ****         /* Stop if it is reached a maximum number of FW ID that has to be written */
