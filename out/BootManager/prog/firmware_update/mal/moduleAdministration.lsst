 269:common/prog/firmware_update/mal/moduleAdministration.c **** /** \brief    This interface returns the pointer the the requested partition
 270:common/prog/firmware_update/mal/moduleAdministration.c ****  *            entry.
 271:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 272:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \param    module:   enumerator of requested module
 273:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 274:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \return   pointer to requested partition in case of success, else null
 275:common/prog/firmware_update/mal/moduleAdministration.c ****  */
 276:common/prog/firmware_update/mal/moduleAdministration.c **** static const struct MAL_partition_s * MAL_searchMemModule
 277:common/prog/firmware_update/mal/moduleAdministration.c **** (
 278:common/prog/firmware_update/mal/moduleAdministration.c ****     enum MAL_ModuleEnum          module,
 279:common/prog/firmware_update/mal/moduleAdministration.c ****     const struct MAL_partition_s * partitionTbl,
 280:common/prog/firmware_update/mal/moduleAdministration.c ****     uint8_t                      maxTableLen
 281:common/prog/firmware_update/mal/moduleAdministration.c **** )
 282:common/prog/firmware_update/mal/moduleAdministration.c **** {
 283:common/prog/firmware_update/mal/moduleAdministration.c ****     if(partitionTbl == NULL){return NULL;} // no valid partition table
 284:common/prog/firmware_update/mal/moduleAdministration.c ****     for (uint8_t index = 0u; index < maxTableLen; index++)
 285:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 286:common/prog/firmware_update/mal/moduleAdministration.c ****         if (partitionTbl[index].mod_number == MAL_NO_MODULE)
 287:common/prog/firmware_update/mal/moduleAdministration.c ****         {   // end of table reached --> nothing found
 288:common/prog/firmware_update/mal/moduleAdministration.c ****             return NULL;
 289:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 290:common/prog/firmware_update/mal/moduleAdministration.c ****         if ( partitionTbl[index].mod_number == module )
 291:common/prog/firmware_update/mal/moduleAdministration.c ****         {
 292:common/prog/firmware_update/mal/moduleAdministration.c ****             return &partitionTbl[index];
 293:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 294:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 295:common/prog/firmware_update/mal/moduleAdministration.c **** 
 296:common/prog/firmware_update/mal/moduleAdministration.c ****     return NULL;
 297:common/prog/firmware_update/mal/moduleAdministration.c **** }
