 105:common/prog/firmware_update/mal/moduleAdministration.c ****     MAL_flexPatRef = MAL_GetFlexPartitionTable();
 106:common/prog/firmware_update/mal/moduleAdministration.c ****   #endif
 107:common/prog/firmware_update/mal/moduleAdministration.c **** }
