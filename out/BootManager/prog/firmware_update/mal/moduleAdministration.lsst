 480:common/prog/firmware_update/mal/moduleAdministration.c **** /** \brief    This interface validates the CRC of a module inside partition
 481:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 482:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \param    partition:   pointer to partition table entry
 483:common/prog/firmware_update/mal/moduleAdministration.c ****  *
 484:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \note     Interface \sa MAL_initPartition must be called first
 485:common/prog/firmware_update/mal/moduleAdministration.c ****  *  \return   true, if module is not altered, otherwise false
 486:common/prog/firmware_update/mal/moduleAdministration.c ****  */
 487:common/prog/firmware_update/mal/moduleAdministration.c **** static bool MAL_isModuleCrcValid(const struct MAL_partition_s * partition)
 488:common/prog/firmware_update/mal/moduleAdministration.c **** {
 489:common/prog/firmware_update/mal/moduleAdministration.c ****     const uint32_t CrcSize  = sizeof(uint32_t); // reserved size for expected CRC
 490:common/prog/firmware_update/mal/moduleAdministration.c ****     uint32_t modSize  = MAL_getModuleSize(partition); // module size in bytes
 491:common/prog/firmware_update/mal/moduleAdministration.c ****     if(modSize > CrcSize)
 492:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 493:common/prog/firmware_update/mal/moduleAdministration.c ****         CRC_crc_t CrcCalc = 0u;
 494:common/prog/firmware_update/mal/moduleAdministration.c ****         uint32_t  size         = modSize - CrcSize;
 495:common/prog/firmware_update/mal/moduleAdministration.c ****         /* "Conversion between object pointer and void pointer [void*->uint8_t*] MisraC2012-11.5"
 496:common/prog/firmware_update/mal/moduleAdministration.c ****            "Pointer arithmetic not allowed [+]  MisraC2012  18.4", but uncritical.*/
 497:common/prog/firmware_update/mal/moduleAdministration.c **** 
 498:common/prog/firmware_update/mal/moduleAdministration.c ****         const uint8_t  *startAddr    = (uint8_t*)partition->physical_start.ptr + CrcSize;/*lint !e9
 499:common/prog/firmware_update/mal/moduleAdministration.c ****         CRC_crc_t CrcExpected  = (CRC_crc_t)MAL_PartitionToHeader(partition)->crc_expected;
 500:common/prog/firmware_update/mal/moduleAdministration.c ****         
 501:common/prog/firmware_update/mal/moduleAdministration.c ****       #ifdef FWU_MEM_DRV_READ_ONLY
 502:common/prog/firmware_update/mal/moduleAdministration.c ****         if(MEMDRV_open(partition->driver_id) == MAL_ST_OK) 
 503:common/prog/firmware_update/mal/moduleAdministration.c ****         {   // memory driver available --> read function must be used
 504:common/prog/firmware_update/mal/moduleAdministration.c ****             /*lint -e{934} Taking address of near auto variable [MISRA 2012 Rule 1.3, required], no
 505:common/prog/firmware_update/mal/moduleAdministration.c ****             if(MEMDRV_calcCrc((uint32_t)startAddr, size, &CrcCalc) != MAL_ST_OK)/*lint !e923 cast f
 506:common/prog/firmware_update/mal/moduleAdministration.c ****             {
 507:common/prog/firmware_update/mal/moduleAdministration.c ****                 (void)MEMDRV_close();
 508:common/prog/firmware_update/mal/moduleAdministration.c ****                 return MAL_handleIntegrityError(partition, BMDAT_ER_CRC);
 509:common/prog/firmware_update/mal/moduleAdministration.c ****             }
 510:common/prog/firmware_update/mal/moduleAdministration.c ****             (void)MEMDRV_close();
 511:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 512:common/prog/firmware_update/mal/moduleAdministration.c ****         else
 513:common/prog/firmware_update/mal/moduleAdministration.c ****       #endif
 514:common/prog/firmware_update/mal/moduleAdministration.c ****         {   //lint -e{926}   "Conversion between object pointer and void pointer MisraC2012 11.5" *
 515:common/prog/firmware_update/mal/moduleAdministration.c ****             CrcCalc = CRC_Calc(size, startAddr);/*lint !e926 */
 516:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 517:common/prog/firmware_update/mal/moduleAdministration.c **** 
 518:common/prog/firmware_update/mal/moduleAdministration.c ****         if(CrcCalc == CrcExpected)
 519:common/prog/firmware_update/mal/moduleAdministration.c ****         {
 520:common/prog/firmware_update/mal/moduleAdministration.c ****             return true;
 521:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 522:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 523:common/prog/firmware_update/mal/moduleAdministration.c ****     return MAL_handleIntegrityError(partition, BMDAT_ER_CRC);
 524:common/prog/firmware_update/mal/moduleAdministration.c **** }
