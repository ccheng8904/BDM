 170:common/prog/firmware_update/BootManager/BootManagerModule.c **** {
 171:common/prog/firmware_update/BootManager/BootManagerModule.c ****     const struct MAL_fw_id_array  * FwIdArrayToCheck = OTP_getFirmwareIDs();
