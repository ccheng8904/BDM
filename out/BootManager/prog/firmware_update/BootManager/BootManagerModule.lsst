 209:common/prog/firmware_update/BootManager/BootManagerModule.c ****  */
 210:common/prog/firmware_update/BootManager/BootManagerModule.c **** static bool BMMOD_isStdvIdEqual(const uint8_t* id1, const uint8_t* id2)
 211:common/prog/firmware_update/BootManager/BootManagerModule.c **** {
