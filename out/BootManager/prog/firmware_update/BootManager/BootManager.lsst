 105:common/prog/firmware_update/mal/fwu_opt_bytes.h **** /** \brief    returns true/false if Integrity check calculation is disabled or not
 106:common/prog/firmware_update/mal/fwu_opt_bytes.h ****  *
 107:common/prog/firmware_update/mal/fwu_opt_bytes.h ****  *  \details  For FWU1 (WIRED_FIRMWARE_UPDATE) there is available only integrity check (CRC)
 108:common/prog/firmware_update/mal/fwu_opt_bytes.h ****  *            There is no BootManager binary where are stored default FWU opt bytes
 109:common/prog/firmware_update/mal/fwu_opt_bytes.h ****  *            which are used in RELEASE case.
 110:common/prog/firmware_update/mal/fwu_opt_bytes.h ****  *            From this reason we must handle it via NDEBUG(RELEASE) switch.
 111:common/prog/firmware_update/mal/fwu_opt_bytes.h ****  *
 112:common/prog/firmware_update/mal/fwu_opt_bytes.h ****  *  \return   true:  calculation is disabled
 113:common/prog/firmware_update/mal/fwu_opt_bytes.h ****  *            false: calculation is enabled
 114:common/prog/firmware_update/mal/fwu_opt_bytes.h ****  */
 115:common/prog/firmware_update/mal/fwu_opt_bytes.h **** static inline bool FWU_isIntegCheckDisabledCalc(void)
 116:common/prog/firmware_update/mal/fwu_opt_bytes.h **** {
 117:common/prog/firmware_update/mal/fwu_opt_bytes.h **** #ifdef REMOTE_FIRMWARE_UPDATE
 118:common/prog/firmware_update/mal/fwu_opt_bytes.h ****     return ((MAL_getIntegrityOpt() == MAL_INTEGRITY_DISABLE_CALC) ? true : false);
 119:common/prog/firmware_update/mal/fwu_opt_bytes.h **** #else // WIRED_FIRMWARE_UPDATE
 120:common/prog/firmware_update/mal/fwu_opt_bytes.h ****     #ifdef NDEBUG // RELEASE
 121:common/prog/firmware_update/mal/fwu_opt_bytes.h ****         return false;
 122:common/prog/firmware_update/mal/fwu_opt_bytes.h ****     #else
 123:common/prog/firmware_update/mal/fwu_opt_bytes.h ****         return ((MAL_getIntegrityOpt() == MAL_INTEGRITY_DISABLE_CALC) ? true : false);
 124:common/prog/firmware_update/mal/fwu_opt_bytes.h ****     #endif
 125:common/prog/firmware_update/mal/fwu_opt_bytes.h **** #endif
 126:common/prog/firmware_update/mal/fwu_opt_bytes.h **** }
 127:common/prog/firmware_update/mal/fwu_opt_bytes.h **** 
