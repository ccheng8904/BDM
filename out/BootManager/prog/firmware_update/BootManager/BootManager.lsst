  89:common/prog/firmware_update/BootManager/BootManager.c **** /** \brief    Switches to the next possible boot module.
  90:common/prog/firmware_update/BootManager/BootManager.c ****  *
  91:common/prog/firmware_update/BootManager/BootManager.c ****  *  \details  If any error occurs during module start this function is called
  92:common/prog/firmware_update/BootManager/BootManager.c ****  *            to switch to the next possible boot module
  93:common/prog/firmware_update/BootManager/BootManager.c ****  */
  94:common/prog/firmware_update/BootManager/BootManager.c **** static void BMAPP_switchBootModule(void)
  95:common/prog/firmware_update/BootManager/BootManager.c **** {
  96:common/prog/firmware_update/BootManager/BootManager.c ****     if (BMDAT_getBootModule() != MAL_PROGRAMMER_ID)
  97:common/prog/firmware_update/BootManager/BootManager.c ****     {   // try first the programmer
  98:common/prog/firmware_update/BootManager/BootManager.c ****         BMDAT_setBootModule(MAL_PROGRAMMER_ID);
  99:common/prog/firmware_update/BootManager/BootManager.c ****     }
 100:common/prog/firmware_update/BootManager/BootManager.c ****     else
 101:common/prog/firmware_update/BootManager/BootManager.c ****     {   // when programmer not works try application
 102:common/prog/firmware_update/BootManager/BootManager.c ****         BMDAT_setBootModule(MAL_PRODUCT_APP1);
 103:common/prog/firmware_update/BootManager/BootManager.c ****     }
 104:common/prog/firmware_update/BootManager/BootManager.c ****     /* note when Programmer and application does not work the
 105:common/prog/firmware_update/BootManager/BootManager.c ****        the BP2 loader may be started.
 106:common/prog/firmware_update/BootManager/BootManager.c ****        This is not done because of security
 107:common/prog/firmware_update/BootManager/BootManager.c ****      */
 108:common/prog/firmware_update/BootManager/BootManager.c **** }
