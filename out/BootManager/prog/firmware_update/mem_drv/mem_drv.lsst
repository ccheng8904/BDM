 314:common/prog/firmware_update/mem_drv/mem_drv.c **** 
 315:common/prog/firmware_update/mem_drv/mem_drv.c **** /** \brief Erases an atomic block inside according memory.
 316:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \details The memory driver decides how much bytes will be erased.
 317:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \param addr[in,out] in: start addr to erase, out: next erase addr
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccmMaSLa.s 			page 7


 318:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \param size[in,out] in: number of bytes to erase, out: number of bytes left
 319:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \return result of operation [MAL_ST_ERASE_ERROR, MAL_ST_OK]
 320:common/prog/firmware_update/mem_drv/mem_drv.c ****  */
 321:common/prog/firmware_update/mem_drv/mem_drv.c **** static enum MAL_Status MEMDRV_eraseAtomic(uint32_t *addr, uint32_t *size)
 322:common/prog/firmware_update/mem_drv/mem_drv.c **** {
 323:common/prog/firmware_update/mem_drv/mem_drv.c ****     uint32_t erasedSize = MEMDRV_driver->erase(*addr, *size);
 324:common/prog/firmware_update/mem_drv/mem_drv.c ****     MEMDRV_waitForOperationComplete();
 325:common/prog/firmware_update/mem_drv/mem_drv.c ****     if(MEMDRV_driver->isError() || (erasedSize == 0u))
 326:common/prog/firmware_update/mem_drv/mem_drv.c ****     {
 327:common/prog/firmware_update/mem_drv/mem_drv.c ****         return MAL_ST_ERASE_ERROR;
 328:common/prog/firmware_update/mem_drv/mem_drv.c ****     }
 329:common/prog/firmware_update/mem_drv/mem_drv.c ****     *size  = ((*size > erasedSize) ? (uint32_t)(*size-erasedSize) : 0u);
 330:common/prog/firmware_update/mem_drv/mem_drv.c ****     *addr += erasedSize;
 331:common/prog/firmware_update/mem_drv/mem_drv.c ****     return MAL_ST_OK;
 332:common/prog/firmware_update/mem_drv/mem_drv.c **** }
