 261:common/prog/firmware_update/mem_drv/mem_drv.c **** 
 262:common/prog/firmware_update/mem_drv/mem_drv.c **** 
 263:common/prog/firmware_update/mem_drv/mem_drv.c **** /** \brief Writes a block of data from ring buffer to according memory.
 264:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \details This interface writes at most MEMDRV_WRITE_BUFFER_SIZE bytes
 265:common/prog/firmware_update/mem_drv/mem_drv.c ****  *           to the according memory. rest smaller than minimal write block
 266:common/prog/firmware_update/mem_drv/mem_drv.c ****  *           is ignored.
 267:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \return result of operation [MAL_ST_WRITE_ERROR, MAL_ST_OK]
 268:common/prog/firmware_update/mem_drv/mem_drv.c ****  */
 269:common/prog/firmware_update/mem_drv/mem_drv.c **** static enum MAL_Status MEMDRV_writeBlock(void)
 270:common/prog/firmware_update/mem_drv/mem_drv.c **** {
 271:common/prog/firmware_update/mem_drv/mem_drv.c ****     enum MAL_Status  status = MAL_ST_OK;
 272:common/prog/firmware_update/mem_drv/mem_drv.c ****     uint8_t  buf[MEMDRV_WRITE_BUFFER_SIZE];
 273:common/prog/firmware_update/mem_drv/mem_drv.c ****     const uint8_t  *data  = buf;
 274:common/prog/firmware_update/mem_drv/mem_drv.c **** 
 275:common/prog/firmware_update/mem_drv/mem_drv.c ****     // copy data form ring to linear buffer
 276:common/prog/firmware_update/mem_drv/mem_drv.c ****     uint32_t size = RBUF_readBuffN(&MEMDRV_rb, buf, (RBUF_size_t)MEMDRV_WRITE_BUFFER_SIZE);
 277:common/prog/firmware_update/mem_drv/mem_drv.c ****     if(size > 0u)
 278:common/prog/firmware_update/mem_drv/mem_drv.c ****     {
 279:common/prog/firmware_update/mem_drv/mem_drv.c ****         MEMDRV_disableInt();
 280:common/prog/firmware_update/mem_drv/mem_drv.c ****         while((size >= MEMDRV_driver->writeBlockSize) && (status == MAL_ST_OK))
 281:common/prog/firmware_update/mem_drv/mem_drv.c ****         {
 282:common/prog/firmware_update/mem_drv/mem_drv.c ****             status = MEMDRV_writeAtomic(&MEMDRV_writeAddr, &size, &data);
 283:common/prog/firmware_update/mem_drv/mem_drv.c ****         }
 284:common/prog/firmware_update/mem_drv/mem_drv.c ****         // copy unwritten data back to ring buffer
 285:common/prog/firmware_update/mem_drv/mem_drv.c ****         (void)RBUF_writeBuff(&MEMDRV_rb, data, (RBUF_size_t)size);
 286:common/prog/firmware_update/mem_drv/mem_drv.c ****         MEMDRV_driver->reset();
 287:common/prog/firmware_update/mem_drv/mem_drv.c ****         MEMDRV_enableInt();
 288:common/prog/firmware_update/mem_drv/mem_drv.c ****     }
 289:common/prog/firmware_update/mem_drv/mem_drv.c ****     return status;
 290:common/prog/firmware_update/mem_drv/mem_drv.c **** }
 291:common/prog/firmware_update/mem_drv/mem_drv.c **** 
 292:common/prog/firmware_update/mem_drv/mem_drv.c **** 
 293:common/prog/firmware_update/mem_drv/mem_drv.c **** /** \brief Writes an atomic block of data from ring buffer to according memory.
 294:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \details The memory driver decides how much bytes will be written.
 295:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \param addr[in,out] in: start addr to write, out: next addr
 296:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \param size[in,out] in: number of bytes to write, out: number of bytes left
 297:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \param data[in,out] in: pointer to data to place in ring buffer, out: next byte
 298:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \return result of operation [MAL_ST_WRITE_ERROR, MAL_ST_OK]
 299:common/prog/firmware_update/mem_drv/mem_drv.c ****  */
 300:common/prog/firmware_update/mem_drv/mem_drv.c **** static enum MAL_Status MEMDRV_writeAtomic(uint32_t *addr, uint32_t *size, const uint8_t **data)
 301:common/prog/firmware_update/mem_drv/mem_drv.c **** {
 302:common/prog/firmware_update/mem_drv/mem_drv.c ****     uint32_t writtenSize = MEMDRV_driver->write(*addr, *size, *data);
 303:common/prog/firmware_update/mem_drv/mem_drv.c ****     MEMDRV_waitForOperationComplete();
 304:common/prog/firmware_update/mem_drv/mem_drv.c ****     if(MEMDRV_driver->isError() || (writtenSize == 0u))
 305:common/prog/firmware_update/mem_drv/mem_drv.c ****     {
 306:common/prog/firmware_update/mem_drv/mem_drv.c ****         return MAL_ST_WRITE_ERROR;
 307:common/prog/firmware_update/mem_drv/mem_drv.c ****     }
 308:common/prog/firmware_update/mem_drv/mem_drv.c ****     *size  = ((*size > writtenSize) ? (uint32_t)(*size-writtenSize) : 0u);
 309:common/prog/firmware_update/mem_drv/mem_drv.c ****     *addr += writtenSize;
 310:common/prog/firmware_update/mem_drv/mem_drv.c ****     *data += writtenSize; /*lint !e9016 "Pointer arithmetic not allowed", MIRA advisory 18.4 */
 311:common/prog/firmware_update/mem_drv/mem_drv.c ****     return MAL_ST_OK;
 312:common/prog/firmware_update/mem_drv/mem_drv.c **** }
