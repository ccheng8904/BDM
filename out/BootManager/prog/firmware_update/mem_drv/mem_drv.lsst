 335:common/prog/firmware_update/mem_drv/mem_drv.c **** /** Checks if even data is left in buffer.
 336:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \details Underlying memory may have a minimal write block size,
 337:common/prog/firmware_update/mem_drv/mem_drv.c ****  *           smaller blocks cannot be written to the memory.
 338:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \return true if enough data available for a write, otherwise false
 339:common/prog/firmware_update/mem_drv/mem_drv.c ****  */
 340:common/prog/firmware_update/mem_drv/mem_drv.c **** static bool MEMDRV_isEvenDataLeft(void)
 341:common/prog/firmware_update/mem_drv/mem_drv.c **** {
 342:common/prog/firmware_update/mem_drv/mem_drv.c ****     return (RBUF_getBytesToRead(&MEMDRV_rb) >= MEMDRV_driver->writeBlockSize);
 343:common/prog/firmware_update/mem_drv/mem_drv.c **** }
