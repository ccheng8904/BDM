 426:common/prog/firmware_update/mem_drv/mem_drv.c **** /** \brief Calculates the CRC for a block inside according memory.
 427:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \details The memory driver decides how much bytes will be erased.
 428:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \param addr[in,out] in: start addr to calculate CRC, out: next addr
 429:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \param size[in,out] in: number of bytes to calculate, out: number of bytes left
 430:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \return result of operation [MAL_ST_READ_ERROR, MAL_ST_OK]
 431:common/prog/firmware_update/mem_drv/mem_drv.c ****  */
 432:common/prog/firmware_update/mem_drv/mem_drv.c **** static enum MAL_Status MEMDRV_calcCrcAtomic(uint32_t *addr, uint32_t *size, CRC_crc_t *crc)
 433:common/prog/firmware_update/mem_drv/mem_drv.c **** {
 434:common/prog/firmware_update/mem_drv/mem_drv.c ****     uint8_t readBuffer[MEMDRV_READ_BUFFER_SIZE];
 435:common/prog/firmware_update/mem_drv/mem_drv.c ****     uint32_t readSize = MEMDRV_min(MEMDRV_READ_BUFFER_SIZE, *size);
 436:common/prog/firmware_update/mem_drv/mem_drv.c ****     if(!MEMDRV_readBlock(*addr, readSize, readBuffer))
 437:common/prog/firmware_update/mem_drv/mem_drv.c ****     {
 438:common/prog/firmware_update/mem_drv/mem_drv.c ****           return MAL_ST_READ_ERROR;
 439:common/prog/firmware_update/mem_drv/mem_drv.c ****     }
 440:common/prog/firmware_update/mem_drv/mem_drv.c ****     *crc   = CRC_Update(*crc, readSize, readBuffer);
 441:common/prog/firmware_update/mem_drv/mem_drv.c ****     *size -= readSize;
 442:common/prog/firmware_update/mem_drv/mem_drv.c ****     *addr += readSize;
 443:common/prog/firmware_update/mem_drv/mem_drv.c ****     return MAL_ST_OK;
 444:common/prog/firmware_update/mem_drv/mem_drv.c **** }
