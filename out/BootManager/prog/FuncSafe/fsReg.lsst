 114:common/prog/FuncSafe/fsReg.c **** /** The Register Channel Task.
 115:common/prog/FuncSafe/fsReg.c ****     CPU work registers are saved and checked against stuck-at faults and comparable faults.
 116:common/prog/FuncSafe/fsReg.c ****     After this check, they get restored again. So, this check does not change the content
 117:common/prog/FuncSafe/fsReg.c ****     of the work registers from the callers point of view. In case of a fault, there is no
 118:common/prog/FuncSafe/fsReg.c ****     return here!
 119:common/prog/FuncSafe/fsReg.c **** 
 120:common/prog/FuncSafe/fsReg.c ****     \return uint8_t   state of register channel task
 121:common/prog/FuncSafe/fsReg.c **** 
 122:common/prog/FuncSafe/fsReg.c ****     \pre    None
 123:common/prog/FuncSafe/fsReg.c ****     \post   Conditions for the CPU registers are fulfilled
 124:common/prog/FuncSafe/fsReg.c **** */
 125:common/prog/FuncSafe/fsReg.c **** uint8_t FSF_ucRegHandleTask(void)
