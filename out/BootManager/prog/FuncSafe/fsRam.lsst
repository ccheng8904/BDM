 167:common/prog/FuncSafe/fsRam.c **** /** Do one operational check cycle
 168:common/prog/FuncSafe/fsRam.c **** This handler basically provide three different means:
 169:common/prog/FuncSafe/fsRam.c **** 1.) On call, it checks the addressed area against cell errors.
 170:common/prog/FuncSafe/fsRam.c **** 2.) It maintains the actual RAM segment length
 171:common/prog/FuncSafe/fsRam.c **** */
 172:common/prog/FuncSafe/fsRam.c **** STATIC  void    vRamOpercheck (uint8_t * pucRAM, uint8_t * pucDEXBuffer, uint8_t ucPatNoInv, uint8_
 173:common/prog/FuncSafe/fsRam.c **** {
 174:common/prog/FuncSafe/fsRam.c **** 
 175:common/prog/FuncSafe/fsRam.c **** /*======================================================================
 176:common/prog/FuncSafe/fsRam.c ****     Preserve some loop variables for test
 177:common/prog/FuncSafe/fsRam.c **** ======================================================================*/
 178:common/prog/FuncSafe/fsRam.c **** #ifdef TH_FSCOM
 179:common/prog/FuncSafe/fsRam.c ****    //  Some Loop variables
 180:common/prog/FuncSafe/fsRam.c ****    uint8_t   i;
 181:common/prog/FuncSafe/fsRam.c ****    uint8_t * p;
 182:common/prog/FuncSafe/fsRam.c ****    uint8_t * q;
 183:common/prog/FuncSafe/fsRam.c **** #endif
 184:common/prog/FuncSafe/fsRam.c **** 
 185:common/prog/FuncSafe/fsRam.c **** /*======================================================================
 186:common/prog/FuncSafe/fsRam.c ****     Disable all interrupts while checking
 187:common/prog/FuncSafe/fsRam.c **** ======================================================================*/
 188:common/prog/FuncSafe/fsRam.c **** #ifdef TH_FSCOM
 189:common/prog/FuncSafe/fsRam.c ****    //  Only keep track of interrupt disabling
 190:common/prog/FuncSafe/fsRam.c ****    TH_FSFP_PushOutPar(TP_FSF_RAM_INT_Disabled);
 191:common/prog/FuncSafe/fsRam.c **** #else
 192:common/prog/FuncSafe/fsRam.c ****    //  Do it real!
 193:common/prog/FuncSafe/fsRam.c ****    HSUP_vDisableInt();
 194:common/prog/FuncSafe/fsRam.c ****    _FSF_vDoWhenPieceRamCheckStarted();
 195:common/prog/FuncSafe/fsRam.c **** #endif
 196:common/prog/FuncSafe/fsRam.c **** 
 197:common/prog/FuncSafe/fsRam.c **** /*======================================================================
 198:common/prog/FuncSafe/fsRam.c ****     Test Harness code
 199:common/prog/FuncSafe/fsRam.c **** ======================================================================*/
 200:common/prog/FuncSafe/fsRam.c **** #ifdef TH_FSCOM
 201:common/prog/FuncSafe/fsRam.c ****    //  Notify this piece of code has passed
 202:common/prog/FuncSafe/fsRam.c ****    TH_FSFP_PushOutPar(TP_FSF_FSF_vRamOpercheck);
 203:common/prog/FuncSafe/fsRam.c ****    TH_FSFP_PushOutPar(ucPatNoInv);
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\cc7QvOlA.s 			page 5


 204:common/prog/FuncSafe/fsRam.c ****    TH_FSFP_PushOutPar(ucPatInv);
 205:common/prog/FuncSafe/fsRam.c ****    //  For test purposes:
 206:common/prog/FuncSafe/fsRam.c ****    //  - save the original data into the exchange buffer
 207:common/prog/FuncSafe/fsRam.c ****    for (i=(uint8_t)0,q = pucDEXBuffer, p = pucRAM; i < (uint8_t)MARCHBUFLENGTH; i++)
 208:common/prog/FuncSafe/fsRam.c ****    {
 209:common/prog/FuncSafe/fsRam.c ****       *q++ = *p++;
 210:common/prog/FuncSafe/fsRam.c ****    }
 211:common/prog/FuncSafe/fsRam.c ****    //  - then, fill the original data with the check pattern
 212:common/prog/FuncSafe/fsRam.c ****    for (i=(uint8_t)0,q = pucRAM; i < (uint8_t)MARCHBUFLENGTH; i++)
 213:common/prog/FuncSafe/fsRam.c ****    {
 214:common/prog/FuncSafe/fsRam.c ****       *q++ = ucPatNoInv;
 215:common/prog/FuncSafe/fsRam.c ****    }
 216:common/prog/FuncSafe/fsRam.c ****    //  - finally restore the original data part
 217:common/prog/FuncSafe/fsRam.c ****    for (i=(uint8_t)0,q = pucDEXBuffer, p = pucRAM; i < (uint8_t)MARCHBUFLENGTH; i++)
 218:common/prog/FuncSafe/fsRam.c ****    {
 219:common/prog/FuncSafe/fsRam.c ****       *p++ = *q++;
 220:common/prog/FuncSafe/fsRam.c ****    }
 221:common/prog/FuncSafe/fsRam.c **** #endif
 222:common/prog/FuncSafe/fsRam.c **** 
