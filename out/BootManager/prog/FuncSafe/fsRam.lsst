 230:common/prog/FuncSafe/fsRam.c **** 
 231:common/prog/FuncSafe/fsRam.c ****    /**
 232:common/prog/FuncSafe/fsRam.c ****     Since the interface below is required to run as fast as possible, it is implemented in pure ASM
 233:common/prog/FuncSafe/fsRam.c ****     For R8C, IAR, this interface convention holds:
 234:common/prog/FuncSafe/fsRam.c ****     ucPatInv            R0H     as unsigned byte
 235:common/prog/FuncSafe/fsRam.c ****     ucPatNo Inv         R0L     as unsigned byte
 236:common/prog/FuncSafe/fsRam.c ****     pucDEXBuffer        R2      as unsigned word (pointer to near data)
 237:common/prog/FuncSafe/fsRam.c ****     pucRAM              A0      as unsigned word (pointer to near data)
 238:common/prog/FuncSafe/fsRam.c ****     */
 239:common/prog/FuncSafe/fsRam.c **** 
 240:common/prog/FuncSafe/fsRam.c **** /*=======================================================
 241:common/prog/FuncSafe/fsRam.c ****     Interface description Hcs12
 242:common/prog/FuncSafe/fsRam.c **** =======================================================*/
 243:common/prog/FuncSafe/fsRam.c **** 
 244:common/prog/FuncSafe/fsRam.c ****    /** For HCS12, METROWERKS, this interface convention holds:
 245:common/prog/FuncSafe/fsRam.c ****     ucPatInv            B       as unsigned byte
 246:common/prog/FuncSafe/fsRam.c ****     ucPatNo Inv         [SP]    as unsigned byte
 247:common/prog/FuncSafe/fsRam.c ****     pucDEXBuffer        [SP+1]  as unsigned word (pointer to near data)
 248:common/prog/FuncSafe/fsRam.c ****     pucRAM
 249:common/prog/FuncSafe/fsRam.c ****    */
 250:common/prog/FuncSafe/fsRam.c **** 
 251:common/prog/FuncSafe/fsRam.c ****    FSF_vRamOpercheck(pucRAM,pucDEXBuffer,ucPatNoInv,ucPatInv);
 252:common/prog/FuncSafe/fsRam.c **** #endif
 253:common/prog/FuncSafe/fsRam.c **** 
 254:common/prog/FuncSafe/fsRam.c **** /*======================================================================
 255:common/prog/FuncSafe/fsRam.c ****     Re-Enable all interrupts
 256:common/prog/FuncSafe/fsRam.c **** ======================================================================*/
 257:common/prog/FuncSafe/fsRam.c **** #ifdef TH_FSCOM
 258:common/prog/FuncSafe/fsRam.c ****    //  Only keep track of enebling
 259:common/prog/FuncSafe/fsRam.c ****    TH_FSFP_PushOutPar(TP_FSF_RAM_INT_Enabled);
 260:common/prog/FuncSafe/fsRam.c **** #else
