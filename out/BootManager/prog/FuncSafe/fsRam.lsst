 269:common/prog/FuncSafe/fsRam.c **** =====================================================================================*/
 270:common/prog/FuncSafe/fsRam.c **** /** RAM Check Ongoing
 271:common/prog/FuncSafe/fsRam.c ****     This function is called if a RAM check cycle is ongoing. \n
 272:common/prog/FuncSafe/fsRam.c **** 
 273:common/prog/FuncSafe/fsRam.c ****     \param      none
 274:common/prog/FuncSafe/fsRam.c ****     \pre        none. \n
 275:common/prog/FuncSafe/fsRam.c **** */
 276:common/prog/FuncSafe/fsRam.c **** STATIC  void    vRAMCheckOngoing     (void)
 277:common/prog/FuncSafe/fsRam.c **** {
 278:common/prog/FuncSafe/fsRam.c **** #ifdef SYSTEMTEST_F15b
 279:common/prog/FuncSafe/fsRam.c ****    //  System Test Case F15b
 280:common/prog/FuncSafe/fsRam.c ****    //  The RAM channel is not ongoing, it remains idle
 281:common/prog/FuncSafe/fsRam.c **** #else
 282:common/prog/FuncSafe/fsRam.c ****    //  Report ongoing RAM check.
 283:common/prog/FuncSafe/fsRam.c ****    FSF_vReportOnGoing((uint8_t)FSF_RAM_TEST);
 284:common/prog/FuncSafe/fsRam.c **** #endif
 285:common/prog/FuncSafe/fsRam.c **** }
 286:common/prog/FuncSafe/fsRam.c **** 
 287:common/prog/FuncSafe/fsRam.c **** /*=====================================================================================
 288:common/prog/FuncSafe/fsRam.c ****     Notify RAM check successfully completed
