  91:common/prog/FuncSafe/fs_psm.c **** #ifdef VARIANT_BOOTMANAGER
  92:common/prog/FuncSafe/fs_psm.c ****   return (((FSF_ui32BMPrgSeqMonVal ^ FSF_ui32BMPrgSeqMonValInv) == UINT32_MAX) ? true : false);
