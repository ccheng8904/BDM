  61:common/prog/FuncSafe/fs_psm.c **** /** \brief    Function for checking of consistency valuse used for Program
  62:common/prog/FuncSafe/fs_psm.c ****  *            Counter Monitoring.
  63:common/prog/FuncSafe/fs_psm.c ****  *
  64:common/prog/FuncSafe/fs_psm.c ****  *  \details  For Program Counter Monitoring are used two variables (normal
  65:common/prog/FuncSafe/fs_psm.c ****  *             and inverted). In this function is checked if this static
  66:common/prog/FuncSafe/fs_psm.c ****  *             variable are consinstent
  67:common/prog/FuncSafe/fs_psm.c ****  *
  68:common/prog/FuncSafe/fs_psm.c ****  *  \param    none: void
  69:common/prog/FuncSafe/fs_psm.c ****  *
  70:common/prog/FuncSafe/fs_psm.c ****  *  \return   bool: true, false
  71:common/prog/FuncSafe/fs_psm.c ****  */
  72:common/prog/FuncSafe/fs_psm.c **** static bool FSF_isPrgSeqMonitorValuesConsistent(void);
  73:common/prog/FuncSafe/fs_psm.c **** 
  74:common/prog/FuncSafe/fs_psm.c **** /** \brief    Function returns Program Counter Monitoring value.
  75:common/prog/FuncSafe/fs_psm.c ****  *
  76:common/prog/FuncSafe/fs_psm.c ****  *  \details  Returns only normal (not inverted) value of variable used
  77:common/prog/FuncSafe/fs_psm.c ****  *            for checking.
  78:common/prog/FuncSafe/fs_psm.c ****  *
  79:common/prog/FuncSafe/fs_psm.c ****  *  \param    none:      void
  80:common/prog/FuncSafe/fs_psm.c ****  *
