 819:app/prog/FuncSafe/fSafeXS.c **** 
 820:app/prog/FuncSafe/fSafeXS.c **** /** While checking the ROM at once, this interface decides if interrupts get
 821:app/prog/FuncSafe/fSafeXS.c ****    maintained or not. This is mainly intended due to performance reasons. While
 822:app/prog/FuncSafe/fSafeXS.c ****    checking the ROM without maintaining the interrupts, some overflow conditions
 823:app/prog/FuncSafe/fSafeXS.c ****    may occurre. Otherwise, maintaining a huge number of interrupt sources is
 824:app/prog/FuncSafe/fSafeXS.c ****    time consuming, hence it will lengthen the whole ROM check time. So, by this
 825:app/prog/FuncSafe/fSafeXS.c ****    interface, the user has the ability to decide whether to maintain the
 826:app/prog/FuncSafe/fSafeXS.c ****    interrupts or not. The ROM channel internally provide this interface and it
 827:app/prog/FuncSafe/fSafeXS.c ****    returns true by default. This interface may be overloaded, if necessary. As
 828:app/prog/FuncSafe/fSafeXS.c ****    an example: if interrupts need to be  maintained at least once every second,
 829:app/prog/FuncSafe/fSafeXS.c ****    and checking the whole ROM space at once takes only half a second, in that
 830:app/prog/FuncSafe/fSafeXS.c ****     case there is no need to maintain the interrupt sources while checking.\n
 831:app/prog/FuncSafe/fSafeXS.c **** 
 832:app/prog/FuncSafe/fSafeXS.c ****     \param      none\n
 833:app/prog/FuncSafe/fSafeXS.c ****     \return     true, if interrupts have to maintain, false otherwise.
 834:app/prog/FuncSafe/fSafeXS.c **** 
 835:app/prog/FuncSafe/fSafeXS.c ****     \pre        Called only at operational time.\n
 836:app/prog/FuncSafe/fSafeXS.c **** 
 837:app/prog/FuncSafe/fSafeXS.c ****     \note       Overloading is not designed here, as this is up to an
 838:app/prog/FuncSafe/fSafeXS.c ****    application. \n
 839:app/prog/FuncSafe/fSafeXS.c **** */
 840:app/prog/FuncSafe/fSafeXS.c **** bool _FSF_bCheckINTduringROMCheck(void)
 841:app/prog/FuncSafe/fSafeXS.c **** {
 842:app/prog/FuncSafe/fSafeXS.c ****     return true;
 843:app/prog/FuncSafe/fSafeXS.c **** }
 844:app/prog/FuncSafe/fSafeXS.c **** 
 845:app/prog/FuncSafe/fSafeXS.c **** /**
 846:app/prog/FuncSafe/fSafeXS.c **** Some little configuration helpers
 847:app/prog/FuncSafe/fSafeXS.c **** */
