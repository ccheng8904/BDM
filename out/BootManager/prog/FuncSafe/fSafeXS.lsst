1000:app/prog/FuncSafe/fSafeXS.c **** #ifdef FSF_CRC_32_BIT
1001:app/prog/FuncSafe/fSafeXS.c **** /** Calculate a CRC-32 value over a data range.
1002:app/prog/FuncSafe/fSafeXS.c **** 
1003:app/prog/FuncSafe/fSafeXS.c ****     \param      CRC32Value  current CRC-16 value \n
1004:app/prog/FuncSafe/fSafeXS.c ****     \param      pData       data address where to start calculation \n
1005:app/prog/FuncSafe/fSafeXS.c ****     \param      ui16length  length of data to calculate \n\n
1006:app/prog/FuncSafe/fSafeXS.c **** 
1007:app/prog/FuncSafe/fSafeXS.c ****     \return     uint16_t  newly calculated value.\n\n
1008:app/prog/FuncSafe/fSafeXS.c **** 
1009:app/prog/FuncSafe/fSafeXS.c ****     \pre        Called only at operational time. \n
1010:app/prog/FuncSafe/fSafeXS.c ****     \post       ROM channel work area left unchanged \n
1011:app/prog/FuncSafe/fSafeXS.c **** 
1012:app/prog/FuncSafe/fSafeXS.c ****     \note       This calculator is only allowed to call for ROM parts that are
1013:app/prog/FuncSafe/fSafeXS.c ****    ready for access. \n
1014:app/prog/FuncSafe/fSafeXS.c **** */
1015:app/prog/FuncSafe/fSafeXS.c **** uint32_t uiCalculateCRC32(uint32_t CRC32Value,
1016:app/prog/FuncSafe/fSafeXS.c ****                           FSTH_CONST uint32_t *pData,
1017:app/prog/FuncSafe/fSafeXS.c ****                           uint16_t ui16length)
1018:app/prog/FuncSafe/fSafeXS.c **** {
1019:app/prog/FuncSafe/fSafeXS.c **** #ifdef FSF_SW_CRC
1020:app/prog/FuncSafe/fSafeXS.c ****     uint8_t temp;
1021:app/prog/FuncSafe/fSafeXS.c ****     uint8_t *p_temp_data = (uint8_t *)pData;
1022:app/prog/FuncSafe/fSafeXS.c ****     uint32_t crc = CRC32Value;
1023:app/prog/FuncSafe/fSafeXS.c ****     uint32_t Size = (uint32_t)(ui16length * sizeof(uint32_t));
1024:app/prog/FuncSafe/fSafeXS.c **** 
1025:app/prog/FuncSafe/fSafeXS.c ****     while (Size--) {
1026:app/prog/FuncSafe/fSafeXS.c ****         temp = (crc >> 24);
1027:app/prog/FuncSafe/fSafeXS.c ****         crc = (crc << 8) ^ CRCTable[temp ^ *p_temp_data];
1028:app/prog/FuncSafe/fSafeXS.c ****         p_temp_data++;
1029:app/prog/FuncSafe/fSafeXS.c ****     }
1030:app/prog/FuncSafe/fSafeXS.c ****     return crc;
1031:app/prog/FuncSafe/fSafeXS.c **** #else
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccVk4ZuO.s 			page 21


1032:app/prog/FuncSafe/fSafeXS.c ****     return (CRC_Ethernet_Update(CRC32Value,
1033:app/prog/FuncSafe/fSafeXS.c ****                                 (uint32_t)(ui16length * sizeof(uint32_t)),
1034:app/prog/FuncSafe/fSafeXS.c ****                                 (const uint8_t *)pData));  //lint !e928 cast tested to work correct
1035:app/prog/FuncSafe/fSafeXS.c **** #endif  // FSF_SW_CRC
1036:app/prog/FuncSafe/fSafeXS.c **** }
1037:app/prog/FuncSafe/fSafeXS.c **** 
1038:app/prog/FuncSafe/fSafeXS.c **** #else
1039:app/prog/FuncSafe/fSafeXS.c **** 
1040:app/prog/FuncSafe/fSafeXS.c **** /** Calculate a CRC-16 value over a data range.
1041:app/prog/FuncSafe/fSafeXS.c **** 
1042:app/prog/FuncSafe/fSafeXS.c ****     \param      CRC16Value  current CRC-16 value \n
1043:app/prog/FuncSafe/fSafeXS.c ****     \param      pData       data address where to start calculation \n
1044:app/prog/FuncSafe/fSafeXS.c ****     \param      ui16length  length of data to calculate \n\n
1045:app/prog/FuncSafe/fSafeXS.c **** 
1046:app/prog/FuncSafe/fSafeXS.c ****     \return     uint16_t    newly calculated value.\n\n
1047:app/prog/FuncSafe/fSafeXS.c **** 
1048:app/prog/FuncSafe/fSafeXS.c ****     \pre        Called only at operational time. \n
1049:app/prog/FuncSafe/fSafeXS.c ****     \post       ROM channel work area left unchanged \n
1050:app/prog/FuncSafe/fSafeXS.c **** 
1051:app/prog/FuncSafe/fSafeXS.c ****     \note       This calculator is only allowed to call for ROM parts that are
1052:app/prog/FuncSafe/fSafeXS.c ****    ready for access. \n
1053:app/prog/FuncSafe/fSafeXS.c **** */
1054:app/prog/FuncSafe/fSafeXS.c **** uint16_t uiCalculateCRC(uint16_t CRC16Value, FSTH_CONST uint8_t *pData,
1055:app/prog/FuncSafe/fSafeXS.c ****                         uint16_t ui16length)
1056:app/prog/FuncSafe/fSafeXS.c **** {
1057:app/prog/FuncSafe/fSafeXS.c ****     uint8_t tmp, locrc, hicrc;
1058:app/prog/FuncSafe/fSafeXS.c ****     while (ui16length != (uint16_t)0) {
1059:app/prog/FuncSafe/fSafeXS.c ****         hicrc = (uint8_t)CRC16Value;
1060:app/prog/FuncSafe/fSafeXS.c ****         locrc = (uint8_t)(CRC16Value >> 8);
1061:app/prog/FuncSafe/fSafeXS.c ****         tmp = locrc ^= *pData;
1062:app/prog/FuncSafe/fSafeXS.c ****         //  Msg(2:0506) Dereferencing pointer value that is possibly NULL.
1063:app/prog/FuncSafe/fSafeXS.c ****         //  REFERENCE - ISO-6.3.3.2 Semantics
1064:app/prog/FuncSafe/fSafeXS.c ****         //  PCA comment: code tested and reviewed to work correctly. Thus, left
1065:app/prog/FuncSafe/fSafeXS.c ****         //  unchanged.
1066:app/prog/FuncSafe/fSafeXS.c ****         pData++;
1067:app/prog/FuncSafe/fSafeXS.c ****         //  Msg(4:0489) Increment or decrement operation performed on pointer.
1068:app/prog/FuncSafe/fSafeXS.c ****         //  MISRA-C:2004 Rule 17.4 <next>
1069:app/prog/FuncSafe/fSafeXS.c ****         //  PCA comment: code tested and reviewed to work correctly. Thus, left
1070:app/prog/FuncSafe/fSafeXS.c ****         //  unchanged.
1071:app/prog/FuncSafe/fSafeXS.c **** 
1072:app/prog/FuncSafe/fSafeXS.c ****         ui16length--;
1073:app/prog/FuncSafe/fSafeXS.c **** 
1074:app/prog/FuncSafe/fSafeXS.c ****         locrc ^= (tmp >> 4);
1075:app/prog/FuncSafe/fSafeXS.c ****         hicrc ^= (locrc << 4);
1076:app/prog/FuncSafe/fSafeXS.c ****         hicrc ^= (locrc >> 3);
1077:app/prog/FuncSafe/fSafeXS.c ****         locrc ^= (locrc << 5);
1078:app/prog/FuncSafe/fSafeXS.c **** 
1079:app/prog/FuncSafe/fSafeXS.c ****         CRC16Value = (((uint16_t)hicrc) << 8) | locrc;
1080:app/prog/FuncSafe/fSafeXS.c ****     }
1081:app/prog/FuncSafe/fSafeXS.c ****     return CRC16Value;
1082:app/prog/FuncSafe/fSafeXS.c **** }
1083:app/prog/FuncSafe/fSafeXS.c **** 
1084:app/prog/FuncSafe/fSafeXS.c **** #endif
1085:app/prog/FuncSafe/fSafeXS.c **** 
1086:app/prog/FuncSafe/fSafeXS.c **** uint32_t _FSF_ui32ResetCrcCalculation(void) 
