 491:app/prog/FuncSafe/fSafeXS.c ****    initialised.\n
 492:app/prog/FuncSafe/fSafeXS.c **** 
 493:app/prog/FuncSafe/fSafeXS.c ****     \note       to be overloaded according to a project specific needs
 494:app/prog/FuncSafe/fSafeXS.c **** */
 495:app/prog/FuncSafe/fSafeXS.c **** void _FSF_vApplicationStartUp(void)
 496:app/prog/FuncSafe/fSafeXS.c **** {
 497:app/prog/FuncSafe/fSafeXS.c **** 
 498:app/prog/FuncSafe/fSafeXS.c **** }
 499:app/prog/FuncSafe/fSafeXS.c **** 
 500:app/prog/FuncSafe/fSafeXS.c **** /**
 501:app/prog/FuncSafe/fSafeXS.c ****    Return the actual stack pointer
 502:app/prog/FuncSafe/fSafeXS.c **** <pre>
 503:app/prog/FuncSafe/fSafeXS.c ****    --------------------------------------------------------------------------
 504:app/prog/FuncSafe/fSafeXS.c ****    This stack channel requires local variables to be placed on the hardware
 505:app/prog/FuncSafe/fSafeXS.c ****    stack. For the time being, the so called "compiled stack" is not supported
 506:app/prog/FuncSafe/fSafeXS.c ****    --------------------------------------------------------------------------
 507:app/prog/FuncSafe/fSafeXS.c **** </pre>
 508:app/prog/FuncSafe/fSafeXS.c ****     This observer returns the actual position of the stack pointer. Performing
 509:app/prog/FuncSafe/fSafeXS.c **** certain tasks in order to manipulate the stack pointer for test would result
 510:app/prog/FuncSafe/fSafeXS.c **** into more or less non-portable solutions, especially when testing the same piece
 511:app/prog/FuncSafe/fSafeXS.c **** of code and for different environments. Thus, for test harness purposes this
 512:app/prog/FuncSafe/fSafeXS.c **** value can be read from a reserved location.
 513:app/prog/FuncSafe/fSafeXS.c **** 
 514:app/prog/FuncSafe/fSafeXS.c ****     To be noticed: due to the preconditions above, only the address of an
 515:app/prog/FuncSafe/fSafeXS.c **** stack-located variable is returned. Its physical location will be some bytes
 516:app/prog/FuncSafe/fSafeXS.c **** deeper inside the stack, as it is placed within the new stack frame of the
 517:app/prog/FuncSafe/fSafeXS.c **** called observer. Re-alignment is not done, as this would involve some porting
 518:app/prog/FuncSafe/fSafeXS.c **** problems due to different stack frame structures.
 519:app/prog/FuncSafe/fSafeXS.c **** 
 520:app/prog/FuncSafe/fSafeXS.c ****     \param    index of stack to be considered
 521:app/prog/FuncSafe/fSafeXS.c ****     \return   actual location of the stack pointer
 522:app/prog/FuncSafe/fSafeXS.c ****     \pre      Location and size of the stack provided correctly.
 523:app/prog/FuncSafe/fSafeXS.c ****     \post     Magic numbers written correctly. Current stack pointer content
 524:app/prog/FuncSafe/fSafeXS.c **** checked correctly. \remark   Probably, some CPU architectures or compilers do
 525:app/prog/FuncSafe/fSafeXS.c **** not allow the default implementation below or do not provide direct access to the
 526:app/prog/FuncSafe/fSafeXS.c **** stack. For those, an asm implementation may solve the problem.
 527:app/prog/FuncSafe/fSafeXS.c **** */
 528:app/prog/FuncSafe/fSafeXS.c **** uint8_t *_FSF_pucGetStackPointer(void)
 529:app/prog/FuncSafe/fSafeXS.c **** {
 530:app/prog/FuncSafe/fSafeXS.c ****     return (uint8_t *)(__get_MSP());
 531:app/prog/FuncSafe/fSafeXS.c **** }
 532:app/prog/FuncSafe/fSafeXS.c **** 
 533:app/prog/FuncSafe/fSafeXS.c **** #ifndef TH_FSCOM
 534:app/prog/FuncSafe/fSafeXS.c **** /* uint8_t     _FSF_ucGetStackCount(void);
 535:app/prog/FuncSafe/fSafeXS.c ****   Return 2 stacks available for this multiple stack configuration
 536:app/prog/FuncSafe/fSafeXS.c **** */
 537:app/prog/FuncSafe/fSafeXS.c **** uint8_t _FSF_ucGetStackCount(void)
 538:app/prog/FuncSafe/fSafeXS.c **** {
 539:app/prog/FuncSafe/fSafeXS.c ****     return NUMBER_OF_STACKS;
 540:app/prog/FuncSafe/fSafeXS.c **** }
 541:app/prog/FuncSafe/fSafeXS.c **** #endif
 542:app/prog/FuncSafe/fSafeXS.c **** 
