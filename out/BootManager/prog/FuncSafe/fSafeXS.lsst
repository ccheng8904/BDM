 696:app/prog/FuncSafe/fSafeXS.c **** */
 697:app/prog/FuncSafe/fSafeXS.c **** bool _FSF_bReadExtWatchdog(void) 
 698:app/prog/FuncSafe/fSafeXS.c **** {
