 852:app/prog/FuncSafe/fSafeXS.c ****     /* Memorize the entry timestamp and count the frequency */
 853:app/prog/FuncSafe/fSafeXS.c ****     atIsrLongConfig[ucIsrId].uiIEntry = (uint16_t)(TIM_uiGetCircleMicroSeconds());
 854:app/prog/FuncSafe/fSafeXS.c ****     atIsrLongConfig[ucIsrId].uiICount++;
 855:app/prog/FuncSafe/fSafeXS.c **** #endif
