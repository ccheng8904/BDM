 166:app/prog/FuncSafe/fSafeXS.c **** 
 167:app/prog/FuncSafe/fSafeXS.c **** /** The FSCOM Default Channel configuration
 168:app/prog/FuncSafe/fSafeXS.c ****  *  This channel is provided in order to save space. Some channels will have only
 169:app/prog/FuncSafe/fSafeXS.c ****  *  one task function scheduled regularly. Hence, such channels may use the default
 170:app/prog/FuncSafe/fSafeXS.c ****  *  channels so that no space is wasted.
 171:app/prog/FuncSafe/fSafeXS.c ****  */
 172:app/prog/FuncSafe/fSafeXS.c **** FSTH_CONST T_FSCOM_Channel FSF_sDefaultChannel = // No check cycle supervision
 173:app/prog/FuncSafe/fSafeXS.c **** {
 174:app/prog/FuncSafe/fSafeXS.c ****     { 0u, 0u },                    // No cycle multiplier
 175:app/prog/FuncSafe/fSafeXS.c ****     false,                         // Is scheduled regularly?
 176:app/prog/FuncSafe/fSafeXS.c ****     _FSF_bDefaultPreconditionTRUE, // No pre-condition
 177:app/prog/FuncSafe/fSafeXS.c ****     _FSF_vDefaultOneTimeCheck      // No one-time check
 178:app/prog/FuncSafe/fSafeXS.c **** };
 179:app/prog/FuncSafe/fSafeXS.c **** 
 180:app/prog/FuncSafe/fSafeXS.c **** /** The Default RAM Channel checker. This allows to test the functional safety
 181:app/prog/FuncSafe/fSafeXS.c ****  *  generic moodule independently of a specific type of controller
 182:app/prog/FuncSafe/fSafeXS.c ****  */
 183:app/prog/FuncSafe/fSafeXS.c **** 
 184:app/prog/FuncSafe/fSafeXS.c **** /** The RAM Channel configuration */
 185:app/prog/FuncSafe/fSafeXS.c **** FSTH_CONST T_FSCOM_Channel FSF_sRAMChannel = 
 186:app/prog/FuncSafe/fSafeXS.c **** {
 187:app/prog/FuncSafe/fSafeXS.c **** #ifdef OPERATIONAL_RAM_CHECK       // Yes, check cycle supervision
 188:app/prog/FuncSafe/fSafeXS.c ****     { RAM_CYCLE_CHECK_TIME, 0u},   // The cycle multiplier
 189:app/prog/FuncSafe/fSafeXS.c ****     true,                          // Is scheduled regularly?
 190:app/prog/FuncSafe/fSafeXS.c **** #else
 191:app/prog/FuncSafe/fSafeXS.c ****     { 0u, 0u },                    // No cycle multiplier
 192:app/prog/FuncSafe/fSafeXS.c ****     false,                         // Is scheduled regularly?
 193:app/prog/FuncSafe/fSafeXS.c **** #endif
 194:app/prog/FuncSafe/fSafeXS.c ****     _FSF_bDefaultPreconditionTRUE, // No pre-condition
 195:app/prog/FuncSafe/fSafeXS.c **** 
 196:app/prog/FuncSafe/fSafeXS.c **** #if defined(REMOTE_FIRMWARE_UPDATE) || defined(TH_FSCOM)
 197:app/prog/FuncSafe/fSafeXS.c ****     _FSF_vDefaultOneTimeCheck,     // one-time check moved to BootManager
 198:app/prog/FuncSafe/fSafeXS.c **** #else
 199:app/prog/FuncSafe/fSafeXS.c ****     FSF_vRam_OneTimeCheck          // The RAM one-time check
 200:app/prog/FuncSafe/fSafeXS.c **** #endif
 201:app/prog/FuncSafe/fSafeXS.c **** };
 202:app/prog/FuncSafe/fSafeXS.c **** 
