 835:common/prog/FuncSafe/fsCom.c **** STATIC  void    vMemorizeTimingValue(uint16_t uiTimVal)
 836:common/prog/FuncSafe/fsCom.c **** {
 837:common/prog/FuncSafe/fsCom.c ****    uint16_t uiDiff = (uint16_t)(uiTimVal - uiStoredVal);
 838:common/prog/FuncSafe/fsCom.c ****    uiStoredVal = uiTimVal;
 839:common/prog/FuncSafe/fsCom.c ****    if (uiDiff < uiMinVal)
