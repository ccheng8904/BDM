 751:common/prog/FuncSafe/fsCom.c ****     \param      ucCheckId channel identifier
 752:common/prog/FuncSafe/fsCom.c ****     \return     uint8_t     IDLE or ONGOING or SUCCESS\n
 753:common/prog/FuncSafe/fsCom.c ****     \pre        FSCOM initialised\n
