 850:common/prog/FuncSafe/fsCom.c **** /** Handle the per-scheduling state.
 851:common/prog/FuncSafe/fsCom.c ****    Pass a number of scheduling cycles before normal operation.
 852:common/prog/FuncSafe/fsCom.c ****    \return     uint8_t\n   FSF_STATE_PRESCHEDULED when counting scheduling cycles\n
 853:common/prog/FuncSafe/fsCom.c ****                          FSF_STATE_STARTED      otherwise\n
 854:common/prog/FuncSafe/fsCom.c **** 
 855:common/prog/FuncSafe/fsCom.c ****     \pre        FSCOM runs in its boot state\n
 856:common/prog/FuncSafe/fsCom.c ****     \post       The internal/external watchdogs not serviced.
 857:common/prog/FuncSafe/fsCom.c **** */
 858:common/prog/FuncSafe/fsCom.c **** STATIC  uint8_t   ucHandlePreScheduling(void)
 859:common/prog/FuncSafe/fsCom.c **** {
 860:common/prog/FuncSafe/fsCom.c ****    uint8_t   retval = (uint8_t)FSF_STATE_PRESCHEDULED;
 861:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
 862:common/prog/FuncSafe/fsCom.c ****    TH_FSFP_PushOutPar((uint8_t)TP_FSF_ucHandlePreScheduling);
 863:common/prog/FuncSafe/fsCom.c **** #endif
 864:common/prog/FuncSafe/fsCom.c ****    if (ucPreSchedulingCtr > FSF_ucPreSchedCycles)
 865:common/prog/FuncSafe/fsCom.c ****    {
 866:common/prog/FuncSafe/fsCom.c ****       // Notify a boot failure
 867:common/prog/FuncSafe/fsCom.c ****       //vExtApplicationErrorNotify(uint8_t ucSubCheckId, uint8_t ucChannelId, uint8_t ucUserPar)
 868:common/prog/FuncSafe/fsCom.c ****       vExtApplicationErrorNotify((uint8_t)FSF_ERR_BOOT_FAILURE, (uint8_t)FSF_NOT_SPECIFIED_CHANNEL,
 869:common/prog/FuncSafe/fsCom.c ****       // If the application does not break off operation, reduce the variable to what
 870:common/prog/FuncSafe/fsCom.c ****       // is configured
 871:common/prog/FuncSafe/fsCom.c ****       ucPreSchedulingCtr = FSF_ucPreSchedCycles;
 872:common/prog/FuncSafe/fsCom.c **** 
 873:common/prog/FuncSafe/fsCom.c ****    }
 874:common/prog/FuncSafe/fsCom.c ****    if ((ucPreSchedulingCtr > (uint8_t)0) && (ucPreSchedulingCtr <= FSF_ucPreSchedCycles))
 875:common/prog/FuncSafe/fsCom.c ****    {
 876:common/prog/FuncSafe/fsCom.c ****       ucPreSchedulingCtr--;
 877:common/prog/FuncSafe/fsCom.c ****    }
 878:common/prog/FuncSafe/fsCom.c ****    else
 879:common/prog/FuncSafe/fsCom.c ****    {
 880:common/prog/FuncSafe/fsCom.c ****       FSF_ui16LastWDTrigger = TIM_uiGetCircleMicroSeconds();
 881:common/prog/FuncSafe/fsCom.c ****       retval = (uint8_t)FSF_STATE_STARTED;
 882:common/prog/FuncSafe/fsCom.c ****    }
 883:common/prog/FuncSafe/fsCom.c **** 
 884:common/prog/FuncSafe/fsCom.c ****    return retval;
 885:common/prog/FuncSafe/fsCom.c **** }
 886:common/prog/FuncSafe/fsCom.c **** 
 887:common/prog/FuncSafe/fsCom.c **** /** Schedule FSCOM.
 888:common/prog/FuncSafe/fsCom.c ****    By this handler, FSCOM is scheduled on a regular base.
 889:common/prog/FuncSafe/fsCom.c **** 
 890:common/prog/FuncSafe/fsCom.c ****     \param      ucChannelId   channel identifier
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 18


 891:common/prog/FuncSafe/fsCom.c ****     \return     uint8_t\n   TASK_NOT_INITIALISED:   channel monitoring not started yet\n
 892:common/prog/FuncSafe/fsCom.c ****                           TASK_INITIALISED:       channel monitoring cycle completed\n
 893:common/prog/FuncSafe/fsCom.c ****                           TASK_TERMINATE:         channel exception occurred\n
 894:common/prog/FuncSafe/fsCom.c **** 
 895:common/prog/FuncSafe/fsCom.c ****     \pre        FSCOM runs in its operational state\n
 896:common/prog/FuncSafe/fsCom.c ****     \post       All configured channels checked. The external watchdog serviced correctly.
 897:common/prog/FuncSafe/fsCom.c **** */
 898:common/prog/FuncSafe/fsCom.c **** /*-----------------------------------------------------------------------
 899:common/prog/FuncSafe/fsCom.c ****   Control Flow:
 900:common/prog/FuncSafe/fsCom.c ****   Begin
 901:common/prog/FuncSafe/fsCom.c ****       if Test connected to FSCOM then
 902:common/prog/FuncSafe/fsCom.c **** 
 903:common/prog/FuncSafe/fsCom.c ****           call the test server to perform one test step
 904:common/prog/FuncSafe/fsCom.c ****           return TASK_NOT_INITIALISED to the scheduler
 905:common/prog/FuncSafe/fsCom.c **** 
 906:common/prog/FuncSafe/fsCom.c ****       else
 907:common/prog/FuncSafe/fsCom.c **** 
 908:common/prog/FuncSafe/fsCom.c **** 
 909:common/prog/FuncSafe/fsCom.c ****           select FSCOM state
 910:common/prog/FuncSafe/fsCom.c **** 
 911:common/prog/FuncSafe/fsCom.c ****           Begin
 912:common/prog/FuncSafe/fsCom.c **** 
 913:common/prog/FuncSafe/fsCom.c ****               case BOOTED
 914:common/prog/FuncSafe/fsCom.c **** 
 915:common/prog/FuncSafe/fsCom.c ****                   initialise all channel states,
 916:common/prog/FuncSafe/fsCom.c ****                   determine the next FSCOM state
 917:common/prog/FuncSafe/fsCom.c ****                   and set up the return code
 918:common/prog/FuncSafe/fsCom.c **** 
 919:common/prog/FuncSafe/fsCom.c ****               esac
 920:common/prog/FuncSafe/fsCom.c **** 
 921:common/prog/FuncSafe/fsCom.c ****               case PRESCHEDULED
 922:common/prog/FuncSafe/fsCom.c **** 
 923:common/prog/FuncSafe/fsCom.c ****                   count down the number of pre-scheduling cycles
 924:common/prog/FuncSafe/fsCom.c ****                   this is required in order to get the system tuned stable
 925:common/prog/FuncSafe/fsCom.c ****                   determine the next FSCOM state
 926:common/prog/FuncSafe/fsCom.c ****                   and set up the return code
 927:common/prog/FuncSafe/fsCom.c **** 
 928:common/prog/FuncSafe/fsCom.c ****               case STARTED
 929:common/prog/FuncSafe/fsCom.c **** 
 930:common/prog/FuncSafe/fsCom.c ****                   manage the actual channel state
 931:common/prog/FuncSafe/fsCom.c ****                   and set up the return code
 932:common/prog/FuncSafe/fsCom.c **** 
 933:common/prog/FuncSafe/fsCom.c ****               esac
 934:common/prog/FuncSafe/fsCom.c **** 
 935:common/prog/FuncSafe/fsCom.c ****               otherwise
 936:common/prog/FuncSafe/fsCom.c **** 
 937:common/prog/FuncSafe/fsCom.c ****                   create a fatal exception
 938:common/prog/FuncSafe/fsCom.c ****                   set the return code to TASK_TERMINATE
 939:common/prog/FuncSafe/fsCom.c **** 
 940:common/prog/FuncSafe/fsCom.c ****           End
 941:common/prog/FuncSafe/fsCom.c **** 
 942:common/prog/FuncSafe/fsCom.c ****       End
 943:common/prog/FuncSafe/fsCom.c **** 
 944:common/prog/FuncSafe/fsCom.c ****       with the retrun code, return control to the scheduler;
 945:common/prog/FuncSafe/fsCom.c **** 
 946:common/prog/FuncSafe/fsCom.c ****   End
 947:common/prog/FuncSafe/fsCom.c **** -------------------------------------------------------------------------*/
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 19


 948:common/prog/FuncSafe/fsCom.c **** //  The real task handler
 949:common/prog/FuncSafe/fsCom.c **** STATIC  uint8_t ucComHandleTask(uint8_t ucChannelId)
 950:common/prog/FuncSafe/fsCom.c **** {
 951:common/prog/FuncSafe/fsCom.c ****    uint8_t   retval      = (uint8_t)TASK_TERMINATE;
 952:common/prog/FuncSafe/fsCom.c ****    uint8_t   nextState;
 953:common/prog/FuncSafe/fsCom.c ****    switch (ucGetFSCOM_State())
 954:common/prog/FuncSafe/fsCom.c ****    {
 955:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_STATE_BOOTED:
 956:common/prog/FuncSafe/fsCom.c ****       {
 957:common/prog/FuncSafe/fsCom.c ****          nextState = ucMonitoringStart();
 958:common/prog/FuncSafe/fsCom.c ****          vSetFSCOM_State(nextState);
 959:common/prog/FuncSafe/fsCom.c ****          retval = (uint8_t)TASK_NOT_INITIALISED;
 960:common/prog/FuncSafe/fsCom.c ****          break;
 961:common/prog/FuncSafe/fsCom.c ****       }
 962:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_STATE_PRESCHEDULED:
 963:common/prog/FuncSafe/fsCom.c ****       {
 964:common/prog/FuncSafe/fsCom.c ****          nextState = ucHandlePreScheduling();
 965:common/prog/FuncSafe/fsCom.c ****          vSetFSCOM_State(nextState);
 966:common/prog/FuncSafe/fsCom.c ****          if (nextState == (uint8_t)FSF_STATE_STARTED)
 967:common/prog/FuncSafe/fsCom.c ****          {
 968:common/prog/FuncSafe/fsCom.c ****             retval = (uint8_t)TASK_INITIALISED;
 969:common/prog/FuncSafe/fsCom.c ****          }
 970:common/prog/FuncSafe/fsCom.c ****          else
 971:common/prog/FuncSafe/fsCom.c ****          {
 972:common/prog/FuncSafe/fsCom.c ****             retval = (uint8_t)TASK_NOT_INITIALISED;
 973:common/prog/FuncSafe/fsCom.c ****          }
 974:common/prog/FuncSafe/fsCom.c ****          break;
 975:common/prog/FuncSafe/fsCom.c ****       }
 976:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_STATE_STARTED:
 977:common/prog/FuncSafe/fsCom.c ****       {
 978:common/prog/FuncSafe/fsCom.c ****          retval = ucNewMonitorCycle(ucChannelId);
 979:common/prog/FuncSafe/fsCom.c ****          break;
 980:common/prog/FuncSafe/fsCom.c ****       }
 981:common/prog/FuncSafe/fsCom.c ****       default:
 982:common/prog/FuncSafe/fsCom.c ****       {
 983:common/prog/FuncSafe/fsCom.c ****          // No other operating state allowed for FSCOM
 984:common/prog/FuncSafe/fsCom.c ****          vExtApplicationErrorNotify((uint8_t)FSF_ERR_INVALID_STATE, (uint8_t)FSF_NOT_SPECIFIED_CHAN
 985:common/prog/FuncSafe/fsCom.c ****          break;
 986:common/prog/FuncSafe/fsCom.c ****       }
 987:common/prog/FuncSafe/fsCom.c ****    }
 988:common/prog/FuncSafe/fsCom.c **** 
 989:common/prog/FuncSafe/fsCom.c ****    return retval;
 990:common/prog/FuncSafe/fsCom.c **** }
 991:common/prog/FuncSafe/fsCom.c **** 
