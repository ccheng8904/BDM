1548:common/prog/FuncSafe/fsCom.c **** /*======================================================================
1549:common/prog/FuncSafe/fsCom.c ****     Schedule the generic
1550:common/prog/FuncSafe/fsCom.c **** ======================================================================*/
1551:common/prog/FuncSafe/fsCom.c **** #ifndef TH_FSCOM
1552:common/prog/FuncSafe/fsCom.c ****    return ucHandleTask();
1553:common/prog/FuncSafe/fsCom.c **** #endif
1554:common/prog/FuncSafe/fsCom.c **** }
