1205:common/prog/FuncSafe/fsCom.c **** /* FSCOM OPERATIONAL FUNCTIONS
1206:common/prog/FuncSafe/fsCom.c **** **************************************************************************************/
1207:common/prog/FuncSafe/fsCom.c **** 
1208:common/prog/FuncSafe/fsCom.c **** //@{\name FSCOM exported operational services
1209:common/prog/FuncSafe/fsCom.c **** 
1210:common/prog/FuncSafe/fsCom.c **** /** Report ongoing check to FSCOM.
1211:common/prog/FuncSafe/fsCom.c ****     When a channel starts checking this event is immediately reported to FSCOM. Each
1212:common/prog/FuncSafe/fsCom.c ****     time the channel is processing it will report ongoing or success to FSCOM. If a
1213:common/prog/FuncSafe/fsCom.c ****     channel does not report ongoing (or success), it is assumed not to work correctly.
1214:common/prog/FuncSafe/fsCom.c ****     FSCOM keeps a flag for each channel. For ease of implementation it is recommended
1215:common/prog/FuncSafe/fsCom.c ****     to set the ongoing flag also when reporting success (done directly by the report
1216:common/prog/FuncSafe/fsCom.c ****     success service).
1217:common/prog/FuncSafe/fsCom.c ****     \param  ucCheckId  identifier of the the addressed channel\n
1218:common/prog/FuncSafe/fsCom.c **** 
1219:common/prog/FuncSafe/fsCom.c ****     \pre    FSCOM initialised correctly. Channel identifier within the correct range.\n
1220:common/prog/FuncSafe/fsCom.c ****     \post   For valid channels, internal state transitions, if any, have been completed.
1221:common/prog/FuncSafe/fsCom.c ****             Invalid channel addressing immediately results into the safe state as this
1222:common/prog/FuncSafe/fsCom.c ****             is not allowed to occur.\n
1223:common/prog/FuncSafe/fsCom.c **** */
1224:common/prog/FuncSafe/fsCom.c **** /*-----------------------------------------------------------------------
1225:common/prog/FuncSafe/fsCom.c ****   Control Flow:
1226:common/prog/FuncSafe/fsCom.c ****   Begin
1227:common/prog/FuncSafe/fsCom.c **** 
1228:common/prog/FuncSafe/fsCom.c ****       transition from state IDLE into state ONGOING requires the pre-condition to be checked
1229:common/prog/FuncSafe/fsCom.c **** 
1230:common/prog/FuncSafe/fsCom.c ****       if the channel state is IDLE then
1231:common/prog/FuncSafe/fsCom.c **** 
1232:common/prog/FuncSafe/fsCom.c ****           check the pre-condition
1233:common/prog/FuncSafe/fsCom.c **** 
1234:common/prog/FuncSafe/fsCom.c ****           if this pre-condition returned false then
1235:common/prog/FuncSafe/fsCom.c **** 
1236:common/prog/FuncSafe/fsCom.c ****               inform the application by FSF_ERR_PRECONDITION_FALSE
1237:common/prog/FuncSafe/fsCom.c **** 
1238:common/prog/FuncSafe/fsCom.c ****           fi
1239:common/prog/FuncSafe/fsCom.c **** 
1240:common/prog/FuncSafe/fsCom.c ****       fi
1241:common/prog/FuncSafe/fsCom.c **** 
1242:common/prog/FuncSafe/fsCom.c ****       move the channel into the state ONGOING;
1243:common/prog/FuncSafe/fsCom.c **** 
1244:common/prog/FuncSafe/fsCom.c ****   End
1245:common/prog/FuncSafe/fsCom.c **** -------------------------------------------------------------------------*/
1246:common/prog/FuncSafe/fsCom.c **** void FSF_vReportOnGoing(uint8_t ucCheckId)
1247:common/prog/FuncSafe/fsCom.c **** {
1248:common/prog/FuncSafe/fsCom.c ****    uint8_t cstate = ucGetChannelState(ucCheckId);
1249:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
1250:common/prog/FuncSafe/fsCom.c ****    //  Do not service channels outside FSCOM
1251:common/prog/FuncSafe/fsCom.c ****    if (ucCheckId >= (uint8_t)FSF_APP_CHANNEL_0)
1252:common/prog/FuncSafe/fsCom.c ****    {
1253:common/prog/FuncSafe/fsCom.c ****       return;
1254:common/prog/FuncSafe/fsCom.c ****    }
1255:common/prog/FuncSafe/fsCom.c **** #endif
1256:common/prog/FuncSafe/fsCom.c ****    switch (cstate)
1257:common/prog/FuncSafe/fsCom.c ****    {
1258:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_CH_STATE_IDLE:
1259:common/prog/FuncSafe/fsCom.c ****       {
1260:common/prog/FuncSafe/fsCom.c ****          if ((* FSF_psChannelTab[ucCheckId]).FSF_pbPrecondition() == false)
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 35


1261:common/prog/FuncSafe/fsCom.c ****          {
1262:common/prog/FuncSafe/fsCom.c ****             vExtApplicationErrorNotify((uint8_t)FSF_ERR_PRECONDITION_FALSE,ucCheckId,(uint8_t)0);
1263:common/prog/FuncSafe/fsCom.c ****          }
1264:common/prog/FuncSafe/fsCom.c ****          break;
1265:common/prog/FuncSafe/fsCom.c ****       }
1266:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_CH_STATE_SUCCESS:
1267:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_CH_STATE_ONGOING:
1268:common/prog/FuncSafe/fsCom.c ****       {
1269:common/prog/FuncSafe/fsCom.c ****          break;
1270:common/prog/FuncSafe/fsCom.c ****       }
1271:common/prog/FuncSafe/fsCom.c ****       default:
1272:common/prog/FuncSafe/fsCom.c ****       {
1273:common/prog/FuncSafe/fsCom.c ****          vExtApplicationErrorNotify((uint8_t)FSF_ERR_INVALID_STATE,ucCheckId,(uint8_t)0);
1274:common/prog/FuncSafe/fsCom.c ****          break;
1275:common/prog/FuncSafe/fsCom.c ****       }
1276:common/prog/FuncSafe/fsCom.c ****    }
1277:common/prog/FuncSafe/fsCom.c ****    vSetChannelOngoing(ucCheckId);
1278:common/prog/FuncSafe/fsCom.c **** }
1279:common/prog/FuncSafe/fsCom.c **** 
1280:common/prog/FuncSafe/fsCom.c **** 
1281:common/prog/FuncSafe/fsCom.c **** /** Report a channel error to FSCOM.
1282:common/prog/FuncSafe/fsCom.c ****     If a channel has stopped monitoring due to an error, this event is immediately
1283:common/prog/FuncSafe/fsCom.c ****     reported to FSCOM.
1284:common/prog/FuncSafe/fsCom.c ****     \param      ucCheckId      identifier of the the addressed channel / recognition of report ID (
1285:common/prog/FuncSafe/fsCom.c ****     \param      ucSubCheckId   FSF_ERROR_CODE that describes the problem - please note that this pa
1286:common/prog/FuncSafe/fsCom.c ****     \param      ucUserPar      Parameter defined by user\n
1287:common/prog/FuncSafe/fsCom.c **** 
1288:common/prog/FuncSafe/fsCom.c ****     \pre        FSCOM initialised correctly. Channel identifier within the correct range.\n
1289:common/prog/FuncSafe/fsCom.c ****     \post       Invalid channel addressing immediately results into the safe state as this
1290:common/prog/FuncSafe/fsCom.c ****                 is not allowed to occur.\n
1291:common/prog/FuncSafe/fsCom.c **** */
1292:common/prog/FuncSafe/fsCom.c **** void FSF_vReportError(uint8_t ucCheckId, uint8_t ucSubCheckId, uint8_t ucUserPar)
1293:common/prog/FuncSafe/fsCom.c **** 
1294:common/prog/FuncSafe/fsCom.c **** {
1295:common/prog/FuncSafe/fsCom.c ****    uint8_t errcode = (uint8_t)FSF_ERR_CHANNEL_ERROR;
1296:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
1297:common/prog/FuncSafe/fsCom.c ****    //  Do not service channels outside FSCOM
1298:common/prog/FuncSafe/fsCom.c ****    if (ucCheckId >= (uint8_t)FSF_APP_CHANNEL_0)
1299:common/prog/FuncSafe/fsCom.c ****    {
1300:common/prog/FuncSafe/fsCom.c ****       return;
1301:common/prog/FuncSafe/fsCom.c ****    }
1302:common/prog/FuncSafe/fsCom.c **** #endif
1303:common/prog/FuncSafe/fsCom.c ****    //  Is FSCOM ready to handle channel related problems
1304:common/prog/FuncSafe/fsCom.c ****    if (ucGetFSCOM_State() == (uint8_t)FSF_STATE_STARTED)
1305:common/prog/FuncSafe/fsCom.c ****    {
1306:common/prog/FuncSafe/fsCom.c ****       if (ucCheckId < (uint8_t)FSF_LASTID)
1307:common/prog/FuncSafe/fsCom.c ****       {
1308:common/prog/FuncSafe/fsCom.c ****          if (ucCheckId < FSF_ucNrOfChannels)
1309:common/prog/FuncSafe/fsCom.c ****          {
1310:common/prog/FuncSafe/fsCom.c ****             //Channel
1311:common/prog/FuncSafe/fsCom.c ****             switch (ucGetChannelState(ucCheckId))
1312:common/prog/FuncSafe/fsCom.c ****             {
1313:common/prog/FuncSafe/fsCom.c ****                case (uint8_t)FSF_CH_STATE_IDLE:
1314:common/prog/FuncSafe/fsCom.c ****                case (uint8_t)FSF_CH_STATE_SUCCESS:
1315:common/prog/FuncSafe/fsCom.c ****                case (uint8_t)FSF_CH_STATE_ONGOING:
1316:common/prog/FuncSafe/fsCom.c ****                {
1317:common/prog/FuncSafe/fsCom.c ****                   break;
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 36


1318:common/prog/FuncSafe/fsCom.c ****                }
1319:common/prog/FuncSafe/fsCom.c ****                default:
1320:common/prog/FuncSafe/fsCom.c ****                {
1321:common/prog/FuncSafe/fsCom.c ****                   errcode = (uint8_t)FSF_ERR_INVALID_STATE;
1322:common/prog/FuncSafe/fsCom.c ****                   break;
1323:common/prog/FuncSafe/fsCom.c ****                }
1324:common/prog/FuncSafe/fsCom.c ****             }
1325:common/prog/FuncSafe/fsCom.c ****          }
1326:common/prog/FuncSafe/fsCom.c ****          else
1327:common/prog/FuncSafe/fsCom.c ****          {
1328:common/prog/FuncSafe/fsCom.c ****             if (ucCheckId > (uint8_t)FSF_NOCHANNEL)
1329:common/prog/FuncSafe/fsCom.c ****             {
1330:common/prog/FuncSafe/fsCom.c ****                //No channel, but valid ID (e.g. external watchdog)
1331:common/prog/FuncSafe/fsCom.c ****                errcode = ucSubCheckId;
1332:common/prog/FuncSafe/fsCom.c **** 
1333:common/prog/FuncSafe/fsCom.c ****             }
1334:common/prog/FuncSafe/fsCom.c ****             else
1335:common/prog/FuncSafe/fsCom.c ****             {
1336:common/prog/FuncSafe/fsCom.c ****                //Unused channel
1337:common/prog/FuncSafe/fsCom.c ****                errcode = (uint8_t)FSF_ERR_INVALID_RANGE;
1338:common/prog/FuncSafe/fsCom.c ****             }
1339:common/prog/FuncSafe/fsCom.c ****          }
1340:common/prog/FuncSafe/fsCom.c ****       }
1341:common/prog/FuncSafe/fsCom.c ****       else
1342:common/prog/FuncSafe/fsCom.c ****       {
1343:common/prog/FuncSafe/fsCom.c ****          //Out of range
1344:common/prog/FuncSafe/fsCom.c ****          errcode = (uint8_t)FSF_ERR_INVALID_RANGE;
1345:common/prog/FuncSafe/fsCom.c ****       }
1346:common/prog/FuncSafe/fsCom.c ****       _FSF_RAM_CON_vSetErrCounter();
1347:common/prog/FuncSafe/fsCom.c ****       vExtApplicationErrorNotify(errcode,ucCheckId,ucUserPar);
1348:common/prog/FuncSafe/fsCom.c ****    }
1349:common/prog/FuncSafe/fsCom.c **** }
1350:common/prog/FuncSafe/fsCom.c **** 
1351:common/prog/FuncSafe/fsCom.c **** /** Report successfully completed check to FSCOM.
1352:common/prog/FuncSafe/fsCom.c ****     If a channel has completed checking (partially or finally) successfully, this
1353:common/prog/FuncSafe/fsCom.c ****     event is reported to FSCOM.
1354:common/prog/FuncSafe/fsCom.c ****     \param  ucCheckId  identifier of the the addressed channel\n
1355:common/prog/FuncSafe/fsCom.c **** 
1356:common/prog/FuncSafe/fsCom.c ****     \pre    FSCOM initialised correctly. Channel identifier within the correct range.
1357:common/prog/FuncSafe/fsCom.c ****     \post   For valid channels, internal state transitions, if any, have been completed.\n
1358:common/prog/FuncSafe/fsCom.c ****             Invalid channel addressing immediately results into the safe state as this
1359:common/prog/FuncSafe/fsCom.c ****             is not allowed to occur.\n
1360:common/prog/FuncSafe/fsCom.c **** */
1361:common/prog/FuncSafe/fsCom.c **** 
1362:common/prog/FuncSafe/fsCom.c **** void FSF_vReportSuccess(uint8_t ucCheckId)
1363:common/prog/FuncSafe/fsCom.c **** 
1364:common/prog/FuncSafe/fsCom.c **** {
1365:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
1366:common/prog/FuncSafe/fsCom.c ****    //  Do not service channels outside FSCOM
1367:common/prog/FuncSafe/fsCom.c ****    if (ucCheckId >= (uint8_t)FSF_APP_CHANNEL_0)
1368:common/prog/FuncSafe/fsCom.c ****    {
1369:common/prog/FuncSafe/fsCom.c ****       return;
1370:common/prog/FuncSafe/fsCom.c ****    }
1371:common/prog/FuncSafe/fsCom.c **** #endif
1372:common/prog/FuncSafe/fsCom.c ****    switch (ucGetChannelState(ucCheckId))
1373:common/prog/FuncSafe/fsCom.c ****    {
1374:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_CH_STATE_IDLE:
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 37


1375:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_CH_STATE_SUCCESS:
1376:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_CH_STATE_ONGOING:
1377:common/prog/FuncSafe/fsCom.c ****       {
1378:common/prog/FuncSafe/fsCom.c ****          // Initialize the channels check cycle
1379:common/prog/FuncSafe/fsCom.c ****          FSF_sCH_CheckCycleTime[ucCheckId].ui16CheckCycleTime = FSF_psChannelTab[ucCheckId]->sCheck
1380:common/prog/FuncSafe/fsCom.c ****          FSF_sCH_CheckCycleTime[ucCheckId].ucCycleMultiplier  = FSF_psChannelTab[ucCheckId]->sCheck
1381:common/prog/FuncSafe/fsCom.c ****          vSetChannelSuccess(ucCheckId);
1382:common/prog/FuncSafe/fsCom.c ****          break;
1383:common/prog/FuncSafe/fsCom.c ****       }
1384:common/prog/FuncSafe/fsCom.c ****       default:
1385:common/prog/FuncSafe/fsCom.c ****       {
1386:common/prog/FuncSafe/fsCom.c ****          vExtApplicationErrorNotify((uint8_t)FSF_ERR_INVALID_STATE,ucCheckId,(uint8_t)0);
1387:common/prog/FuncSafe/fsCom.c ****          break;
1388:common/prog/FuncSafe/fsCom.c ****       }
1389:common/prog/FuncSafe/fsCom.c ****    }
1390:common/prog/FuncSafe/fsCom.c **** }
1391:common/prog/FuncSafe/fsCom.c **** 
1392:common/prog/FuncSafe/fsCom.c **** /** Observe successful channel check in the past.
1393:common/prog/FuncSafe/fsCom.c ****     A Boolean value is returned by this service. When at least one check cycle has
1394:common/prog/FuncSafe/fsCom.c ****     been completed successfully true is returned, otherwise false is returned. See
1395:common/prog/FuncSafe/fsCom.c ****     chapter 8.7 (Functional Safety Software Specification document) for an example of use.
1396:common/prog/FuncSafe/fsCom.c ****     \param          ucCheckId  identifier of the the addressed channel\n
1397:common/prog/FuncSafe/fsCom.c **** 
1398:common/prog/FuncSafe/fsCom.c ****     \return         bool       true/false, see description.\n\n
1399:common/prog/FuncSafe/fsCom.c ****     \pre            FSCOM initialised correctly. Channel identifier within the correct range.\n
1400:common/prog/FuncSafe/fsCom.c ****     \post           Invalid channel addressing immediately results into the safe state as this
1401:common/prog/FuncSafe/fsCom.c ****                     is not allowed to occur.\n
1402:common/prog/FuncSafe/fsCom.c **** */
1403:common/prog/FuncSafe/fsCom.c **** 
1404:common/prog/FuncSafe/fsCom.c **** bool    FSF_bSuccesInPast(uint8_t ucCheckId)
1405:common/prog/FuncSafe/fsCom.c **** {
1406:common/prog/FuncSafe/fsCom.c ****    bool retval = false;
1407:common/prog/FuncSafe/fsCom.c ****    switch (ucGetChannelState(ucCheckId))
1408:common/prog/FuncSafe/fsCom.c ****    {
1409:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_CH_STATE_IDLE:
1410:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_CH_STATE_SUCCESS:
1411:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_CH_STATE_ONGOING:
1412:common/prog/FuncSafe/fsCom.c ****       {
1413:common/prog/FuncSafe/fsCom.c ****          retval = UTI_bGetBit(FSF_ucCH_states[FSF_SUCC_IN_PAST_FIELD],ucCheckId);
1414:common/prog/FuncSafe/fsCom.c ****          break;
1415:common/prog/FuncSafe/fsCom.c ****       }
1416:common/prog/FuncSafe/fsCom.c ****       default:
1417:common/prog/FuncSafe/fsCom.c ****       {
1418:common/prog/FuncSafe/fsCom.c ****          vExtApplicationErrorNotify((uint8_t)FSF_ERR_INVALID_STATE,ucCheckId,(uint8_t)0);
1419:common/prog/FuncSafe/fsCom.c ****          break;
1420:common/prog/FuncSafe/fsCom.c ****       }
1421:common/prog/FuncSafe/fsCom.c ****    }
1422:common/prog/FuncSafe/fsCom.c ****    return retval;
1423:common/prog/FuncSafe/fsCom.c **** }
1424:common/prog/FuncSafe/fsCom.c **** 
1425:common/prog/FuncSafe/fsCom.c **** /** Report a fatal exception.
1426:common/prog/FuncSafe/fsCom.c ****     This service is provided for channels that require IMMEDIATE transition into the safe state.
1427:common/prog/FuncSafe/fsCom.c ****     For example, if the register channel has recognised stuck-at fault on the carry flag, then
1428:common/prog/FuncSafe/fsCom.c ****     control immediately has to move to the safe state (Jump instruction).
1429:common/prog/FuncSafe/fsCom.c **** 
1430:common/prog/FuncSafe/fsCom.c ****     \pre    None\n
1431:common/prog/FuncSafe/fsCom.c ****     \post   No return from this call.\n
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 38


1432:common/prog/FuncSafe/fsCom.c **** */
1433:common/prog/FuncSafe/fsCom.c **** void    FSF_vReportFatal(void)
1434:common/prog/FuncSafe/fsCom.c **** {
1435:common/prog/FuncSafe/fsCom.c ****    vExtReportFatal();
1436:common/prog/FuncSafe/fsCom.c **** }
