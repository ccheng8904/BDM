 755:common/prog/FuncSafe/fsCom.c **** */
 756:common/prog/FuncSafe/fsCom.c **** STATIC  uint8_t   ucGetChannelState(uint8_t ucCheckId)
 757:common/prog/FuncSafe/fsCom.c **** {
 758:common/prog/FuncSafe/fsCom.c ****    if (bIsChannelIdValid(ucCheckId) != false)
 759:common/prog/FuncSafe/fsCom.c ****    {
 760:common/prog/FuncSafe/fsCom.c ****       //  Getting values from a bit field is an expensive task. Thus, i'll take it only once!
 761:common/prog/FuncSafe/fsCom.c ****       bool   bIsSuccess = (bool)UTI_bGetBit(FSF_ucCH_states[FSF_SUCCESS_FIELD],(uint16_t)ucCheckId)
 762:common/prog/FuncSafe/fsCom.c ****       bool   bIsOngoing = (bool)UTI_bGetBit(FSF_ucCH_states[FSF_ONGOING_FIELD],(uint16_t)ucCheckId)
 763:common/prog/FuncSafe/fsCom.c **** 
