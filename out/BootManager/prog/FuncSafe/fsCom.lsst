 686:common/prog/FuncSafe/fsCom.c **** STATIC  bool    bIsChannelIdValid(uint8_t ucCheckId)
 687:common/prog/FuncSafe/fsCom.c **** {
 688:common/prog/FuncSafe/fsCom.c ****    //  The FSF configuration hard data holds the number of channels available
 689:common/prog/FuncSafe/fsCom.c ****    //  The channel identifier MUST be within this range
 690:common/prog/FuncSafe/fsCom.c ****    if (ucCheckId < FSF_ucNrOfChannels)
 691:common/prog/FuncSafe/fsCom.c ****    {
 692:common/prog/FuncSafe/fsCom.c ****       return true;
