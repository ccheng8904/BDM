1137:common/prog/FuncSafe/fsCom.c ****    vPerformOneTimeChecks();
1138:common/prog/FuncSafe/fsCom.c ****    //  Change FSCOM state into BOOTED
1139:common/prog/FuncSafe/fsCom.c ****    FSF_ucTaskState = (uint8_t)FSF_STATE_BOOTED;
1140:common/prog/FuncSafe/fsCom.c ****    //  Continue the systems start up procedure.
1141:common/prog/FuncSafe/fsCom.c **** //   FSF_vContinueStartUp();
1142:common/prog/FuncSafe/fsCom.c ****    //  NOTE:
