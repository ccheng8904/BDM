 270:common/prog/FuncSafe/fsCom.c **** /* static function definitions ********************************************************************
 271:common/prog/FuncSafe/fsCom.c **** 
 272:common/prog/FuncSafe/fsCom.c **** //@{\name FSCOM local functions
 273:common/prog/FuncSafe/fsCom.c **** /** Perform the one-time check for all channels available
 274:common/prog/FuncSafe/fsCom.c **** 
 275:common/prog/FuncSafe/fsCom.c ****     \return     None\n
 276:common/prog/FuncSafe/fsCom.c ****     \pre        None\n
 277:common/prog/FuncSafe/fsCom.c ****     \post       All channels checked\n
 278:common/prog/FuncSafe/fsCom.c **** 
 279:common/prog/FuncSafe/fsCom.c **** */
 280:common/prog/FuncSafe/fsCom.c **** /*-----------------------------------------------------------------------
 281:common/prog/FuncSafe/fsCom.c ****   Control Flow:
 282:common/prog/FuncSafe/fsCom.c ****   Begin
 283:common/prog/FuncSafe/fsCom.c ****       this function has to be called immediately on completion of the Register and
 284:common/prog/FuncSafe/fsCom.c ****       the RAM check. The stack pointer is now set up correctly, hence local variables
 285:common/prog/FuncSafe/fsCom.c ****       are allowed to use without restrictions.
 286:common/prog/FuncSafe/fsCom.c **** 
 287:common/prog/FuncSafe/fsCom.c ****       take the number of channels from the channel configuration;
 288:common/prog/FuncSafe/fsCom.c **** 
 289:common/prog/FuncSafe/fsCom.c ****       Loop for the rest of all channels actually configured:
 290:common/prog/FuncSafe/fsCom.c ****       begin
 291:common/prog/FuncSafe/fsCom.c ****           indirectly activate the one-time check handler;
 292:common/prog/FuncSafe/fsCom.c ****       end;
 293:common/prog/FuncSafe/fsCom.c **** 
 294:common/prog/FuncSafe/fsCom.c ****   End
 295:common/prog/FuncSafe/fsCom.c **** -------------------------------------------------------------------------*/
 296:common/prog/FuncSafe/fsCom.c **** #ifdef APP_VARIANT
 297:common/prog/FuncSafe/fsCom.c **** STATIC  void    vPerformOneTimeChecks(void)
 298:common/prog/FuncSafe/fsCom.c **** {
 299:common/prog/FuncSafe/fsCom.c **** 
 300:common/prog/FuncSafe/fsCom.c ****    uint8_t  n = (uint8_t)FSF_FIRST_APPL_TEST;
 301:common/prog/FuncSafe/fsCom.c ****    while (n < (uint8_t)FSF_ucNrOfChannels)
 302:common/prog/FuncSafe/fsCom.c ****    {
 303:common/prog/FuncSafe/fsCom.c ****       FSF_psChannelTab[n++]->FSF_pvOneTimeCheck();/*lint !e9049 : increment/decrement operation com
 304:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
 305:common/prog/FuncSafe/fsCom.c ****       TH_FSFP_PushOutPar((uint8_t)n);
 306:common/prog/FuncSafe/fsCom.c **** #endif
 307:common/prog/FuncSafe/fsCom.c ****    }
 308:common/prog/FuncSafe/fsCom.c **** }
 309:common/prog/FuncSafe/fsCom.c **** #endif
 310:common/prog/FuncSafe/fsCom.c **** /** Observe the state of FSCOM
 311:common/prog/FuncSafe/fsCom.c **** 
 312:common/prog/FuncSafe/fsCom.c ****     Return the state of the FSCOM component.
 313:common/prog/FuncSafe/fsCom.c **** 
 314:common/prog/FuncSafe/fsCom.c ****     \return     uint8_t   the state of the FSCOM generic
 315:common/prog/FuncSafe/fsCom.c ****     \pre        None\n
 316:common/prog/FuncSafe/fsCom.c **** */
 317:common/prog/FuncSafe/fsCom.c **** STATIC  uint8_t    ucGetFSCOM_State(void)
 318:common/prog/FuncSafe/fsCom.c **** {
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 7


 319:common/prog/FuncSafe/fsCom.c ****    return FSF_ucTaskState;
 320:common/prog/FuncSafe/fsCom.c **** }
 321:common/prog/FuncSafe/fsCom.c **** /** Change the state of the FSCOM generic to the state passed here.
 322:common/prog/FuncSafe/fsCom.c **** 
 323:common/prog/FuncSafe/fsCom.c ****     \return     uint8_t   the state of the FSCOM generic
 324:common/prog/FuncSafe/fsCom.c ****     \pre        None\n
 325:common/prog/FuncSafe/fsCom.c ****     \post       Transition into new state completed
 326:common/prog/FuncSafe/fsCom.c ****     \note       If an invalid state value has been passed a boot error will\n
 327:common/prog/FuncSafe/fsCom.c ****                 be created in
 328:common/prog/FuncSafe/fsCom.c **** */
 329:common/prog/FuncSafe/fsCom.c **** STATIC  void    vSetFSCOM_State(uint8_t newstate)
 330:common/prog/FuncSafe/fsCom.c **** {
 331:common/prog/FuncSafe/fsCom.c ****    switch (newstate)
 332:common/prog/FuncSafe/fsCom.c ****    {
 333:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_STATE_BOOTED:
 334:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_STATE_STARTED:
 335:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_STATE_PRESCHEDULED:
 336:common/prog/FuncSafe/fsCom.c ****       {
 337:common/prog/FuncSafe/fsCom.c ****          //  Take over the valid state
 338:common/prog/FuncSafe/fsCom.c ****          FSF_ucTaskState = newstate;
 339:common/prog/FuncSafe/fsCom.c ****          break;
 340:common/prog/FuncSafe/fsCom.c ****       }
 341:common/prog/FuncSafe/fsCom.c ****       default:
 342:common/prog/FuncSafe/fsCom.c ****       {
 343:common/prog/FuncSafe/fsCom.c ****          //  FSCOM state out-of-range
 344:common/prog/FuncSafe/fsCom.c ****          FSF_vBootError();
 345:common/prog/FuncSafe/fsCom.c ****          break; // needed to satisfy SCA
 346:common/prog/FuncSafe/fsCom.c ****       }
 347:common/prog/FuncSafe/fsCom.c ****    }
 348:common/prog/FuncSafe/fsCom.c **** }
 349:common/prog/FuncSafe/fsCom.c **** 
 350:common/prog/FuncSafe/fsCom.c **** /** Start FSCOM channel monitoring.
 351:common/prog/FuncSafe/fsCom.c ****     The scheduler component schedules FSCOM on a regular base. The 1st scheduling cycle
 352:common/prog/FuncSafe/fsCom.c ****     is interpreted as monitoring about to start. This requires at least one scheduling
 353:common/prog/FuncSafe/fsCom.c ****     cycle for the FSCOM BEFORE all other channels are scheduled. At the end of this
 354:common/prog/FuncSafe/fsCom.c ****     cycle, the external watchdog is serviced at least once.
 355:common/prog/FuncSafe/fsCom.c **** 
 356:common/prog/FuncSafe/fsCom.c ****     \return uint8_t    the FSCOM state.\n\n
 357:common/prog/FuncSafe/fsCom.c ****     \pre    FSCOM booted correctly, so ECU located parts are "ready-for-use"\n
 358:common/prog/FuncSafe/fsCom.c ****     \post   All one-time checks have been performed successfully, that is the one-time
 359:common/prog/FuncSafe/fsCom.c ****             Register check and the one-time RAM check. FSCOM data structures have been
 360:common/prog/FuncSafe/fsCom.c ****             initialised correctly and the external watchdog has been serviced.\n
 361:common/prog/FuncSafe/fsCom.c **** */
 362:common/prog/FuncSafe/fsCom.c **** STATIC  uint8_t    ucMonitoringStart(void)
 363:common/prog/FuncSafe/fsCom.c **** {
 364:common/prog/FuncSafe/fsCom.c ****    uint8_t   retval  = (uint8_t)FSF_STATE_BOOTED;      // the return value
 365:common/prog/FuncSafe/fsCom.c ****    uint8_t   i;                                      // loop var
 366:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
 367:common/prog/FuncSafe/fsCom.c ****    TH_FSFP_PushOutPar((uint8_t)TP_FSF_ucMonitoringStart);
 368:common/prog/FuncSafe/fsCom.c **** #endif
 369:common/prog/FuncSafe/fsCom.c ****    //  Initialise all channel data
 370:common/prog/FuncSafe/fsCom.c ****    if (FSF_ucNrOfChannels > (uint8_t)0)
 371:common/prog/FuncSafe/fsCom.c ****    {
 372:common/prog/FuncSafe/fsCom.c ****       //  Initialise the rest of all existing channels
 373:common/prog/FuncSafe/fsCom.c ****       for (i = (uint8_t)FSF_REG_TEST;i < FSF_ucNrOfChannels;i++)
 374:common/prog/FuncSafe/fsCom.c ****       {
 375:common/prog/FuncSafe/fsCom.c ****          //  Channel initialisation happens only for channels scheduled regularely
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 8


 376:common/prog/FuncSafe/fsCom.c ****          if (FSF_psChannelTab[i]->bIsRegularCheck != false)
 377:common/prog/FuncSafe/fsCom.c ****          {
 378:common/prog/FuncSafe/fsCom.c ****             //  Move the channel into the state IDLE
 379:common/prog/FuncSafe/fsCom.c ****             vSetChannelIdle((uint8_t)i);
 380:common/prog/FuncSafe/fsCom.c ****             // Initialize the channels check cycle
 381:common/prog/FuncSafe/fsCom.c ****             FSF_sCH_CheckCycleTime[i].ui16CheckCycleTime = FSF_psChannelTab[i]->sCheckCycle.ui16Che
 382:common/prog/FuncSafe/fsCom.c ****             FSF_sCH_CheckCycleTime[i].ucCycleMultiplier  = FSF_psChannelTab[i]->sCheckCycle.ucCycle
 383:common/prog/FuncSafe/fsCom.c ****          }
 384:common/prog/FuncSafe/fsCom.c ****       }
 385:common/prog/FuncSafe/fsCom.c ****       //  Finally, trigger the external watchdog
 386:common/prog/FuncSafe/fsCom.c ****       vTriggerExtWatchdog();
 387:common/prog/FuncSafe/fsCom.c ****       //  Load the pre-scheduling counter
 388:common/prog/FuncSafe/fsCom.c ****       ucPreSchedulingCtr = FSF_ucPreSchedCycles;
 389:common/prog/FuncSafe/fsCom.c **** 
 390:common/prog/FuncSafe/fsCom.c ****       //  Change the FSCOM into state PRESCHEDULED
 391:common/prog/FuncSafe/fsCom.c ****       retval = (uint8_t)FSF_STATE_PRESCHEDULED;
 392:common/prog/FuncSafe/fsCom.c ****       //  Set up the check cycle timer
 393:common/prog/FuncSafe/fsCom.c **** #ifdef FSF_CYCLE_TIM_SIZE_32BIT
 394:common/prog/FuncSafe/fsCom.c ****       FSF_ulCheckCycleTimer = (uint32_t)(FSF_CHECK_CYCLE_TIME * 1000u);
 395:common/prog/FuncSafe/fsCom.c **** #else
 396:common/prog/FuncSafe/fsCom.c ****       FSF_ucCheckCycleTimer = (uint8_t)FSF_CHECK_CYCLE_TIME;
 397:common/prog/FuncSafe/fsCom.c **** #endif
 398:common/prog/FuncSafe/fsCom.c ****    }
 399:common/prog/FuncSafe/fsCom.c ****    else
 400:common/prog/FuncSafe/fsCom.c ****    {
 401:common/prog/FuncSafe/fsCom.c ****       //  Channel configuration
 402:common/prog/FuncSafe/fsCom.c ****       //  error
 403:common/prog/FuncSafe/fsCom.c ****       FSF_vBootError();
 404:common/prog/FuncSafe/fsCom.c ****    }
 405:common/prog/FuncSafe/fsCom.c **** 
 406:common/prog/FuncSafe/fsCom.c ****    return  retval;
 407:common/prog/FuncSafe/fsCom.c **** }
 408:common/prog/FuncSafe/fsCom.c **** 
 409:common/prog/FuncSafe/fsCom.c **** /** Perform a channel monitoring cycle.
 410:common/prog/FuncSafe/fsCom.c **** 
 411:common/prog/FuncSafe/fsCom.c ****     \param      ucCheckId channel identifier
 412:common/prog/FuncSafe/fsCom.c ****     \return     uint8_t     TASK_INITIALISED
 413:common/prog/FuncSafe/fsCom.c ****     \pre        FSCOM initialised
 414:common/prog/FuncSafe/fsCom.c ****     \post       - all channels returned into its IDLE state\n
 415:common/prog/FuncSafe/fsCom.c ****                 - channel check cycle time maintained\n
 416:common/prog/FuncSafe/fsCom.c ****                 - external watchdog triggered\n
 417:common/prog/FuncSafe/fsCom.c ****     \note       If a channel remains in state IDLE an application error\n
 418:common/prog/FuncSafe/fsCom.c ****                 will be created with the error code FSF_ERR_CHANNEL_IDLE.\n
 419:common/prog/FuncSafe/fsCom.c ****                 if a channel check cycle has elapsed an application error\n
 420:common/prog/FuncSafe/fsCom.c ****                 will be created with the error code FSF_ERR_CYCLE_OVERDUE.\n
 421:common/prog/FuncSafe/fsCom.c **** */
 422:common/prog/FuncSafe/fsCom.c **** /*-----------------------------------------------------------------------
 423:common/prog/FuncSafe/fsCom.c ****   Control Flow:
 424:common/prog/FuncSafe/fsCom.c ****   Begin
 425:common/prog/FuncSafe/fsCom.c **** 
 426:common/prog/FuncSafe/fsCom.c ****       For the actual channel
 427:common/prog/FuncSafe/fsCom.c **** 
 428:common/prog/FuncSafe/fsCom.c ****       if the affected channel is scheduled regularely then
 429:common/prog/FuncSafe/fsCom.c **** 
 430:common/prog/FuncSafe/fsCom.c ****           if the channel remains in state IDLE then
 431:common/prog/FuncSafe/fsCom.c **** 
 432:common/prog/FuncSafe/fsCom.c ****               inform the application by FSF_ERR_CHANNEL_IDLE
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 9


 433:common/prog/FuncSafe/fsCom.c **** 
 434:common/prog/FuncSafe/fsCom.c ****           fi
 435:common/prog/FuncSafe/fsCom.c **** 
 436:common/prog/FuncSafe/fsCom.c ****           if the channel check cycle completion is overdue then
 437:common/prog/FuncSafe/fsCom.c **** 
 438:common/prog/FuncSafe/fsCom.c ****               inform the application by FSF_ERR_CYCLE_OVERDUE
 439:common/prog/FuncSafe/fsCom.c **** 
 440:common/prog/FuncSafe/fsCom.c ****           fi
 441:common/prog/FuncSafe/fsCom.c **** 
 442:common/prog/FuncSafe/fsCom.c ****           move the channel into the state IDLE;
 443:common/prog/FuncSafe/fsCom.c **** 
 444:common/prog/FuncSafe/fsCom.c ****       fi
 445:common/prog/FuncSafe/fsCom.c **** 
 446:common/prog/FuncSafe/fsCom.c ****   End
 447:common/prog/FuncSafe/fsCom.c **** -------------------------------------------------------------------------*/
 448:common/prog/FuncSafe/fsCom.c **** STATIC  uint8_t    ucNewMonitorCycle(uint8_t ucCheckId)
 449:common/prog/FuncSafe/fsCom.c **** {
 450:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
 451:common/prog/FuncSafe/fsCom.c ****    TH_FSFP_PushOutPar((uint8_t)TP_FSF_ucNewMonitorCycle);
 452:common/prog/FuncSafe/fsCom.c ****    TH_FSFP_PushOutPar(ucCheckId);
 453:common/prog/FuncSafe/fsCom.c **** #endif
 454:common/prog/FuncSafe/fsCom.c ****    // Maintain configured channels
 455:common/prog/FuncSafe/fsCom.c ****    // Channel supervision happens only for regularely scheduled channels
 456:common/prog/FuncSafe/fsCom.c ****    if (FSF_psChannelTab[ucCheckId]->bIsRegularCheck != false)
 457:common/prog/FuncSafe/fsCom.c ****    {
 458:common/prog/FuncSafe/fsCom.c ****       // Channels that remain in state IDLE are considered dead
 459:common/prog/FuncSafe/fsCom.c ****       if ((uint8_t)FSF_CH_STATE_IDLE == ucGetChannelState(ucCheckId))
 460:common/prog/FuncSafe/fsCom.c ****       {
 461:common/prog/FuncSafe/fsCom.c ****          vExtApplicationErrorNotify((uint8_t)FSF_ERR_CHANNEL_IDLE,ucCheckId,(uint8_t)0);
 462:common/prog/FuncSafe/fsCom.c ****       }
 463:common/prog/FuncSafe/fsCom.c ****       // For ongoing channel check cycles:
 464:common/prog/FuncSafe/fsCom.c ****       if ((uint8_t)FSF_CH_STATE_ONGOING == ucGetChannelState(ucCheckId))
 465:common/prog/FuncSafe/fsCom.c ****       {
 466:common/prog/FuncSafe/fsCom.c ****          // If one scheduling cycle time has elapsed, then...
 467:common/prog/FuncSafe/fsCom.c ****          if (FS_COM_RamConBlock.ucCCElapsedCounter > (uint8_t)0)
 468:common/prog/FuncSafe/fsCom.c ****          {
 469:common/prog/FuncSafe/fsCom.c ****             // Maintain the channel cycle time
 470:common/prog/FuncSafe/fsCom.c ****             if (bIsChannelCycleOverdue(ucCheckId) != false)
 471:common/prog/FuncSafe/fsCom.c ****             {
 472:common/prog/FuncSafe/fsCom.c ****                vExtApplicationErrorNotify((uint8_t)FSF_ERR_CYCLE_OVERDUE,ucCheckId,(uint8_t)0);
 473:common/prog/FuncSafe/fsCom.c ****             }
 474:common/prog/FuncSafe/fsCom.c ****          }
 475:common/prog/FuncSafe/fsCom.c ****       }
 476:common/prog/FuncSafe/fsCom.c ****       //  Reset the channel back into its state IDLE
 477:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
 478:common/prog/FuncSafe/fsCom.c ****       TH_FSFP_PushOutPar((uint8_t)TP_FSF_vSetChannelIdle);
 479:common/prog/FuncSafe/fsCom.c **** #endif
 480:common/prog/FuncSafe/fsCom.c ****       vSetChannelIdle(ucCheckId);
 481:common/prog/FuncSafe/fsCom.c ****    }
 482:common/prog/FuncSafe/fsCom.c ****    //  If all channels have been checked, reset the counter of time packet that have elapsed during
 483:common/prog/FuncSafe/fsCom.c ****    //  the last check cycle
 484:common/prog/FuncSafe/fsCom.c ****    if (ucCheckId >= (uint8_t)(FSF_ucNrOfChannels - 1u))
 485:common/prog/FuncSafe/fsCom.c ****    {
 486:common/prog/FuncSafe/fsCom.c ****       FS_COM_RamConBlock.ucCCElapsedCounter = (uint8_t)0;
 487:common/prog/FuncSafe/fsCom.c ****    }
 488:common/prog/FuncSafe/fsCom.c ****    return (uint8_t)TASK_INITIALISED;
 489:common/prog/FuncSafe/fsCom.c **** }
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 10


 490:common/prog/FuncSafe/fsCom.c **** 
 491:common/prog/FuncSafe/fsCom.c **** /** Change the state of the addressed channel to the state IDLE.
 492:common/prog/FuncSafe/fsCom.c **** 
 493:common/prog/FuncSafe/fsCom.c ****     \return     None
 494:common/prog/FuncSafe/fsCom.c ****     \pre        None\n
 495:common/prog/FuncSafe/fsCom.c ****     \post       Transition into the IDLE state completed
 496:common/prog/FuncSafe/fsCom.c ****     \note       If an invalid channel address is given an application error\n
 497:common/prog/FuncSafe/fsCom.c ****                 will be created with the error code FSF_ERR_INVALID_RANGE.\n
 498:common/prog/FuncSafe/fsCom.c **** */
 499:common/prog/FuncSafe/fsCom.c **** STATIC  void    vSetChannelIdle(uint8_t ucCheckId)
 500:common/prog/FuncSafe/fsCom.c **** {
 501:common/prog/FuncSafe/fsCom.c ****    if (bIsChannelIdValid(ucCheckId) != false)
 502:common/prog/FuncSafe/fsCom.c ****    {
 503:common/prog/FuncSafe/fsCom.c ****       UTI_vSetBit(FSF_ucCH_states[FSF_ONGOING_FIELD],(uint16_t)ucCheckId,false);
 504:common/prog/FuncSafe/fsCom.c ****       UTI_vSetBit(FSF_ucCH_states[FSF_SUCCESS_FIELD],(uint16_t)ucCheckId,false);
 505:common/prog/FuncSafe/fsCom.c ****    }
 506:common/prog/FuncSafe/fsCom.c **** }
 507:common/prog/FuncSafe/fsCom.c **** 
 508:common/prog/FuncSafe/fsCom.c **** /** Change the state of the addressed channel to the state ONGOING.
 509:common/prog/FuncSafe/fsCom.c **** 
 510:common/prog/FuncSafe/fsCom.c ****     \return     None
 511:common/prog/FuncSafe/fsCom.c ****     \pre        None\n
 512:common/prog/FuncSafe/fsCom.c ****     \post       Transition into the ONGOING state completed
 513:common/prog/FuncSafe/fsCom.c ****     \note       If an invalid channel address is given an application error\n
 514:common/prog/FuncSafe/fsCom.c ****                 will be created with the error code FSF_ERR_INVALID_RANGE.\n
 515:common/prog/FuncSafe/fsCom.c **** */
 516:common/prog/FuncSafe/fsCom.c **** STATIC  void    vSetChannelOngoing(uint8_t ucCheckId)
 517:common/prog/FuncSafe/fsCom.c **** {
 518:common/prog/FuncSafe/fsCom.c ****    if (bIsChannelIdValid(ucCheckId) != false)
 519:common/prog/FuncSafe/fsCom.c ****    {
 520:common/prog/FuncSafe/fsCom.c ****       UTI_vSetBit(FSF_ucCH_states[FSF_SUCCESS_FIELD],(uint16_t)ucCheckId,false);
 521:common/prog/FuncSafe/fsCom.c ****       UTI_vSetBit(FSF_ucCH_states[FSF_ONGOING_FIELD],(uint16_t)ucCheckId,true);
 522:common/prog/FuncSafe/fsCom.c ****    }
 523:common/prog/FuncSafe/fsCom.c **** }
 524:common/prog/FuncSafe/fsCom.c **** 
 525:common/prog/FuncSafe/fsCom.c **** 
 526:common/prog/FuncSafe/fsCom.c **** /** Change the state of the addressed channel to the state SUCCESS.
 527:common/prog/FuncSafe/fsCom.c **** 
 528:common/prog/FuncSafe/fsCom.c ****     \return     None
 529:common/prog/FuncSafe/fsCom.c ****     \pre        None\n
 530:common/prog/FuncSafe/fsCom.c ****     \post       Transition into the SUCCESS state completed
 531:common/prog/FuncSafe/fsCom.c ****     \note       If an invalid channel address is given an application error\n
 532:common/prog/FuncSafe/fsCom.c ****                 will be created with the error code FSF_ERR_INVALID_RANGE.\n
 533:common/prog/FuncSafe/fsCom.c **** */
 534:common/prog/FuncSafe/fsCom.c **** STATIC  void    vSetChannelSuccess(uint8_t ucCheckId)
 535:common/prog/FuncSafe/fsCom.c **** {
 536:common/prog/FuncSafe/fsCom.c ****    if (bIsChannelIdValid(ucCheckId) != false)
 537:common/prog/FuncSafe/fsCom.c ****    {
 538:common/prog/FuncSafe/fsCom.c ****       UTI_vSetBit(FSF_ucCH_states[FSF_ONGOING_FIELD],(uint16_t)ucCheckId,true);
 539:common/prog/FuncSafe/fsCom.c ****       UTI_vSetBit(FSF_ucCH_states[FSF_SUCCESS_FIELD],(uint16_t)ucCheckId,true);
 540:common/prog/FuncSafe/fsCom.c ****       UTI_vSetBit(FSF_ucCH_states[FSF_SUCC_IN_PAST_FIELD],(uint16_t)ucCheckId,true);
 541:common/prog/FuncSafe/fsCom.c ****    }
 542:common/prog/FuncSafe/fsCom.c **** }
 543:common/prog/FuncSafe/fsCom.c **** 
 544:common/prog/FuncSafe/fsCom.c **** /** Trigger the external watchdog.
 545:common/prog/FuncSafe/fsCom.c **** 
 546:common/prog/FuncSafe/fsCom.c ****     \return     none
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 11


 547:common/prog/FuncSafe/fsCom.c ****     \pre        FSCOM initialised
 548:common/prog/FuncSafe/fsCom.c ****     \post       The external watchdog has been triggered correctly\n
 549:common/prog/FuncSafe/fsCom.c ****                 A time stamp has been created for this moment in time\n
 550:common/prog/FuncSafe/fsCom.c ****     \note       At boot time, the state of the watchdog is checked and, if it\n
 551:common/prog/FuncSafe/fsCom.c ****                 does not return the correct state, an application error is created\n
 552:common/prog/FuncSafe/fsCom.c ****                 with the error code FSF_ERR_BOOT_FAILURE.\n
 553:common/prog/FuncSafe/fsCom.c ****                 At operational time, the state of the watchdog is checked and, if it\n
 554:common/prog/FuncSafe/fsCom.c ****                 does not return the correct state, an application error is created\n
 555:common/prog/FuncSafe/fsCom.c ****                 with the error code FSF_ERR_WD_STATE_ERROR.\n
 556:common/prog/FuncSafe/fsCom.c ****                 If this call happens out of the correct moment in time, hence\n
 557:common/prog/FuncSafe/fsCom.c ****                 a violation of the timing of the the external watchdog has occurred,\n
 558:common/prog/FuncSafe/fsCom.c ****                 an application error is created with the error code\n
 559:common/prog/FuncSafe/fsCom.c ****                 FSF_ERR_WD_TIMING_VIOLATION.\n
 560:common/prog/FuncSafe/fsCom.c **** */
 561:common/prog/FuncSafe/fsCom.c **** /*-----------------------------------------------------------------------
 562:common/prog/FuncSafe/fsCom.c ****   Control Flow:
 563:common/prog/FuncSafe/fsCom.c **** 
 564:common/prog/FuncSafe/fsCom.c ****   The nominal moment in time when the watchdog trigger shall occure, lies just in
 565:common/prog/FuncSafe/fsCom.c ****   the middle of time slot T2. This moment is computed as
 566:common/prog/FuncSafe/fsCom.c **** 
 567:common/prog/FuncSafe/fsCom.c ****       current time[us] + ((T1 + T3 + (T2/2)) * 1000)[us].
 568:common/prog/FuncSafe/fsCom.c **** 
 569:common/prog/FuncSafe/fsCom.c ****   Names of time slots are taken from chapter 7.5 of [1]. Interface TIM_uiGetCircleMicroSeconds() pr
 570:common/prog/FuncSafe/fsCom.c ****   this interface returns a 16-bit value, up to approx. 65ms may be measured. There
 571:common/prog/FuncSafe/fsCom.c ****   is an overall system decision that one scheduling cycle is not allowed to exceed
 572:common/prog/FuncSafe/fsCom.c ****   this limitation. Hence, computation of the moment in time when the next watchdog
 573:common/prog/FuncSafe/fsCom.c ****   trigger has to happen can't exceed this limitation too. In order to avoid rounding
 574:common/prog/FuncSafe/fsCom.c ****   problems, the watchdog time slots T1 until T3 will be brought into microsecond unit.
 575:common/prog/FuncSafe/fsCom.c **** 
 576:common/prog/FuncSafe/fsCom.c ****   Begin
 577:common/prog/FuncSafe/fsCom.c ****       read in the current moment in time
 578:common/prog/FuncSafe/fsCom.c **** 
 579:common/prog/FuncSafe/fsCom.c ****       select FSCOM state
 580:common/prog/FuncSafe/fsCom.c **** 
 581:common/prog/FuncSafe/fsCom.c ****       Begin
 582:common/prog/FuncSafe/fsCom.c **** 
 583:common/prog/FuncSafe/fsCom.c ****           case BOOTED
 584:common/prog/FuncSafe/fsCom.c **** 
 585:common/prog/FuncSafe/fsCom.c ****               read the state of the external watchdog
 586:common/prog/FuncSafe/fsCom.c **** 
 587:common/prog/FuncSafe/fsCom.c ****               if this state does NOT show the safe state then
 588:common/prog/FuncSafe/fsCom.c **** 
 589:common/prog/FuncSafe/fsCom.c ****                   inform the application by FSF_ERR_BOOT_FAILURE
 590:common/prog/FuncSafe/fsCom.c **** 
 591:common/prog/FuncSafe/fsCom.c ****               fi
