1443:common/prog/FuncSafe/fsCom.c **** 
1444:common/prog/FuncSafe/fsCom.c **** //@{\name FSCOM exported scheduling functions
1445:common/prog/FuncSafe/fsCom.c **** 
1446:common/prog/FuncSafe/fsCom.c **** /*======================================================================
1447:common/prog/FuncSafe/fsCom.c ****     Real Scheduler Service(s)
1448:common/prog/FuncSafe/fsCom.c **** ======================================================================*/
1449:common/prog/FuncSafe/fsCom.c **** 
1450:common/prog/FuncSafe/fsCom.c **** /*=======================================================
1451:common/prog/FuncSafe/fsCom.c ****     STATIC uint8_t   ucHandleTask(void);
1452:common/prog/FuncSafe/fsCom.c **** =======================================================*/
1453:common/prog/FuncSafe/fsCom.c **** 
1454:common/prog/FuncSafe/fsCom.c **** /** Perform one execution cycle for ALL (!) channels actually registered.
1455:common/prog/FuncSafe/fsCom.c ****     While operational, execution is stopped immediately, if one component
1456:common/prog/FuncSafe/fsCom.c ****     did not return TASK_INITIALISED.
1457:common/prog/FuncSafe/fsCom.c **** 
1458:common/prog/FuncSafe/fsCom.c ****    \return    uint8_t     TASK_INITIALISED,     if all components returned this
1459:common/prog/FuncSafe/fsCom.c ****                         TASK_NOT_INITIALISED, if at least one component has returned this
1460:common/prog/FuncSafe/fsCom.c **** 
1461:common/prog/FuncSafe/fsCom.c ****    \pre       scheduler has been initialised\n
1462:common/prog/FuncSafe/fsCom.c ****    \post      all channels checked and returned into state IDLE
1463:common/prog/FuncSafe/fsCom.c **** */
1464:common/prog/FuncSafe/fsCom.c **** 
1465:common/prog/FuncSafe/fsCom.c **** STATIC uint8_t   ucHandleTask(void)
1466:common/prog/FuncSafe/fsCom.c **** {
1467:common/prog/FuncSafe/fsCom.c ****    _FSF_RAM_CON_vDoCheckInFsComModule();
1468:common/prog/FuncSafe/fsCom.c **** 
1469:common/prog/FuncSafe/fsCom.c **** /*======================================================================
1470:common/prog/FuncSafe/fsCom.c ****     TP_FSF_SCH_ucHandleTask
1471:common/prog/FuncSafe/fsCom.c **** ======================================================================*/
1472:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
1473:common/prog/FuncSafe/fsCom.c ****    TH_FSFP_PushOutPar((uint8_t)TP_FSF_SCH_ucHandleTask);
1474:common/prog/FuncSafe/fsCom.c **** #endif
1475:common/prog/FuncSafe/fsCom.c **** 
1476:common/prog/FuncSafe/fsCom.c ****    switch (ucSchedState)
1477:common/prog/FuncSafe/fsCom.c ****    {
1478:common/prog/FuncSafe/fsCom.c **** /*======================================================================
1479:common/prog/FuncSafe/fsCom.c ****     Initialize the generic
1480:common/prog/FuncSafe/fsCom.c **** ======================================================================*/
1481:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_SCH_INITIALISE:
1482:common/prog/FuncSafe/fsCom.c ****       {
1483:common/prog/FuncSafe/fsCom.c ****          FSF_ucRetVal = ucComHandleTask((uint8_t)FSF_NOCHANNEL);
1484:common/prog/FuncSafe/fsCom.c ****          if (FSF_ucRetVal == (uint8_t)TASK_INITIALISED)
1485:common/prog/FuncSafe/fsCom.c ****          {
1486:common/prog/FuncSafe/fsCom.c ****             //  Initialisation phase completed. Start generic scheduling
1487:common/prog/FuncSafe/fsCom.c ****             ucSchedState = (uint8_t)FSF_SCH_GENERIC;
1488:common/prog/FuncSafe/fsCom.c ****          }
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 39


1489:common/prog/FuncSafe/fsCom.c ****          break;
1490:common/prog/FuncSafe/fsCom.c ****       }
1491:common/prog/FuncSafe/fsCom.c **** /*======================================================================
1492:common/prog/FuncSafe/fsCom.c ****     Schedule the generic
1493:common/prog/FuncSafe/fsCom.c **** ======================================================================*/
1494:common/prog/FuncSafe/fsCom.c ****       case (uint8_t)FSF_SCH_GENERIC:
1495:common/prog/FuncSafe/fsCom.c ****       {
1496:common/prog/FuncSafe/fsCom.c ****          //  Maintain the check cycle counter.
1497:common/prog/FuncSafe/fsCom.c ****          (void)bMaintainCheckCycleTimer();
1498:common/prog/FuncSafe/fsCom.c ****          // Walk through all channels that are actually configured
1499:common/prog/FuncSafe/fsCom.c ****          for (ucCurrentChannel = (uint8_t)FSF_REG_TEST;
1500:common/prog/FuncSafe/fsCom.c ****               ucCurrentChannel < (uint8_t)FSF_ucNrOfChannels;
1501:common/prog/FuncSafe/fsCom.c ****               ucCurrentChannel++)
1502:common/prog/FuncSafe/fsCom.c ****          {
1503:common/prog/FuncSafe/fsCom.c ****             FSF_ucRetVal = ucComHandleTask(ucCurrentChannel);
1504:common/prog/FuncSafe/fsCom.c ****             if (FSF_ucRetVal != (uint8_t)TASK_INITIALISED)
1505:common/prog/FuncSafe/fsCom.c ****             {
1506:common/prog/FuncSafe/fsCom.c ****                break;
1507:common/prog/FuncSafe/fsCom.c ****                //  Msg(2:0769) This break statement terminates an iteration statement.
1508:common/prog/FuncSafe/fsCom.c ****                //  PCA comment: desired state and better readable in X32, code tested and reviewed 
1509:common/prog/FuncSafe/fsCom.c **** 
1510:common/prog/FuncSafe/fsCom.c ****             }
1511:common/prog/FuncSafe/fsCom.c ****          }
1512:common/prog/FuncSafe/fsCom.c ****          //  Finally, trigger the external watchdog
1513:common/prog/FuncSafe/fsCom.c ****          vTriggerExtWatchdog();
1514:common/prog/FuncSafe/fsCom.c ****          break;
1515:common/prog/FuncSafe/fsCom.c ****       }
1516:common/prog/FuncSafe/fsCom.c ****       default:
1517:common/prog/FuncSafe/fsCom.c ****       {
1518:common/prog/FuncSafe/fsCom.c **** /*======================================================================
1519:common/prog/FuncSafe/fsCom.c ****     Task state accidently overwritten!
1520:common/prog/FuncSafe/fsCom.c **** ======================================================================*/
1521:common/prog/FuncSafe/fsCom.c ****          // No other operating state allowed for FSCOM
1522:common/prog/FuncSafe/fsCom.c ****          vExtApplicationErrorNotify((uint8_t)FSF_ERR_INVALID_STATE, (uint8_t)FSF_NOT_SPECIFIED_CHAN
1523:common/prog/FuncSafe/fsCom.c ****          break;
1524:common/prog/FuncSafe/fsCom.c ****       }
1525:common/prog/FuncSafe/fsCom.c ****    }
1526:common/prog/FuncSafe/fsCom.c ****    //  Service the internal watchdog
1527:common/prog/FuncSafe/fsCom.c ****    vExtTriggerInternalWatchdog();
1528:common/prog/FuncSafe/fsCom.c **** 
1529:common/prog/FuncSafe/fsCom.c ****    /* calc new checksum at exit of task handler */
1530:common/prog/FuncSafe/fsCom.c ****    _FSF_RAM_CON_vDoUpdateCheckInFsComModule();
1531:common/prog/FuncSafe/fsCom.c **** 
1532:common/prog/FuncSafe/fsCom.c ****    return FSF_ucRetVal;
1533:common/prog/FuncSafe/fsCom.c **** }
1534:common/prog/FuncSafe/fsCom.c **** 
1535:common/prog/FuncSafe/fsCom.c **** //  Following interface is exported for systems that make use of the real scheduler
1536:common/prog/FuncSafe/fsCom.c **** //  component. It is NOT called from within the functional safety component! Instead,
1537:common/prog/FuncSafe/fsCom.c **** //  it is assumed the functional safety component gets executed by the scheduler component.
1538:common/prog/FuncSafe/fsCom.c **** 
