 229:common/prog/FuncSafe/fsCom.c **** STATIC   uint8_t    ucCurrentChannel    = (uint8_t)FSF_FIRST_APPL_TEST; //!< Current channel about 
 230:common/prog/FuncSafe/fsCom.c **** STATIC   uint8_t    ucSchedState        = (uint8_t)FSF_SCH_INITIALISE;  //!< After startup
 231:common/prog/FuncSafe/fsCom.c **** STATIC   uint8_t    FSF_ucRetVal        = (uint8_t)TASK_NOT_INITIALISED; //!< Return value from las
 232:common/prog/FuncSafe/fsCom.c **** 
 233:common/prog/FuncSafe/fsCom.c **** #ifdef  FSF_TIMHISTORY
 234:common/prog/FuncSafe/fsCom.c **** //  The timing history:
