 183:common/prog/FuncSafe/fsCom.c **** 
 184:common/prog/FuncSafe/fsCom.c **** //  Test support
 185:common/prog/FuncSafe/fsCom.c **** 
 186:common/prog/FuncSafe/fsCom.c **** //  This switch allows to call functions, that are part of the FSCOM generic, separately. When set,
 187:common/prog/FuncSafe/fsCom.c **** //  the FSCOM task handler acts as a test server, and does not supervise associated channels.
 188:common/prog/FuncSafe/fsCom.c **** //  For timing measurement FSCOM mainly depends on the interface TIM_uiGetCircleMicroSeconds.
 189:common/prog/FuncSafe/fsCom.c **** //  In order to run the FSCOM's task handler, the system must be run in its operational state.
 190:common/prog/FuncSafe/fsCom.c **** //  Under test conditions, the FSCOM is scheduled continuouesly but TASK_NOT_INITIALISED will be
 191:common/prog/FuncSafe/fsCom.c **** //  returned in all cases. Channels have been defined to be dependent on the state of the FSCOM.
 192:common/prog/FuncSafe/fsCom.c **** //  Due to the value returned back to the scheduler, channels will never be scheduled, so the
 193:common/prog/FuncSafe/fsCom.c **** //  test harness is free to activate and test the channels.
 194:common/prog/FuncSafe/fsCom.c **** #ifdef  TH_FSCOM
 195:common/prog/FuncSafe/fsCom.c **** //  Used to external watchdog conditions
 196:common/prog/FuncSafe/fsCom.c **** uint8_t    TH_FSF_ExtWatchdogState = (uint16_t)0;
 197:common/prog/FuncSafe/fsCom.c **** //  Used to create timing conditions
 198:common/prog/FuncSafe/fsCom.c **** uint8_t    TH_FSF_Circle256MicroSeconds = (uint8_t)0;
 199:common/prog/FuncSafe/fsCom.c **** //  Used to create timing conditions
 200:common/prog/FuncSafe/fsCom.c **** uint16_t   TH_FSF_CircleMicroSeconds = (uint16_t)0;
 201:common/prog/FuncSafe/fsCom.c **** //  Test harness function to be executed by the next step.
 202:common/prog/FuncSafe/fsCom.c **** //  Zero means, no function to execute.
 203:common/prog/FuncSafe/fsCom.c **** uint8_t    TH_FSF_Function = (uint8_t)0;
 204:common/prog/FuncSafe/fsCom.c **** //  Parameter passed in this test step
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 5


 205:common/prog/FuncSafe/fsCom.c **** uint8_t    TH_FSF_InPar[TH_PAR_SIZE]  = {0};
 206:common/prog/FuncSafe/fsCom.c **** //  In-Stack Pointer
 207:common/prog/FuncSafe/fsCom.c **** uint8_t    TH_FSF_InSP = (uint8_t)0;
 208:common/prog/FuncSafe/fsCom.c **** //  Return vector stored on test step completion
