 708:common/prog/FuncSafe/fsCom.c **** STATIC  bool    bIsChannelCycleOverdue(uint8_t ucCheckId)
 709:common/prog/FuncSafe/fsCom.c **** {
 710:common/prog/FuncSafe/fsCom.c ****    //  Some channels get scheduled on a regular base, but they don't want to be supervised
 711:common/prog/FuncSafe/fsCom.c ****    //  In that case, configurable values have been set to zero
 712:common/prog/FuncSafe/fsCom.c **** 
 713:common/prog/FuncSafe/fsCom.c ****    //  Use pointers, this will improve access and save code space.
 714:common/prog/FuncSafe/fsCom.c ****    T_FSCOM_CheckCycle FSTH_CONST * p = (T_FSCOM_CheckCycle FSTH_CONST *)(FSTH_CONST void*)(&FSF_psC
 715:common/prog/FuncSafe/fsCom.c ****    T_FSCOM_CheckCycle * q = (T_FSCOM_CheckCycle *)(void*)(&FSF_sCH_CheckCycleTime[ucCheckId]); /*li
 716:common/prog/FuncSafe/fsCom.c **** 
 717:common/prog/FuncSafe/fsCom.c ****    // Does the actual channel use check cycle supervision?
 718:common/prog/FuncSafe/fsCom.c ****    if (p->ui16CheckCycleTime != (uint16_t)0)
 719:common/prog/FuncSafe/fsCom.c ****    {
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 15


 720:common/prog/FuncSafe/fsCom.c ****       // Yes. Does the actual channel have sufficient packets?
 721:common/prog/FuncSafe/fsCom.c ****       if(q->ui16CheckCycleTime >= (uint16_t)(FS_COM_RamConBlock.ucCCElapsedCounter))
 722:common/prog/FuncSafe/fsCom.c ****       {
 723:common/prog/FuncSafe/fsCom.c ****          // Yes. Simply count down the packets
 724:common/prog/FuncSafe/fsCom.c ****          q->ui16CheckCycleTime -= (uint16_t)FS_COM_RamConBlock.ucCCElapsedCounter;
 725:common/prog/FuncSafe/fsCom.c ****       }
 726:common/prog/FuncSafe/fsCom.c ****       else
 727:common/prog/FuncSafe/fsCom.c ****       {
 728:common/prog/FuncSafe/fsCom.c ****          //  NO. Reload the packet again
 729:common/prog/FuncSafe/fsCom.c ****          q->ui16CheckCycleTime = p->ui16CheckCycleTime;
 730:common/prog/FuncSafe/fsCom.c ****          // No. Does the actual channels still have more packets
 731:common/prog/FuncSafe/fsCom.c ****          if (q->ucCycleMultiplier == (uint8_t)0)
 732:common/prog/FuncSafe/fsCom.c ****          {
 733:common/prog/FuncSafe/fsCom.c ****             //  No. Check cycle elapsed before success.
 734:common/prog/FuncSafe/fsCom.c ****             //  Reload the packet multiplier again
 735:common/prog/FuncSafe/fsCom.c ****             q->ucCycleMultiplier = p->ucCycleMultiplier;
 736:common/prog/FuncSafe/fsCom.c ****             //  Signal this event up to the caller
 737:common/prog/FuncSafe/fsCom.c ****             return true;
 738:common/prog/FuncSafe/fsCom.c ****          }
 739:common/prog/FuncSafe/fsCom.c ****          else
 740:common/prog/FuncSafe/fsCom.c ****          {
 741:common/prog/FuncSafe/fsCom.c ****             //  Yes. Go on counting down the packets already left...
 742:common/prog/FuncSafe/fsCom.c ****             q->ucCycleMultiplier--;
 743:common/prog/FuncSafe/fsCom.c ****          }
 744:common/prog/FuncSafe/fsCom.c ****       }
 745:common/prog/FuncSafe/fsCom.c ****    }
 746:common/prog/FuncSafe/fsCom.c ****    return false;
 747:common/prog/FuncSafe/fsCom.c **** }
