1054:common/prog/FuncSafe/fsCom.c **** /* external function definitions ******************************************************************
1055:common/prog/FuncSafe/fsCom.c **** 
1056:common/prog/FuncSafe/fsCom.c **** /* FSCOM BOOT FUNCTIONS ***************************************************************************
1057:common/prog/FuncSafe/fsCom.c **** 
1058:common/prog/FuncSafe/fsCom.c **** //@{\name FSCOM exported boot services
1059:common/prog/FuncSafe/fsCom.c **** /** Start of the FSCOM boot phase.
1060:common/prog/FuncSafe/fsCom.c **** 
1061:common/prog/FuncSafe/fsCom.c ****     This 1st activation of FSCOM is reserved in order to perform all one-time checks,
1062:common/prog/FuncSafe/fsCom.c ****     which are destructive. At the end, FSCOM performs initialisation of its internal
1063:common/prog/FuncSafe/fsCom.c ****     data structures. This service is NOT allowed to use during regular scheduling by
1064:common/prog/FuncSafe/fsCom.c ****     the scheduler component, as RAM is a resource, which is to be checked for the
1065:common/prog/FuncSafe/fsCom.c ****     whole system. Using this service as soon as the system has reached its operational
1066:common/prog/FuncSafe/fsCom.c ****     state would be too late. This service may NOT be called, as this would require the
1067:common/prog/FuncSafe/fsCom.c ****     stack that can't be assumed to be functional before completion of the RAM check.
1068:common/prog/FuncSafe/fsCom.c **** 
1069:common/prog/FuncSafe/fsCom.c ****     \pre    The stack pointer MUST be set on a valid range\n
1070:common/prog/FuncSafe/fsCom.c ****     \post   All one-time checks have been performed successfully, that is the one-time
1071:common/prog/FuncSafe/fsCom.c ****             Register check and the one-time RAM check.\n
1072:common/prog/FuncSafe/fsCom.c ****     \note   This is added mainly for completeness. FSF_vBoot is only allowed to be called by
1073:common/prog/FuncSafe/fsCom.c ****             immediate transfer of control, that is by GOTO or JUMP instruction as the stack
1074:common/prog/FuncSafe/fsCom.c ****             can't be assumed to be functional before check. On completion, the start process
1075:common/prog/FuncSafe/fsCom.c ****             has to be continued by usual function call. The return address gets lost. This
1076:common/prog/FuncSafe/fsCom.c ****             doesn't matter as there is no return allowed back into the boot process.\n
1077:common/prog/FuncSafe/fsCom.c **** */
1078:common/prog/FuncSafe/fsCom.c **** 
1079:common/prog/FuncSafe/fsCom.c **** /*-----------------------------------------------------------------------
1080:common/prog/FuncSafe/fsCom.c ****   Control Flow:
1081:common/prog/FuncSafe/fsCom.c ****   Begin
1082:common/prog/FuncSafe/fsCom.c ****       the boot procedure requires to stop processing of timers and interrupts.\n
1083:common/prog/FuncSafe/fsCom.c ****       This is guaranteed this service FSCOM service is called at boot time\
1084:common/prog/FuncSafe/fsCom.c ****       where interrupts and timers can't be processed that early moment in time;\n
1085:common/prog/FuncSafe/fsCom.c **** 
1086:common/prog/FuncSafe/fsCom.c ****       do the Register check;
1087:common/prog/FuncSafe/fsCom.c **** 
1088:common/prog/FuncSafe/fsCom.c ****       do the RAM check;
1089:common/prog/FuncSafe/fsCom.c **** 
1090:common/prog/FuncSafe/fsCom.c ****       do all other one-time checks;
1091:common/prog/FuncSafe/fsCom.c **** 
1092:common/prog/FuncSafe/fsCom.c ****       change FSCOM state into BOOTED;
1093:common/prog/FuncSafe/fsCom.c **** 
1094:common/prog/FuncSafe/fsCom.c ****       continue start up;
1095:common/prog/FuncSafe/fsCom.c **** 
1096:common/prog/FuncSafe/fsCom.c ****       To be considered:
1097:common/prog/FuncSafe/fsCom.c ****       1.) an application shall not return to this point. If so, a fatal exception is
1098:common/prog/FuncSafe/fsCom.c ****       created.
1099:common/prog/FuncSafe/fsCom.c ****       2.) according ANSI-C the whole dynamic data area is filled with zero.
1100:common/prog/FuncSafe/fsCom.c ****       Hence, channels are then all idle and the FSCOM remains in state BOOTED.
1101:common/prog/FuncSafe/fsCom.c ****   End
1102:common/prog/FuncSafe/fsCom.c **** 
1103:common/prog/FuncSafe/fsCom.c **** 
1104:common/prog/FuncSafe/fsCom.c **** -------------------------------------------------------------------------*/
1105:common/prog/FuncSafe/fsCom.c **** #ifdef TH_FSCOM
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccjsfxRg.s 			page 30


1106:common/prog/FuncSafe/fsCom.c **** void    FSF_vBoot(void)
1107:common/prog/FuncSafe/fsCom.c **** {
1108:common/prog/FuncSafe/fsCom.c ****    //  Continue the systems start up procedure.
1109:common/prog/FuncSafe/fsCom.c ****    _FSF_vApplicationStartUp();
1110:common/prog/FuncSafe/fsCom.c ****    //  Under test conditions, the library runs fully isolated from the
1111:common/prog/FuncSafe/fsCom.c ****    //  environment, except some basic control structures, like boot tec..
1112:common/prog/FuncSafe/fsCom.c ****    //  So, return control immediately, do nothing else!
1113:common/prog/FuncSafe/fsCom.c **** }
1114:common/prog/FuncSafe/fsCom.c **** void    vExtBoot(void)
1115:common/prog/FuncSafe/fsCom.c **** #else
1116:common/prog/FuncSafe/fsCom.c **** void    FSF_vBoot(void)
1117:common/prog/FuncSafe/fsCom.c **** #endif
