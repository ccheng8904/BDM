 769:common/prog/FuncSafe/fsCom.c ****       {
 770:common/prog/FuncSafe/fsCom.c ****          // Success flag not set. Hence, returning state either ongoing or idle
 771:common/prog/FuncSafe/fsCom.c ****          if (bIsOngoing != false)
