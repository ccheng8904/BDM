 817:common/prog/FuncSafe/fsCom.c ****    if ((schar)FSF_ucCheckCycleTimer < (schar)0)
 818:common/prog/FuncSafe/fsCom.c ****    {
 819:common/prog/FuncSafe/fsCom.c ****       FSF_ucCheckCycleTimer = (uint8_t)FSF_CHECK_CYCLE_TIME;
 820:common/prog/FuncSafe/fsCom.c **** #endif
 821:common/prog/FuncSafe/fsCom.c ****       // Count the number of cycle time packets elapsed since last measurement
 822:common/prog/FuncSafe/fsCom.c ****       FS_COM_RamConBlock.ucCCElapsedCounter++;
