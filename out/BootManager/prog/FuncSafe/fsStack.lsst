 166:common/prog/FuncSafe/fsStack.c **** /* static function definitions ********************************************************************
 167:common/prog/FuncSafe/fsStack.c **** 
 168:common/prog/FuncSafe/fsStack.c **** /**
 169:common/prog/FuncSafe/fsStack.c ****    The stack channel initializer
 170:common/prog/FuncSafe/fsStack.c **** <pre>
 171:common/prog/FuncSafe/fsStack.c ****    --------------------------------------------------------------------------
 172:common/prog/FuncSafe/fsStack.c ****    This stack channel requires local variables to be placed on the hardware
 173:common/prog/FuncSafe/fsStack.c ****    stack. For the time being, the so called "compiled stack" is not supported
 174:common/prog/FuncSafe/fsStack.c ****    --------------------------------------------------------------------------
 175:common/prog/FuncSafe/fsStack.c **** </pre>
 176:common/prog/FuncSafe/fsStack.c ****    This initializer writes two magic numbers. 16-Bit values are used in order to get better
 177:common/prog/FuncSafe/fsStack.c ****    recognition, if the stack has been overwritten or the stack pointer was out of its
 178:common/prog/FuncSafe/fsStack.c ****    pre-defined area. The whole stack is considered a character-based array its location
 179:common/prog/FuncSafe/fsStack.c ****    and size is determined by an application. Due to the word-sized vaules written in the stack
 180:common/prog/FuncSafe/fsStack.c ****    its length will be reduced by 4 bytes. If problems occurre due to this reduction, the stack
 181:common/prog/FuncSafe/fsStack.c ****    is basically considered too small and has to be increased by the application. Usually, the
 182:common/prog/FuncSafe/fsStack.c ****    first stack entry is written when calling main at the end of the startup routine. Since
 183:common/prog/FuncSafe/fsStack.c ****    there shall no return to this point, as there is no application related functionality there,
 184:common/prog/FuncSafe/fsStack.c ****    its possible to overwrite this return address by the magic entries. The last two bytes are
 185:common/prog/FuncSafe/fsStack.c ****    of no problem, i assume.
 186:common/prog/FuncSafe/fsStack.c ****     \return   bool
 187:common/prog/FuncSafe/fsStack.c ****     \pre      Location and size of the stack provided correctly.
 188:common/prog/FuncSafe/fsStack.c ****     \post     Magic numbers written correctly. Current stack pointer content checked correctly.
 189:common/prog/FuncSafe/fsStack.c **** */
 190:common/prog/FuncSafe/fsStack.c **** STATIC  void    vInitialzeStack(void)
 191:common/prog/FuncSafe/fsStack.c **** {
 192:common/prog/FuncSafe/fsStack.c ****    //  Ask the application to return the stack pointer
 193:common/prog/FuncSafe/fsStack.c ****    const uint16_t * pucP       = (uint16_t *)((uint32_t)pucGetStackPointer(ucActualStack)); /*lint 
 194:common/prog/FuncSafe/fsStack.c ****    uint16_t * pStBegin   = _FSF_Stack[ucActualStack].pui16FirstEntry;
 195:common/prog/FuncSafe/fsStack.c ****    uint16_t * pStEnd     = _FSF_Stack[ucActualStack].pui16LastEntry;
 196:common/prog/FuncSafe/fsStack.c ****    //  First of all, make sure the stack pointer is pointing into the stack,
 197:common/prog/FuncSafe/fsStack.c ****    //  otherwise it does not make sense to continue.
 198:common/prog/FuncSafe/fsStack.c ****    if ((pucP > pStBegin) && (pucP < pStEnd)) /*lint !e946 Relational or subtract operator applied t
 199:common/prog/FuncSafe/fsStack.c ****    {
 200:common/prog/FuncSafe/fsStack.c ****       // Place the magic numbers at the beginning ...
 201:common/prog/FuncSafe/fsStack.c ****       *pStBegin = _FSF_ui16StackMagic;
 202:common/prog/FuncSafe/fsStack.c ****       // and at the end too
 203:common/prog/FuncSafe/fsStack.c ****       *pStEnd = _FSF_ui16StackMagic;
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccIYNlI0.s 			page 5


 204:common/prog/FuncSafe/fsStack.c ****       FSF_vReportOnGoing((uint8_t)FSF_STACK_TEST);
 205:common/prog/FuncSafe/fsStack.c **** /*    TP_FSF_STACK_Initialised_Correctly */
 206:common/prog/FuncSafe/fsStack.c **** #ifdef TH_FSCOM
 207:common/prog/FuncSafe/fsStack.c ****       TH_FSFP_PushOutPar(TP_FSF_STACK_Initialised_Correctly);
 208:common/prog/FuncSafe/fsStack.c **** #endif
 209:common/prog/FuncSafe/fsStack.c ****    }
 210:common/prog/FuncSafe/fsStack.c ****    else
 211:common/prog/FuncSafe/fsStack.c ****    {
 212:common/prog/FuncSafe/fsStack.c ****       FSF_vReportError((uint8_t)FSF_STACK_TEST,(uint8_t)FSF_ERR_CHANNEL_ERROR,(uint8_t)0);
 213:common/prog/FuncSafe/fsStack.c ****    }
 214:common/prog/FuncSafe/fsStack.c **** }
 215:common/prog/FuncSafe/fsStack.c **** 
 216:common/prog/FuncSafe/fsStack.c **** /**
 217:common/prog/FuncSafe/fsStack.c ****    Return the actual stack pointer
 218:common/prog/FuncSafe/fsStack.c **** <pre>
 219:common/prog/FuncSafe/fsStack.c ****    --------------------------------------------------------------------------
 220:common/prog/FuncSafe/fsStack.c ****    This stack channel requires local variables to be placed on the hardware
 221:common/prog/FuncSafe/fsStack.c ****    stack. For the time being, the so called "compiled stack" is not supported
 222:common/prog/FuncSafe/fsStack.c ****    --------------------------------------------------------------------------
 223:common/prog/FuncSafe/fsStack.c **** </pre>
 224:common/prog/FuncSafe/fsStack.c ****     This observer returns the actual position of the stack pointer. Performing certain tasks
 225:common/prog/FuncSafe/fsStack.c ****     in order to manipulate the stack pointer for test would result into more or less nonportable
 226:common/prog/FuncSafe/fsStack.c ****     solutions, especially when testing the same piece of code and for different environments.
 227:common/prog/FuncSafe/fsStack.c ****     Thus, for test harness purposes this value can be read from a reserved location.
 228:common/prog/FuncSafe/fsStack.c **** 
 229:common/prog/FuncSafe/fsStack.c ****     To be noticed: due to the preconditions above, for single stack configurations, only the
 230:common/prog/FuncSafe/fsStack.c ****     address of an stack-located variable is returned. Its physical location will be some bytes
 231:common/prog/FuncSafe/fsStack.c ****     deeeper inside the stack, as it is placed within the new stack frame of the called observer.
 232:common/prog/FuncSafe/fsStack.c ****     Re-alignement is not done, as this would involve some porting problems due to different
 233:common/prog/FuncSafe/fsStack.c ****     stack frame structures.
 234:common/prog/FuncSafe/fsStack.c ****     For multiple stack configurations (i.e. separation into program stack and interrupt stack),
 235:common/prog/FuncSafe/fsStack.c ****     the mechanism as described foregoing will not functions, so an application has to provide
 236:common/prog/FuncSafe/fsStack.c ****     its own mechanism.
 237:common/prog/FuncSafe/fsStack.c **** 
 238:common/prog/FuncSafe/fsStack.c ****     \param    index of stack actually considered
 239:common/prog/FuncSafe/fsStack.c ****     \return   actual location of the stack pointer
 240:common/prog/FuncSafe/fsStack.c ****     \pre      Location and size of the stack provided correctly.
 241:common/prog/FuncSafe/fsStack.c ****     \post     Magic numbers written correctly. Current stack pointer content checked correctly.
 242:common/prog/FuncSafe/fsStack.c **** */
 243:common/prog/FuncSafe/fsStack.c **** STATIC  uint8_t * pucGetStackPointer (uint8_t ucStackIndex)
 244:common/prog/FuncSafe/fsStack.c **** {
 245:common/prog/FuncSafe/fsStack.c ****     (void)ucStackIndex;
 246:common/prog/FuncSafe/fsStack.c **** #ifdef  TH_FSCOM
 247:common/prog/FuncSafe/fsStack.c ****    TH_FSFP_PushOutPar(ucStackIndex);
 248:common/prog/FuncSafe/fsStack.c **** 
 249:common/prog/FuncSafe/fsStack.c ****    if (ucStackIndex)
 250:common/prog/FuncSafe/fsStack.c ****    {
 251:common/prog/FuncSafe/fsStack.c ****       return TH_FSF_StackPointer_1;
 252:common/prog/FuncSafe/fsStack.c ****    }
 253:common/prog/FuncSafe/fsStack.c ****    else
 254:common/prog/FuncSafe/fsStack.c ****    {
 255:common/prog/FuncSafe/fsStack.c ****       return TH_FSF_StackPointer_0;
 256:common/prog/FuncSafe/fsStack.c ****    }
 257:common/prog/FuncSafe/fsStack.c **** #else
 258:common/prog/FuncSafe/fsStack.c **** #ifdef MULTIPLE_STACK
 259:common/prog/FuncSafe/fsStack.c ****    return  _FSF_pucGetStackPointer(ucStackIndex);
 260:common/prog/FuncSafe/fsStack.c **** #else
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccIYNlI0.s 			page 6


 261:common/prog/FuncSafe/fsStack.c ****    return  _FSF_pucGetStackPointer();
 262:common/prog/FuncSafe/fsStack.c **** #endif
 263:common/prog/FuncSafe/fsStack.c **** #endif
 264:common/prog/FuncSafe/fsStack.c **** }
 265:common/prog/FuncSafe/fsStack.c **** 
 266:common/prog/FuncSafe/fsStack.c **** /**
 267:common/prog/FuncSafe/fsStack.c ****     In multiple stack configurations, this function provide the means to return the
 268:common/prog/FuncSafe/fsStack.c ****     number of existing stacks. In signle stack configurations, this function has no
 269:common/prog/FuncSafe/fsStack.c ****     meaning. As such, it will be removed by the optimizer.
 270:common/prog/FuncSafe/fsStack.c **** 
 271:common/prog/FuncSafe/fsStack.c ****     \return   number of existing stacks
 272:common/prog/FuncSafe/fsStack.c **** */
 273:common/prog/FuncSafe/fsStack.c **** STATIC  uint8_t   ucGetStackCount (void)
 274:common/prog/FuncSafe/fsStack.c **** {
 275:common/prog/FuncSafe/fsStack.c **** #ifdef MULTIPLE_STACK
 276:common/prog/FuncSafe/fsStack.c **** #ifdef TH_FSCOM
 277:common/prog/FuncSafe/fsStack.c ****    //  Only create a test point without calling the application
 278:common/prog/FuncSafe/fsStack.c ****    TH_FSFP_PushOutPar(TP_FSF_STACK_GetStackCount);
 279:common/prog/FuncSafe/fsStack.c ****    TH_FSFP_PushOutPar(TH_ucStackCount);
 280:common/prog/FuncSafe/fsStack.c ****    return TH_ucStackCount;
 281:common/prog/FuncSafe/fsStack.c **** #else
 282:common/prog/FuncSafe/fsStack.c ****    //  Observe the application
 283:common/prog/FuncSafe/fsStack.c ****    //  stack count
 284:common/prog/FuncSafe/fsStack.c ****    return _FSF_ucGetStackCount();
 285:common/prog/FuncSafe/fsStack.c **** #endif
 286:common/prog/FuncSafe/fsStack.c **** #else
 287:common/prog/FuncSafe/fsStack.c ****    // Single stack configurations have only 1 stack
 288:common/prog/FuncSafe/fsStack.c ****    return NUMBER_OF_STACKS;
 289:common/prog/FuncSafe/fsStack.c **** #endif
 290:common/prog/FuncSafe/fsStack.c **** }
 291:common/prog/FuncSafe/fsStack.c **** 
 292:common/prog/FuncSafe/fsStack.c **** 
 293:common/prog/FuncSafe/fsStack.c **** /* external function definitions ******************************************************************
 294:common/prog/FuncSafe/fsStack.c **** 
 295:common/prog/FuncSafe/fsStack.c **** /**
 296:common/prog/FuncSafe/fsStack.c ****     The stack channel pre-condition
