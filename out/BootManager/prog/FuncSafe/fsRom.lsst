 521:common/prog/FuncSafe/fsRom.c ****                //  The ROM channel has completed one full ROM check.
 522:common/prog/FuncSafe/fsRom.c ****                vFinalizeROMCheck();
 523:common/prog/FuncSafe/fsRom.c ****                //  Some configurations want to check the ROM space only once.
 524:common/prog/FuncSafe/fsRom.c ****                if (bIsROMAtOnce() != false)
 525:common/prog/FuncSafe/fsRom.c ****                {
 526:common/prog/FuncSafe/fsRom.c ****                   //  ROM check has finished
 527:common/prog/FuncSafe/fsRom.c ****                   FS_ROM_RamConBlock.ucROMTState = (uint8_t)FSF_ROM_CHECK_FINISH;
 528:common/prog/FuncSafe/fsRom.c ****                }
 529:common/prog/FuncSafe/fsRom.c ****                else
 530:common/prog/FuncSafe/fsRom.c ****                {
 531:common/prog/FuncSafe/fsRom.c ****                   // Re-Initialise the work area (again)
 532:common/prog/FuncSafe/fsRom.c ****                   FS_ROM_RamConBlock.ucROMTState = (uint8_t)FSF_ROM_CHECK_RESTART;
 533:common/prog/FuncSafe/fsRom.c ****                }
 534:common/prog/FuncSafe/fsRom.c ****             }
 535:common/prog/FuncSafe/fsRom.c ****          }
 536:common/prog/FuncSafe/fsRom.c ****          else
 537:common/prog/FuncSafe/fsRom.c ****          {
 538:common/prog/FuncSafe/fsRom.c **** 
 539:common/prog/FuncSafe/fsRom.c **** //  Testpoint "ROM not ready"
 540:common/prog/FuncSafe/fsRom.c **** #ifdef TH_FSCOM
 541:common/prog/FuncSafe/fsRom.c ****             TH_FSFP_PushOutPar(TP_FSF_ROM_Not_Ready);
 542:common/prog/FuncSafe/fsRom.c **** #endif
 543:common/prog/FuncSafe/fsRom.c ****          }
 544:common/prog/FuncSafe/fsRom.c ****          break;
 545:common/prog/FuncSafe/fsRom.c ****       }
 546:common/prog/FuncSafe/fsRom.c ****       case (uint8_t)FSF_ROM_CHECK_FINISH:
 547:common/prog/FuncSafe/fsRom.c ****       {
 548:common/prog/FuncSafe/fsRom.c **** /*======================================================================
 549:common/prog/FuncSafe/fsRom.c ****     ROM Check Finished
 550:common/prog/FuncSafe/fsRom.c **** ======================================================================*/
 551:common/prog/FuncSafe/fsRom.c ****          //  Report success. The ROM channel has completed one full ROM check.
 552:common/prog/FuncSafe/fsRom.c ****          vROMCheckSuccessfullyCompleted ();
 553:common/prog/FuncSafe/fsRom.c ****          break;
 554:common/prog/FuncSafe/fsRom.c ****       }
 555:common/prog/FuncSafe/fsRom.c ****       default:
 556:common/prog/FuncSafe/fsRom.c ****       {
 557:common/prog/FuncSafe/fsRom.c **** /*======================================================================
 558:common/prog/FuncSafe/fsRom.c ****     Report Error due to invalid state
 559:common/prog/FuncSafe/fsRom.c **** ======================================================================*/
 560:common/prog/FuncSafe/fsRom.c ****          FSF_vReportError((uint8_t)FSF_ROM_TEST,(uint8_t)FSF_ERR_INVALID_STATE,(uint8_t)0);
 561:common/prog/FuncSafe/fsRom.c ****          break;
 562:common/prog/FuncSafe/fsRom.c ****       }
 563:common/prog/FuncSafe/fsRom.c ****    }
 564:common/prog/FuncSafe/fsRom.c **** 
 565:common/prog/FuncSafe/fsRom.c ****    return  (uint8_t)TASK_INITIALISED;
 566:common/prog/FuncSafe/fsRom.c **** }
