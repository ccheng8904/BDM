 752:common/prog/FuncSafe/fsRom.c **** 
 753:common/prog/FuncSafe/fsRom.c **** /** While checking the ROM at once, this interface decides if interrupts get maintained or not.
 754:common/prog/FuncSafe/fsRom.c ****     This is mainly intended due to performance reasons. While checking the ROM without maintaining
 755:common/prog/FuncSafe/fsRom.c ****     the interrupts, some overflow conditions may occurre. Otherwise, maintaining a huge number of
 756:common/prog/FuncSafe/fsRom.c ****     interrupt sources is time consuming, hence it will lengthen the whole ROM check time. So, by
 757:common/prog/FuncSafe/fsRom.c ****     this interface, the user has the ability to decide whether to maintain the interrupts or not.
 758:common/prog/FuncSafe/fsRom.c ****     The ROM channel internally provide this interface and it returns true by default. This interfac
 759:common/prog/FuncSafe/fsRom.c ****     may be overloaded, if necessary. As an example: if interrupts need to be  maintained at least
 760:common/prog/FuncSafe/fsRom.c ****     once every second, and checking the whole ROM space at once takes only half a second, in that
 761:common/prog/FuncSafe/fsRom.c ****     case there is no need to maintain the interrupt sources while checking.\n
 762:common/prog/FuncSafe/fsRom.c **** 
 763:common/prog/FuncSafe/fsRom.c ****     \param      none\n
 764:common/prog/FuncSafe/fsRom.c ****     \return     true, if interrupts have to maintain, false otherwise.
 765:common/prog/FuncSafe/fsRom.c **** 
 766:common/prog/FuncSafe/fsRom.c ****     \pre        Called only at operational time.\n
 767:common/prog/FuncSafe/fsRom.c **** 
 768:common/prog/FuncSafe/fsRom.c ****     \note       Overloading is not designed here, as this is up to an application. \n
 769:common/prog/FuncSafe/fsRom.c **** */
 770:common/prog/FuncSafe/fsRom.c **** 
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\cc6jOYUR.s 			page 28


 771:common/prog/FuncSafe/fsRom.c **** STATIC  bool    bCheckINTduringROMCheck     (void)
 772:common/prog/FuncSafe/fsRom.c **** {
 773:common/prog/FuncSafe/fsRom.c **** #ifdef TH_FSCOM
 774:common/prog/FuncSafe/fsRom.c ****    return   TH_FSF_bCheckINTduringROMCheck;
 775:common/prog/FuncSafe/fsRom.c **** #else
 776:common/prog/FuncSafe/fsRom.c ****    return  _FSF_bCheckINTduringROMCheck();
 777:common/prog/FuncSafe/fsRom.c **** #endif
 778:common/prog/FuncSafe/fsRom.c **** }
 779:common/prog/FuncSafe/fsRom.c **** 
