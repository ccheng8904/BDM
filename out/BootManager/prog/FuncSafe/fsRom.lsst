 802:common/prog/FuncSafe/fsRom.c ****    //  Ask the application, if the ROM check is allowed to start. Do it only once per full check!
 803:common/prog/FuncSafe/fsRom.c ****    //  Thus, the application is asked in state FSF_ROM_CHECK_RESTART. In case of refusal, do not
 804:common/prog/FuncSafe/fsRom.c ****    //  start so the state of the channel remains unchanged. Instaed ask the application again.
 805:common/prog/FuncSafe/fsRom.c ****    if (FS_ROM_RamConBlock.ucROMTState == (uint8_t)FSF_ROM_CHECK_RESTART)
 806:common/prog/FuncSafe/fsRom.c ****    {
 807:common/prog/FuncSafe/fsRom.c ****       if (bIsROMAtOnceAllowed() == false)
 808:common/prog/FuncSafe/fsRom.c ****       {
 809:common/prog/FuncSafe/fsRom.c ****          //  Notify to the generic that the ROM channel is keeping alive. Otherwise, an idle error
 810:common/prog/FuncSafe/fsRom.c ****          //  get created by the channel itself.
 811:common/prog/FuncSafe/fsRom.c ****          //  PCA, 04/07/2006: do not signal ongoing work, if the ROM check is not allowed actually,
 812:common/prog/FuncSafe/fsRom.c ****          //  this would produce a check completion overdue error. Instaed, signal succes.
 813:common/prog/FuncSafe/fsRom.c ****          vROMCheckSuccessfullyCompleted();
 814:common/prog/FuncSafe/fsRom.c **** 
 815:common/prog/FuncSafe/fsRom.c **** //  Testpoint "TP_FSF_ROM_Check_Refused"
 816:common/prog/FuncSafe/fsRom.c **** #ifdef TH_FSCOM
 817:common/prog/FuncSafe/fsRom.c ****          TH_FSFP_PushOutPar(TP_FSF_ROM_Check_Refused);
 818:common/prog/FuncSafe/fsRom.c **** #endif
 819:common/prog/FuncSafe/fsRom.c ****          //no secure data touched --> no calculation of checksum
 820:common/prog/FuncSafe/fsRom.c ****          return (uint8_t)TASK_INITIALISED;
 821:common/prog/FuncSafe/fsRom.c ****       }
 822:common/prog/FuncSafe/fsRom.c ****    }
 823:common/prog/FuncSafe/fsRom.c ****    if (bIsROMAtOnce() == false)
 824:common/prog/FuncSafe/fsRom.c ****    {
 825:common/prog/FuncSafe/fsRom.c **** /*======================================================================
 826:common/prog/FuncSafe/fsRom.c ****     Check the ROM piece by piece
 827:common/prog/FuncSafe/fsRom.c **** ======================================================================*/
 828:common/prog/FuncSafe/fsRom.c ****       /** If the ROM space is checked piece by piece, the internal ROM task handler get called cont
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\cc6jOYUR.s 			page 30


 829:common/prog/FuncSafe/fsRom.c ****       */
 830:common/prog/FuncSafe/fsRom.c **** 
 831:common/prog/FuncSafe/fsRom.c **** //  Testpoint "TP_FSF_ROM_Check_Fragmented"
 832:common/prog/FuncSafe/fsRom.c **** #ifdef TH_FSCOM
 833:common/prog/FuncSafe/fsRom.c ****       //  Does the ROM check restart (again)?
 834:common/prog/FuncSafe/fsRom.c ****       if (FS_ROM_RamConBlock.ucROMTState != (uint8_t)FSF_ROM_CHECK_FINISH)
 835:common/prog/FuncSafe/fsRom.c ****       {
 836:common/prog/FuncSafe/fsRom.c ****          TH_FSFP_PushOutPar(TP_FSF_ROM_Check_Fragmented);
