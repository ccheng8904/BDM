 272:common/prog/FuncSafe/fsRom.c ****         /** Setup the next ROM address.
 273:common/prog/FuncSafe/fsRom.c ****     Move on to the next ROM address. This handler directly changes the ROM channels work area. \n
 274:common/prog/FuncSafe/fsRom.c ****     Note:   the parameter passed describes the space of ROM already checked!! In order to make \n
 275:common/prog/FuncSafe/fsRom.c ****             sure the segment boundaries will be matched exactly, on return this procedure will \n
 276:common/prog/FuncSafe/fsRom.c ****             return the space left to be checked. Returning 0 means, no space left to be checked. \n
 277:common/prog/FuncSafe/fsRom.c **** 
 278:common/prog/FuncSafe/fsRom.c ****     \param      uint16_t  length of data actually calculated \n\n
 279:common/prog/FuncSafe/fsRom.c **** 
 280:common/prog/FuncSafe/fsRom.c ****     \return     uint16_t  space left to check inside actual segment. Some cases to distinguish:
 281:common/prog/FuncSafe/fsRom.c ****                         return value == length:     end of the ROM has not yet been reached. \n
 282:common/prog/FuncSafe/fsRom.c ****                         0 < return value < length:  end of ROM has been reached. \n
 283:common/prog/FuncSafe/fsRom.c ****                         return value == 0:          no more data to be checked \n
 284:common/prog/FuncSafe/fsRom.c **** 
 285:common/prog/FuncSafe/fsRom.c ****     \pre        Called only at operational time. \n
 286:common/prog/FuncSafe/fsRom.c ****     \post       ROM channel work area updated, if necessary \n
