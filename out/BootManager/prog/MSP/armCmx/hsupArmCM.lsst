 156:common/prog/MSP/armCmx/hsupArmCM.c **** /* Keil: HSUP_DelayClk(uint16 delay, uint32 clock)                                                *
 157:common/prog/MSP/armCmx/hsupArmCM.c **** /**************************************************************************************************
 158:common/prog/MSP/armCmx/hsupArmCM.c **** __asm void HSUP_DelayClk(uint16 delay, uint32 clock)
 159:common/prog/MSP/armCmx/hsupArmCM.c **** {
 160:common/prog/MSP/armCmx/hsupArmCM.c ****   #if defined(CORTEX_M0) || defined(CORTEX_M0_PLUS)
 161:common/prog/MSP/armCmx/hsupArmCM.c ****     #if defined(CLOCK_IN_KHZ)
 162:common/prog/MSP/armCmx/hsupArmCM.c ****         // following calculation will be done: r0 = delay * clock / 32000
 163:common/prog/MSP/armCmx/hsupArmCM.c ****         // to prevent overflow and division:
 164:common/prog/MSP/armCmx/hsupArmCM.c ****         // r0 = (((clock * 8389) / 65536) * delay) / 4096  (error < 50ppm)
 165:common/prog/MSP/armCmx/hsupArmCM.c ****         mov  r2,#8389     ; r2  = 8389
 166:common/prog/MSP/armCmx/hsupArmCM.c ****         muls r1,r2,r1     ; r1 *= 8389
 167:common/prog/MSP/armCmx/hsupArmCM.c ****         lsrs r1,#16       ; r1 /= 65536
 168:common/prog/MSP/armCmx/hsupArmCM.c ****         muls r0,r1,r0     ; r0 = r1 * r0
 169:common/prog/MSP/armCmx/hsupArmCM.c ****         lsrs r0,#12       ; r0 /= 4096
 170:common/prog/MSP/armCmx/hsupArmCM.c ****     #else
 171:common/prog/MSP/armCmx/hsupArmCM.c ****         muls r0,r1,r0     ;
 172:common/prog/MSP/armCmx/hsupArmCM.c ****         lsrs r0,#5        ; loop needs 32 cycles ( 1 +4*7 + 3 )
 173:common/prog/MSP/armCmx/hsupArmCM.c ****     #endif   // CLOCK_IN_KHZ
 174:common/prog/MSP/armCmx/hsupArmCM.c ****   #else
 175:common/prog/MSP/armCmx/hsupArmCM.c ****     #if defined(CLOCK_IN_KHZ)
 176:common/prog/MSP/armCmx/hsupArmCM.c ****         // following calculation will be done: r0 = delay * clock / 32000
 177:common/prog/MSP/armCmx/hsupArmCM.c ****         // to prevent overflow (up to 524MHz clock):
 178:common/prog/MSP/armCmx/hsupArmCM.c ****         // r0 = (((clock / 8)) * delay) / 4000
 179:common/prog/MSP/armCmx/hsupArmCM.c ****         lsrs r1,#3        ; clock = clock / 8
 180:common/prog/MSP/armCmx/hsupArmCM.c ****         mul r0,r1         ; r0 = (clock / 8) * delay
 181:common/prog/MSP/armCmx/hsupArmCM.c ****         mov r1,#4000      ; r1 = 4000
 182:common/prog/MSP/armCmx/hsupArmCM.c ****         udiv r0,r0,r1     ; r0 = r0 / 4000
 183:common/prog/MSP/armCmx/hsupArmCM.c ****     #else
 184:common/prog/MSP/armCmx/hsupArmCM.c ****         mul r0,r1         ; r0 = clock * delay
 185:common/prog/MSP/armCmx/hsupArmCM.c ****         lsrs r0,#5        ; r0 = r0 / 32
 186:common/prog/MSP/armCmx/hsupArmCM.c ****     #endif // CLOCK_IN_KHZ
 187:common/prog/MSP/armCmx/hsupArmCM.c ****   #endif   // CORTEX_M0 || CORTEX_M0_PLUS
 188:common/prog/MSP/armCmx/hsupArmCM.c ****   
 189:common/prog/MSP/armCmx/hsupArmCM.c ****    //loop needs about 32 cycles ( 1 +4*7 + 3 )
 190:common/prog/MSP/armCmx/hsupArmCM.c **** loop                  ; loop will be handled at least one time        
 191:common/prog/MSP/armCmx/hsupArmCM.c ****     subs r0,#1        ; decrement r0 (1 cycle)        Do so many cycles to relativise
 192:common/prog/MSP/armCmx/hsupArmCM.c ****   #if defined(HSUP_DELAY_ADDITIONAL_DICE_CYCLE)
 193:common/prog/MSP/armCmx/hsupArmCM.c ****     nop               ; waste  aditional cycle (if branch is faster than 3 cycles)
 194:common/prog/MSP/armCmx/hsupArmCM.c ****   #endif
 195:common/prog/MSP/armCmx/hsupArmCM.c ****     push {r0-r5}      ; waste time   (7 cycle)        the fuzzy time caused by the branch
 196:common/prog/MSP/armCmx/hsupArmCM.c ****     pop  {r0-r5}      ; waste time   (7 cycle)        and possible flash wait states.
 197:common/prog/MSP/armCmx/hsupArmCM.c ****     push {r0-r5}      ; waste time   (7 cycle)        Accuracy is better than 10%.
 198:common/prog/MSP/armCmx/hsupArmCM.c ****     pop  {r0-r5}      ; waste time   (7 cycle)        Very low delays should be avoided.
 199:common/prog/MSP/armCmx/hsupArmCM.c ****     bcs loop          ; branch if not negative ( about 3 cycles if branch taken)
 200:common/prog/MSP/armCmx/hsupArmCM.c ****     bx lr             ;
 201:common/prog/MSP/armCmx/hsupArmCM.c **** }
 202:common/prog/MSP/armCmx/hsupArmCM.c **** 
