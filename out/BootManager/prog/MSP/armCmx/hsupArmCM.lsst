  94:common/prog/MSP/armCmx/hsupArmCM.c **** /* GCC and armclang: HSUP_DelayClk(uint16 delay, uint32 clock)                                     
  95:common/prog/MSP/armCmx/hsupArmCM.c **** /**************************************************************************************************
  96:common/prog/MSP/armCmx/hsupArmCM.c **** __attribute__((naked))
  97:common/prog/MSP/armCmx/hsupArmCM.c **** void HSUP_DelayClk(uint16 delay, uint32 clock)
  98:common/prog/MSP/armCmx/hsupArmCM.c **** {
  99:common/prog/MSP/armCmx/hsupArmCM.c ****     __asm__ __volatile__
 100:common/prog/MSP/armCmx/hsupArmCM.c ****     (
 101:common/prog/MSP/armCmx/hsupArmCM.c ****   #if !defined(__ARMCC_VERSION)
 102:common/prog/MSP/armCmx/hsupArmCM.c ****     ".syntax unified       \n"
 103:common/prog/MSP/armCmx/hsupArmCM.c ****   #endif
 104:common/prog/MSP/armCmx/hsupArmCM.c **** 
 105:common/prog/MSP/armCmx/hsupArmCM.c ****   #if defined(CORTEX_M0) || defined(CORTEX_M0_PLUS) || defined(CORTEX_M23)
 106:common/prog/MSP/armCmx/hsupArmCM.c ****     #if defined(CLOCK_IN_KHZ)
 107:common/prog/MSP/armCmx/hsupArmCM.c ****     // following calculation will be done: r0 = delay * clock / 32000
 108:common/prog/MSP/armCmx/hsupArmCM.c ****     // to prevent overflow and division:
 109:common/prog/MSP/armCmx/hsupArmCM.c ****     // r0 = (((clock * 8389) / 65536) * delay) / 4096  (error < 50ppm)
 110:common/prog/MSP/armCmx/hsupArmCM.c ****         "mov  r2,#8389     \n"   // r2  = 8389
 111:common/prog/MSP/armCmx/hsupArmCM.c ****         "muls r1,r2        \n"   // r1 *= 8389
 112:common/prog/MSP/armCmx/hsupArmCM.c ****         "lsrs r1,#16       \n"   // r1 /= 65536
 113:common/prog/MSP/armCmx/hsupArmCM.c ****         "muls r0,r1        \n"   // r0 = r0 * r1
 114:common/prog/MSP/armCmx/hsupArmCM.c ****         "lsrs r0,#12       \n"   // r0 /= 4096
 115:common/prog/MSP/armCmx/hsupArmCM.c ****     #else
 116:common/prog/MSP/armCmx/hsupArmCM.c ****         "muls r0,r1        \n"
 117:common/prog/MSP/armCmx/hsupArmCM.c ****         "lsrs r0,#5        \n"   // loop needs 32 cycles ( 1 +4*7 + 3 )
 118:common/prog/MSP/armCmx/hsupArmCM.c ****     #endif  // CLOCK_IN_KHZ
 119:common/prog/MSP/armCmx/hsupArmCM.c ****   #else
 120:common/prog/MSP/armCmx/hsupArmCM.c ****     #if defined(CLOCK_IN_KHZ)
 121:common/prog/MSP/armCmx/hsupArmCM.c ****     // following calculation will be done: r0 = delay * clock / 32000
 122:common/prog/MSP/armCmx/hsupArmCM.c ****     // to prevent overflow (up to 524MHz clock):
 123:common/prog/MSP/armCmx/hsupArmCM.c ****     // r0 = (((clock / 8)) * delay) / 4000
 124:common/prog/MSP/armCmx/hsupArmCM.c ****         "lsrs r1,#3        \n"   // clock = clock / 8
 125:common/prog/MSP/armCmx/hsupArmCM.c ****         "mul r0,r1         \n"   // r0 = (clock / 8) * delay
 126:common/prog/MSP/armCmx/hsupArmCM.c ****         "mov r1,#4000      \n"   // r1 = 4000
 127:common/prog/MSP/armCmx/hsupArmCM.c ****         "udiv r0,r0,r1     \n"   // r0 = r0 / 4000
 128:common/prog/MSP/armCmx/hsupArmCM.c ****     #else
 129:common/prog/MSP/armCmx/hsupArmCM.c ****         "mul r0,r1         \n"   // r0 = clock * delay
 130:common/prog/MSP/armCmx/hsupArmCM.c ****         "lsrs r0,#5        \n"   // r0 = r0 / 32
 131:common/prog/MSP/armCmx/hsupArmCM.c ****     #endif  // CLOCK_IN_KHZ
 132:common/prog/MSP/armCmx/hsupArmCM.c ****   #endif    // CORTEX_M0 || CORTEX_M0_PLUS
 133:common/prog/MSP/armCmx/hsupArmCM.c ****   
 134:common/prog/MSP/armCmx/hsupArmCM.c ****     //loop needs about 32 cycles ( 1 +4*7 + 3 )
 135:common/prog/MSP/armCmx/hsupArmCM.c ****     "loop:                 \n"   // loop will be handled at least one time
 136:common/prog/MSP/armCmx/hsupArmCM.c ****     #if defined(HSUP_DELAY_ADDITIONAL_DICE_CYCLE)
 137:common/prog/MSP/armCmx/hsupArmCM.c ****         "nop               \n"   // waste  aditional cycle (if branch is faster than 3 cycles)
 138:common/prog/MSP/armCmx/hsupArmCM.c ****     #endif
 139:common/prog/MSP/armCmx/hsupArmCM.c ****         "subs r0,#1        \n"   // decrement r0 (1 cycle)        Do so many cycles to relativise
 140:common/prog/MSP/armCmx/hsupArmCM.c ****         "push {r0-r5}      \n"   // waste time   (7 cycle)        the fuzzy time caused by the bran
 141:common/prog/MSP/armCmx/hsupArmCM.c ****         "pop  {r0-r5}      \n"   // waste time   (7 cycle)        and possible flash wait states.
 142:common/prog/MSP/armCmx/hsupArmCM.c ****         "push {r0-r5}      \n"   // waste time   (7 cycle)        Accuracy is better than 10%.
 143:common/prog/MSP/armCmx/hsupArmCM.c ****         "pop  {r0-r5}      \n"   // waste time   (7 cycle)        Very low delays should be avoided
 144:common/prog/MSP/armCmx/hsupArmCM.c ****         "bcs loop          \n"   // branch if not negative ( about 3 cycles if branch taken)
 145:common/prog/MSP/armCmx/hsupArmCM.c ****         "bx lr             \n"
 146:common/prog/MSP/armCmx/hsupArmCM.c **** 
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\cc8zLdQG.s 			page 4


 147:common/prog/MSP/armCmx/hsupArmCM.c ****   #if !defined(__ARMCC_VERSION)
 148:common/prog/MSP/armCmx/hsupArmCM.c ****     ".syntax divided       \n"
 149:common/prog/MSP/armCmx/hsupArmCM.c ****   #endif
 150:common/prog/MSP/armCmx/hsupArmCM.c ****     );
 151:common/prog/MSP/armCmx/hsupArmCM.c **** }
