 148:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     DRVIF_clearPGMWindow();
 149:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** 
 150:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     //enable the pre read
