 139:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     /* word program, page program, start flag */
 140:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     FLASH->CR.V32 = ((FLASH_CR_PSIZE_WD << FLASH_CR_PSIZE_Pos) \
 141:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****                     | (FLASH_CR_CMD_MPG << FLASH_CR_CMD_Pos)   \
 142:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****                     | ((uint32_t)1U << FLASH_CR_STRT_Pos));
 143:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** 
 144:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     COMA_copyToWrUnit(size, buffer, addr);
 145:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     while ((FLASH->SR.V32 & FLASH_FLAG_BSY) != 0U){}
 146:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     /* reset flag*/
