 345:common/prog/MSP/CMSIS/cmsis_gcc.h ****  */
 346:common/prog/MSP/CMSIS/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __ROR(uint32_t op1, uint32_t op2)
 347:common/prog/MSP/CMSIS/cmsis_gcc.h **** {
