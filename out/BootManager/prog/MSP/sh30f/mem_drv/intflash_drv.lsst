 102:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** void DRVIF_initFlash(void)
 103:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** {
 104:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     /* Axivion Disable Style MisraC2012-17.7 : Missing declaration for function definition */
 105:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     __disable_irq();
 106:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     /* Axivion Enable Style MisraC2012-17.7 */ 
 107:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** 
 108:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     /* Get LVR enable value */
 109:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     DRV_LVRState = (uint8_t)SYSCFG->PWRCR.BIT.LVREN;
 110:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     /* Disable low vlotage reset */
 111:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     SYSCFG->PWRCR.V32 &= ~SYSCFG_PWRCR_LVREN_Msk;
 112:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     DRVIF_unlockFlash();
 113:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     DRVIF_resetFlash();
 114:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** }
 115:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** 
 116:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** void DRVIF_deinitFlash(void)
 117:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** {
 118:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     DRVIF_resetFlash();
 119:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     DRVIF_lockFlash();
 120:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     /* Restore default LVR settings */
 121:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     if (DRV_LVRState == 0x01u)
 122:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     {
 123:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****         SYSCFG->PWRCR.V32 |= SYSCFG_PWRCR_LVREN_Msk;
 124:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     }
 125:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     __enable_irq();
 126:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** }
