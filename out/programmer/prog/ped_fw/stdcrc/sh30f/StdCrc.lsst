  58:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** /*!
  59:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****  * \brief
  60:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****  * Check if an byte pointer has word alignment or not
  61:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****  *
  62:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****  * This interface may be used to check the alignment of a byte pointer before casting it to a word 
  63:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****  * Usually is not allowed to cast a pointer to another with a stricter alignment. When this check r
  64:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****  * \param[in] date: pointer to check
  65:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****  *
  66:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****  * \return true if data has word alignment
  67:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****  */
  68:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** static bool CRC_isWordAligned(const uint8_t *data)
  69:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** {
  70:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****     /*lint -e{923}  cast is allowed as uintptr_t can hold address of pointer (C99) */
  71:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****     return ( ( (uintptr_t)data % CRC_WordAlignBytes ) == 0U ) ? (true) : (false);
  72:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** }
  73:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** 
  74:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** 
  75:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** static void CRC_triggerWatchDogTimer(void)
  76:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** {
  77:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****     IWDT->CLR = 0xAAAAU;
  78:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c ****     WWDT->CLR = 0x5555U;
  79:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** }
  80:common/prog/ped_fw/stdcrc/sh30f/StdCrc.c **** 
