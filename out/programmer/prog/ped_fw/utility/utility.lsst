 288:common/prog/ped_fw/utility/utility.h **** /**
 289:common/prog/ped_fw/utility/utility.h **** This functions implements an 8 bit level shifter to right
 290:common/prog/ped_fw/utility/utility.h **** 
 291:common/prog/ped_fw/utility/utility.h **** UTI_ucShiftLeft shifts the value \<ucValue\> \<ucShift\>-times to right.
 292:common/prog/ped_fw/utility/utility.h **** For non HC08 controllers this is not more than a macro. For Metrowerks HC08 level shifting is optim
 293:common/prog/ped_fw/utility/utility.h **** When the parameter ucShift is a variable the codesize will be increase.\n
 294:common/prog/ped_fw/utility/utility.h **** Using this function/macro will force a function call instead inlining again and again.\n
 295:common/prog/ped_fw/utility/utility.h **** Use this macro/function, when parameter ucShift is not known at compile time, else use shift operat
 296:common/prog/ped_fw/utility/utility.h **** 
 297:common/prog/ped_fw/utility/utility.h **** \param ucValue: value to be shifted\n
 298:common/prog/ped_fw/utility/utility.h **** \b type: uint8_t
 299:common/prog/ped_fw/utility/utility.h **** 
 300:common/prog/ped_fw/utility/utility.h **** \param ucShift: number of shift operations to right\n
 301:common/prog/ped_fw/utility/utility.h **** \b type: uint8_t\n
 302:common/prog/ped_fw/utility/utility.h **** \b range: 0x00..0xFF (for more than 7, result is allways zero)
 303:common/prog/ped_fw/utility/utility.h **** 
 304:common/prog/ped_fw/utility/utility.h **** \sa UTI_ucShiftLeft()
 305:common/prog/ped_fw/utility/utility.h **** */
