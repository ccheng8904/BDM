 106:common/prog/ped_fw/timer/system_timer.c **** /** \brief    Function for checking if target time of timer is set.
 107:common/prog/ped_fw/timer/system_timer.c ****  *
 108:common/prog/ped_fw/timer/system_timer.c ****  *  \param    timer: pointer to timer instance
 109:common/prog/ped_fw/timer/system_timer.c ****  *
 110:common/prog/ped_fw/timer/system_timer.c ****  *  \return   true, if target time is set
 111:common/prog/ped_fw/timer/system_timer.c ****  */
 112:common/prog/ped_fw/timer/system_timer.c **** static bool STIM_IsTargetTimeSet(const struct STIM_Timer *timer)
 113:common/prog/ped_fw/timer/system_timer.c **** {
 114:common/prog/ped_fw/timer/system_timer.c ****     return timer->targetTime_ms != 0U;
 115:common/prog/ped_fw/timer/system_timer.c **** }
 116:common/prog/ped_fw/timer/system_timer.c **** 
 117:common/prog/ped_fw/timer/system_timer.c **** 
 118:common/prog/ped_fw/timer/system_timer.c **** /** \brief    Function for checking if the timer is triggered.
 119:common/prog/ped_fw/timer/system_timer.c ****  *
 120:common/prog/ped_fw/timer/system_timer.c ****  *  \param    timer: pointer to timer instance
 121:common/prog/ped_fw/timer/system_timer.c ****  *
 122:common/prog/ped_fw/timer/system_timer.c ****  *  \return   true, if the timer is triggered
 123:common/prog/ped_fw/timer/system_timer.c ****  */
 124:common/prog/ped_fw/timer/system_timer.c **** static bool STIM_IsTimerTriggered(const struct STIM_Timer *timer)
 125:common/prog/ped_fw/timer/system_timer.c **** {
 126:common/prog/ped_fw/timer/system_timer.c ****     return timer->currentTime_ms >= timer->targetTime_ms;
 127:common/prog/ped_fw/timer/system_timer.c **** }
 128:common/prog/ped_fw/timer/system_timer.c **** 
 129:common/prog/ped_fw/timer/system_timer.c **** 
 130:common/prog/ped_fw/timer/system_timer.c **** /** \brief    Function returns time difference in ms since last function call.
 131:common/prog/ped_fw/timer/system_timer.c ****  *
 132:common/prog/ped_fw/timer/system_timer.c ****  *  Time difference is calculated based on difference of actual timestamp and
 133:common/prog/ped_fw/timer/system_timer.c ****  *  timestamp updated from last function call. For calculating time difference
 134:common/prog/ped_fw/timer/system_timer.c ****  *  in milliseconds, fixed point arithmetic multiplication is used:
 135:common/prog/ped_fw/timer/system_timer.c ****  *  timeDiff_ms = (timeDiff_us * ceil(2^25 / 1000)) / 2^25
 136:common/prog/ped_fw/timer/system_timer.c ****  *  This calculation is precise up to 60 ms with 25 bit fixedPointShift.
 137:common/prog/ped_fw/timer/system_timer.c ****  *  Maximum returned elapsed time is 64 ms.
 138:common/prog/ped_fw/timer/system_timer.c ****  *
 139:common/prog/ped_fw/timer/system_timer.c ****  *  \param    timeStamp: pointer static timestamp value for time keeping
 140:common/prog/ped_fw/timer/system_timer.c ****  *
 141:common/prog/ped_fw/timer/system_timer.c ****  *  \return   millisecond time difference since last update
 142:common/prog/ped_fw/timer/system_timer.c ****  */
 143:common/prog/ped_fw/timer/system_timer.c **** static uint16_t STIM_GetElapsedTimeMs(uint16_t *timeStamp)
 144:common/prog/ped_fw/timer/system_timer.c **** {
 145:common/prog/ped_fw/timer/system_timer.c ****     const uint8_t fixedPointShift = FIXED_POINT_SHIFT;
 146:common/prog/ped_fw/timer/system_timer.c ****     const uint16_t ticksPerMs = TICKS_PER_MS;
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccB2s30X.s 			page 4


 147:common/prog/ped_fw/timer/system_timer.c ****     const uint32_t msMulConst = (((uint32_t)1u << FIXED_POINT_SHIFT) / TICKS_PER_MS) + 1u;
 148:common/prog/ped_fw/timer/system_timer.c ****     
 149:common/prog/ped_fw/timer/system_timer.c ****     uint16_t elapsedTime_us = TIM_uiGetCircleMicroSeconds() - *timeStamp;
 150:common/prog/ped_fw/timer/system_timer.c ****     uint16_t elapsedTime_ms = (uint16_t)((elapsedTime_us * msMulConst) >> fixedPointShift); 
 151:common/prog/ped_fw/timer/system_timer.c ****     *timeStamp += (uint16_t)(elapsedTime_ms * ticksPerMs);
 152:common/prog/ped_fw/timer/system_timer.c ****     
 153:common/prog/ped_fw/timer/system_timer.c ****     return elapsedTime_ms;
 154:common/prog/ped_fw/timer/system_timer.c **** }
 155:common/prog/ped_fw/timer/system_timer.c **** 
 156:common/prog/ped_fw/timer/system_timer.c **** 
