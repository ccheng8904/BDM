 160:common/prog/ped_fw/timer/system_timer.c ****  *  \param    status:   actual timer status flags
 161:common/prog/ped_fw/timer/system_timer.c ****  */
 162:common/prog/ped_fw/timer/system_timer.c **** static void STIM_ExecuteCallbacks(const struct STIM_Timer *timer, uint8_t status)
 163:common/prog/ped_fw/timer/system_timer.c **** {
 164:common/prog/ped_fw/timer/system_timer.c ****    (void) STDCB_ExecuteCallbacks(timer->cbList, (uint32_t)status, 0);
 165:common/prog/ped_fw/timer/system_timer.c **** }
