 241:common/prog/ped_fw/timer/timerlib.c ****                 //following cast is ok, just lowest 2 bits important
 242:common/prog/ped_fw/timer/timerlib.c ****                 //code works for all width of addresses
 243:common/prog/ped_fw/timer/timerlib.c ****   #if (ALIGNMENT == 4)
