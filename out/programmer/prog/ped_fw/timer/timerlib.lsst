 231:common/prog/ped_fw/timer/timerlib.c **** 
 232:common/prog/ped_fw/timer/timerlib.c ****         pucTimerPtr = ptTimerConfig->pucPrescalerPtr; // point to first prescaler (TIM_uc8Start1/TI
 233:common/prog/ped_fw/timer/timerlib.c **** 
 234:common/prog/ped_fw/timer/timerlib.c ****         for (;;)
 235:common/prog/ped_fw/timer/timerlib.c ****         {
