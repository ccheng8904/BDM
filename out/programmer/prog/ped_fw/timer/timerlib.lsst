 254:common/prog/ped_fw/timer/timerlib.c ****                 }
 255:common/prog/ped_fw/timer/timerlib.c ****   #endif
 256:common/prog/ped_fw/timer/timerlib.c ****             }
 257:common/prog/ped_fw/timer/timerlib.c **** #endif
 258:common/prog/ped_fw/timer/timerlib.c ****             while (pucTimerPtr < (ptTimerConfig->pucPrescalerPtr))//do for all timers in segment
 259:common/prog/ped_fw/timer/timerlib.c ****             {
 260:common/prog/ped_fw/timer/timerlib.c ****                 if (ucTimerType == TIM_16BIT)
 261:common/prog/ped_fw/timer/timerlib.c ****                 {
 262:common/prog/ped_fw/timer/timerlib.c ****                     if (*((Ttimer16*)(volatile void*)pucTimerPtr) != 0u)   // if not 16-Bit timer d
