 101:app/prog/MSP/armCmx/int_exc_cfg.c ****    /* in bits [9..0] of the SpuriousInt is spurious interrupt number
 102:app/prog/MSP/armCmx/int_exc_cfg.c ****     * e.g. 0x13 is for Stm32f10XXX vector table RTC_IRQHandler() 
 103:app/prog/MSP/armCmx/int_exc_cfg.c ****     * i.e. IRQ3 (0x13 - 0x10 = 0x03)
 104:app/prog/MSP/armCmx/int_exc_cfg.c ****     * where 0x10 in subtraction represents IRQs offset
 105:app/prog/MSP/armCmx/int_exc_cfg.c ****     */
 106:app/prog/MSP/armCmx/int_exc_cfg.c ****     (void) SpuriousInt;
  35              		.loc 1 106 5 discriminator 1 view .LVU1
 107:app/prog/MSP/armCmx/int_exc_cfg.c **** 
 108:app/prog/MSP/armCmx/int_exc_cfg.c ****     /* Endless loop - no return from spurious interrupt */
 109:app/prog/MSP/armCmx/int_exc_cfg.c ****     for(;;) {}
  36              		.loc 1 109 5 discriminator 1 view .LVU2
  37              		.loc 1 109 14 discriminator 1 view .LVU3
  38              		.loc 1 109 5 discriminator 1 view .LVU4
  39 0000 FEE7     		b	.L2
