 733:common/prog/MSP/CMSIS/cmsis_gcc.h **** {
 734:common/prog/MSP/CMSIS/cmsis_gcc.h ****   if (sat <= 31U)
 735:common/prog/MSP/CMSIS/cmsis_gcc.h ****   {
 736:common/prog/MSP/CMSIS/cmsis_gcc.h ****     const uint32_t max = ((1U << sat) - 1U);
 737:common/prog/MSP/CMSIS/cmsis_gcc.h ****     if (val > (int32_t)max)
 738:common/prog/MSP/CMSIS/cmsis_gcc.h ****     {
 739:common/prog/MSP/CMSIS/cmsis_gcc.h ****       return max;
 740:common/prog/MSP/CMSIS/cmsis_gcc.h ****     }
 741:common/prog/MSP/CMSIS/cmsis_gcc.h ****     else if (val < 0)
 742:common/prog/MSP/CMSIS/cmsis_gcc.h ****     {
 743:common/prog/MSP/CMSIS/cmsis_gcc.h ****       return 0U;
 744:common/prog/MSP/CMSIS/cmsis_gcc.h ****     }
 745:common/prog/MSP/CMSIS/cmsis_gcc.h ****   }
 746:common/prog/MSP/CMSIS/cmsis_gcc.h ****   return (uint32_t)val;
 747:common/prog/MSP/CMSIS/cmsis_gcc.h **** }
