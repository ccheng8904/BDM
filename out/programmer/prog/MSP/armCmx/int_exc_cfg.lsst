  48:app/prog/MSP/armCmx/int_exc_cfg.c **** /*          /   +------+      Stacked PC                        */
  49:app/prog/MSP/armCmx/int_exc_cfg.c **** /*         /    | PC   | <--- at SP+0x18                        */
  50:app/prog/MSP/armCmx/int_exc_cfg.c **** /*        /     +------+                                        */
  51:app/prog/MSP/armCmx/int_exc_cfg.c **** /*       /      | LR   |                                        */
