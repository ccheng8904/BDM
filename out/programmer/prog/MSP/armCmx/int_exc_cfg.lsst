 700:common/prog/MSP/CMSIS/cmsis_gcc.h **** /**
 701:common/prog/MSP/CMSIS/cmsis_gcc.h ****   \brief   Signed Saturate
 702:common/prog/MSP/CMSIS/cmsis_gcc.h ****   \details Saturates a signed value.
 703:common/prog/MSP/CMSIS/cmsis_gcc.h ****   \param [in]  value  Value to be saturated
 704:common/prog/MSP/CMSIS/cmsis_gcc.h ****   \param [in]    sat  Bit position to saturate to (1..32)
 705:common/prog/MSP/CMSIS/cmsis_gcc.h ****   \return             Saturated value
 706:common/prog/MSP/CMSIS/cmsis_gcc.h ****  */
 707:common/prog/MSP/CMSIS/cmsis_gcc.h **** __STATIC_FORCEINLINE int32_t __SSAT(int32_t val, uint32_t sat)
 708:common/prog/MSP/CMSIS/cmsis_gcc.h **** {
 709:common/prog/MSP/CMSIS/cmsis_gcc.h ****   if ((sat >= 1U) && (sat <= 32U))
 710:common/prog/MSP/CMSIS/cmsis_gcc.h ****   {
 711:common/prog/MSP/CMSIS/cmsis_gcc.h ****     const int32_t max = (int32_t)((1U << (sat - 1U)) - 1U);
 712:common/prog/MSP/CMSIS/cmsis_gcc.h ****     const int32_t min = -1 - max ;
 713:common/prog/MSP/CMSIS/cmsis_gcc.h ****     if (val > max)
 714:common/prog/MSP/CMSIS/cmsis_gcc.h ****     {
 715:common/prog/MSP/CMSIS/cmsis_gcc.h ****       return max;
 716:common/prog/MSP/CMSIS/cmsis_gcc.h ****     }
 717:common/prog/MSP/CMSIS/cmsis_gcc.h ****     else if (val < min)
 718:common/prog/MSP/CMSIS/cmsis_gcc.h ****     {
 719:common/prog/MSP/CMSIS/cmsis_gcc.h ****       return min;
 720:common/prog/MSP/CMSIS/cmsis_gcc.h ****     }
 721:common/prog/MSP/CMSIS/cmsis_gcc.h ****   }
 722:common/prog/MSP/CMSIS/cmsis_gcc.h ****   return val;
 723:common/prog/MSP/CMSIS/cmsis_gcc.h **** }
