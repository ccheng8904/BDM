 106:common/prog/math/mathDiv.h ****  *
 107:common/prog/math/mathDiv.h ****  *  \param    dividend:  the dividend
 108:common/prog/math/mathDiv.h ****  *  \param    divisor:   the divider
 109:common/prog/math/mathDiv.h ****  *
 110:common/prog/math/mathDiv.h ****  *  \return   result of division
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\cc05zub9.s 			page 5


 111:common/prog/math/mathDiv.h ****  */
 112:common/prog/math/mathDiv.h **** static inline uint16_t MTDIV_div_32_16(uint32_t dividend, uint16_t divisor)
 113:common/prog/math/mathDiv.h **** {
 114:common/prog/math/mathDiv.h ****   #ifdef NO_CORE_DEVIDER
 115:common/prog/math/mathDiv.h ****     return (uint16_t)MTDIV_div_mod(dividend, (MTDIV_width_t)divisor).quotient;
 116:common/prog/math/mathDiv.h ****   #else
 117:common/prog/math/mathDiv.h ****     return (uint16_t)(dividend / (uint32_t)divisor);
