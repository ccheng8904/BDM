 519:common/prog/MSP/mcal/muart.c **** static void MUART_handleReadEvent(struct MUART_Handle *handle, uint8_t data)
 520:common/prog/MSP/mcal/muart.c **** {
 521:common/prog/MSP/mcal/muart.c ****     
 522:common/prog/MSP/mcal/muart.c ****     if(MCOM_isReadBusy(&handle->transfer))
 523:common/prog/MSP/mcal/muart.c ****     {
 524:common/prog/MSP/mcal/muart.c ****         MCOM_pushByte(&handle->transfer, data);
 525:common/prog/MSP/mcal/muart.c ****     }
