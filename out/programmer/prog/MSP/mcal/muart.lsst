 125:common/prog/MSP/mcal/muart.c **** static bool MUART_isEnabled(const struct MUART_Handle *handle)
 126:common/prog/MSP/mcal/muart.c **** {
 127:common/prog/MSP/mcal/muart.c ****     return (handle->status == MCAL_STATUS_READY) ? true : false;
 128:common/prog/MSP/mcal/muart.c **** }
