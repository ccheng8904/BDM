 527:common/prog/MSP/mcal/muart.c ****     {
 528:common/prog/MSP/mcal/muart.c ****         struct MCAL_EventData eventData;
 529:common/prog/MSP/mcal/muart.c ****         uint16_t readDataLen = MCOM_getNumOfReadData(&handle->transfer);
 530:common/prog/MSP/mcal/muart.c **** 
 531:common/prog/MSP/mcal/muart.c ****         handle->finishRead = false;
 532:common/prog/MSP/mcal/muart.c ****         MCAL_setEventData_uint16(&eventData, readDataLen);
 533:common/prog/MSP/mcal/muart.c ****         MCOM_setReadReady(&handle->transfer);
 534:common/prog/MSP/mcal/muart.c ****         MCAL_invokeCallbacks(handle->cbList, MCAL_MODULE_MUART, MCAL_EVENT_READ_COMPLETE, &eventDat
 535:common/prog/MSP/mcal/muart.c ****     }
 536:common/prog/MSP/mcal/muart.c **** }
