 474:common/prog/MSP/mcal/muart.c **** static void MUART_IRQ_registerHandle(struct MUART_Handle *handle)
 475:common/prog/MSP/mcal/muart.c **** {
 476:common/prog/MSP/mcal/muart.c ****     enum MUART_IRQ_Index index = MUART_IRQ_getIndex(handle->channel);
 477:common/prog/MSP/mcal/muart.c ****     /* Note 661 MUART_IRQ_getIndex never returns out of bounds index*/
 478:common/prog/MSP/mcal/muart.c ****     if(MUART_IRQ_HandleTable[index] == NULL)/*lint !e661 */
 479:common/prog/MSP/mcal/muart.c ****     {
 480:common/prog/MSP/mcal/muart.c ****         MUART_IRQ_HandleTable[index] = handle;/*lint !e661 */
 481:common/prog/MSP/mcal/muart.c ****     }
 482:common/prog/MSP/mcal/muart.c ****   #ifdef MUART_MULTIPLE_HANDLES_PER_IRQ
 483:common/prog/MSP/mcal/muart.c ****     else
 484:common/prog/MSP/mcal/muart.c ****     {
 485:common/prog/MSP/mcal/muart.c ****         struct MUART_Handle *handleEntry = MUART_IRQ_HandleTable[index];
 486:common/prog/MSP/mcal/muart.c ****         while(handleEntry->nextHandle != NULL)
 487:common/prog/MSP/mcal/muart.c ****         {
 488:common/prog/MSP/mcal/muart.c ****             handleEntry = handleEntry->nextHandle;
 489:common/prog/MSP/mcal/muart.c ****         }
 490:common/prog/MSP/mcal/muart.c ****         handleEntry->nextHandle = handle;
 491:common/prog/MSP/mcal/muart.c ****     }
 492:common/prog/MSP/mcal/muart.c ****     handle->nextHandle = NULL;
 493:common/prog/MSP/mcal/muart.c ****   #endif
 494:common/prog/MSP/mcal/muart.c **** }
