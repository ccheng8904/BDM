  98:common/prog/MSP/mcal/muart.c ****         }
  99:common/prog/MSP/mcal/muart.c ****     }
 100:common/prog/MSP/mcal/muart.c ****     else if(MCAL_isEvent(eventResponse, MCAL_EVENT_CLOCK_CHANGE_PRE))
 101:common/prog/MSP/mcal/muart.c ****     {
 102:common/prog/MSP/mcal/muart.c ****         /* if MUART is enabled, disable it until pmode is changed */
 103:common/prog/MSP/mcal/muart.c ****         if(status != MCAL_STATUS_DISABLED)
 104:common/prog/MSP/mcal/muart.c ****         {
 105:common/prog/MSP/mcal/muart.c ****             MUART_disableChannel(handle->channel);
 106:common/prog/MSP/mcal/muart.c ****         }
 107:common/prog/MSP/mcal/muart.c ****     }
 108:common/prog/MSP/mcal/muart.c ****     else if(MCAL_isEvent(eventResponse, MCAL_EVENT_CLOCK_CHANGE_POST))
 109:common/prog/MSP/mcal/muart.c ****     {
 110:common/prog/MSP/mcal/muart.c ****         /* configure and reenable MUART if not disabled by user */
 111:common/prog/MSP/mcal/muart.c ****         if(status != MCAL_STATUS_DISABLED)
 112:common/prog/MSP/mcal/muart.c ****         {
 113:common/prog/MSP/mcal/muart.c ****             MUART_configureBaudrate(handle->channel, handle->defaultBaudrate);
 114:common/prog/MSP/mcal/muart.c ****             MUART_enableChannel(handle->channel);
 115:common/prog/MSP/mcal/muart.c ****         }
 116:common/prog/MSP/mcal/muart.c ****     }
 117:common/prog/MSP/mcal/muart.c ****     else
 118:common/prog/MSP/mcal/muart.c ****     {
 119:common/prog/MSP/mcal/muart.c ****         /* Nothing to do */
 120:common/prog/MSP/mcal/muart.c ****     }
 121:common/prog/MSP/mcal/muart.c **** }
