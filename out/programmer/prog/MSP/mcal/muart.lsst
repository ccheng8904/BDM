 539:common/prog/MSP/mcal/muart.c **** static void MUART_handleWriteEvent(struct MUART_Handle *handle)
 540:common/prog/MSP/mcal/muart.c **** {
 541:common/prog/MSP/mcal/muart.c ****     if(MCOM_isWriteBusy(&handle->transfer))
 542:common/prog/MSP/mcal/muart.c ****     {
 543:common/prog/MSP/mcal/muart.c ****         uint8_t data = MCOM_popByte(&handle->transfer);
 544:common/prog/MSP/mcal/muart.c ****         MUART_writeDataReg(handle->channel, (uint32_t)data);
 545:common/prog/MSP/mcal/muart.c ****         
 546:common/prog/MSP/mcal/muart.c ****         if(MCOM_isWriteComplete(&handle->transfer))
 547:common/prog/MSP/mcal/muart.c ****         {
 548:common/prog/MSP/mcal/muart.c ****             (void)MUART_disableEvent(handle, NULL, MCAL_EVENT_WRITE_BYTE);
 549:common/prog/MSP/mcal/muart.c ****             MCOM_setWriteReady(&handle->transfer);
 550:common/prog/MSP/mcal/muart.c ****             MCAL_invokeCallbacks(handle->cbList, MCAL_MODULE_MUART, MCAL_EVENT_WRITE_COMPLETE, NULL
 551:common/prog/MSP/mcal/muart.c ****         }
 552:common/prog/MSP/mcal/muart.c ****     }
 553:common/prog/MSP/mcal/muart.c **** }
