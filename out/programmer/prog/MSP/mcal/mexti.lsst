 116:common/prog/MSP/mcal/mexti.c **** bool MEXTI_isEvent(const struct MEXTI_Channel *channel)
 117:common/prog/MSP/mcal/mexti.c **** {
 118:common/prog/MSP/mcal/mexti.c ****     uint32_t status = MEXTI_getStatusReg(channel);
 119:common/prog/MSP/mcal/mexti.c ****     uint32_t eventStatusMask = MEXTI_getStatusRegMaskForEvent(channel);
 120:common/prog/MSP/mcal/mexti.c ****     
 121:common/prog/MSP/mcal/mexti.c ****     return (((status & eventStatusMask) != 0U) ? true : false);
 122:common/prog/MSP/mcal/mexti.c **** }
