 152:common/prog/MSP/mcal/mexti.c **** static bool MEXTI_isEventPending(const struct MEXTI_Handle *handle, uint32_t status)
 153:common/prog/MSP/mcal/mexti.c **** {
 154:common/prog/MSP/mcal/mexti.c ****     uint32_t eventStatusMask = MEXTI_getStatusRegMaskForEvent(handle->channel);
 155:common/prog/MSP/mcal/mexti.c ****     
 156:common/prog/MSP/mcal/mexti.c ****     if(MEXTI_isEventEnabled(handle))
 157:common/prog/MSP/mcal/mexti.c ****     {
 158:common/prog/MSP/mcal/mexti.c ****         if((status & eventStatusMask) != 0u )
 159:common/prog/MSP/mcal/mexti.c ****         {
 160:common/prog/MSP/mcal/mexti.c ****             return true;
 161:common/prog/MSP/mcal/mexti.c ****         }
 162:common/prog/MSP/mcal/mexti.c ****         else
 163:common/prog/MSP/mcal/mexti.c ****         {
 164:common/prog/MSP/mcal/mexti.c ****             return false;
 165:common/prog/MSP/mcal/mexti.c ****         }
 166:common/prog/MSP/mcal/mexti.c ****     }
 167:common/prog/MSP/mcal/mexti.c ****     return false;
 168:common/prog/MSP/mcal/mexti.c **** }
