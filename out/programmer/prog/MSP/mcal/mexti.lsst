  48:common/prog/MSP/mcal/mexti.c **** /** Function for checking if event is pending.
  49:common/prog/MSP/mcal/mexti.c ****  *  \note Pending event is, when event is enabled using MXXX_enableEvent and
  50:common/prog/MSP/mcal/mexti.c ****  *        respective status flag in peripheral status register is set.
  51:common/prog/MSP/mcal/mexti.c ****  *  \param handle: pointer to MEXTI_Handle instance, stored in static memory
  52:common/prog/MSP/mcal/mexti.c ****  *  \param status: status register value
  53:common/prog/MSP/mcal/mexti.c ****  *  \return true if event is pending
  54:common/prog/MSP/mcal/mexti.c ****  */
  55:common/prog/MSP/mcal/mexti.c **** static bool MEXTI_isEventPending(const struct MEXTI_Handle *handle, uint32_t status);
  56:common/prog/MSP/mcal/mexti.c **** 
  57:common/prog/MSP/mcal/mexti.c **** 
  58:common/prog/MSP/mcal/mexti.c **** /** Function for checking if event is enabled.
