  60:common/prog/MSP/mcal/mexti.c ****  */
  61:common/prog/MSP/mcal/mexti.c **** static bool MEXTI_isEventEnabled(const struct MEXTI_Handle *handle)
  62:common/prog/MSP/mcal/mexti.c **** {
  63:common/prog/MSP/mcal/mexti.c ****     return handle->enabledEvent;
  64:common/prog/MSP/mcal/mexti.c **** }
