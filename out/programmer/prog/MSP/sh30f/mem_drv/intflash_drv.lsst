 131:common/prog/firmware_update/mem_drv/com_mal.h **** DRVIF_RAMCODE static inline bool COMA_isAddrRangeValid
 132:common/prog/firmware_update/mem_drv/com_mal.h ****     (const struct COMA_memSeg_s* memSeg, uint32_t addr, uint32_t range)
 133:common/prog/firmware_update/mem_drv/com_mal.h **** {
 134:common/prog/firmware_update/mem_drv/com_mal.h ****     return ((
 135:common/prog/firmware_update/mem_drv/com_mal.h ****         (addr  >= memSeg->startAddr) && (addr <= memSeg->endAddr) &&
