 252:common/prog/MSP/sh30f/mem_drv/intflash_drv.c **** {
 253:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     /* Sets the initial value of counter */
 254:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     FLASH->CNTR = CounterInitValue;
 255:common/prog/MSP/sh30f/mem_drv/intflash_drv.c ****     /* Sets the upper limit value of counter */
