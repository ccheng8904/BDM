 710:common/prog/MSP/CMSIS/cmsis_gcc.h ****   {
 711:common/prog/MSP/CMSIS/cmsis_gcc.h ****     const int32_t max = (int32_t)((1U << (sat - 1U)) - 1U);
 712:common/prog/MSP/CMSIS/cmsis_gcc.h ****     const int32_t min = -1 - max ;
 713:common/prog/MSP/CMSIS/cmsis_gcc.h ****     if (val > max)
