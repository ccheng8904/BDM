 380:common/prog/firmware_update/mem_drv/mem_drv.c **** /** \brief    Search for a valid driver for given driverID.
 381:common/prog/firmware_update/mem_drv/mem_drv.c ****  *
 382:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \param    driverID: identifier of requested memory driver
 383:common/prog/firmware_update/mem_drv/mem_drv.c ****  *
 384:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \return   pointer to the responsible memory driver,
 385:common/prog/firmware_update/mem_drv/mem_drv.c ****               or NULL when no driver found.
 386:common/prog/firmware_update/mem_drv/mem_drv.c ****  */
 387:common/prog/firmware_update/mem_drv/mem_drv.c **** static const struct MEMDRV_driver_s* MEMDRV_getDriver(enum MAL_DriverID_e driverId)
 388:common/prog/firmware_update/mem_drv/mem_drv.c **** {   // search in MEMDRV_driverTable until end mark (NULL) is reached
 389:common/prog/firmware_update/mem_drv/mem_drv.c ****     for(uint8_t i = 0; MEMDRV_driverTable[i].driver != NULL; i++)
 390:common/prog/firmware_update/mem_drv/mem_drv.c ****     {
 391:common/prog/firmware_update/mem_drv/mem_drv.c ****         if (MEMDRV_driverTable[i].driverID == driverId)
 392:common/prog/firmware_update/mem_drv/mem_drv.c ****         {
 393:common/prog/firmware_update/mem_drv/mem_drv.c ****             return MEMDRV_driverTable[i].driver;
