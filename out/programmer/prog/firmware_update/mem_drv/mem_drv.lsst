 346:common/prog/firmware_update/mem_drv/mem_drv.c **** 
 347:common/prog/firmware_update/mem_drv/mem_drv.c **** /** Waits until on going operation has been finished
 348:common/prog/firmware_update/mem_drv/mem_drv.c ****  *  \note This interface triggers the watchdog as
 349:common/prog/firmware_update/mem_drv/mem_drv.c ****  *        e.g. flash operation may take some time.
 350:common/prog/firmware_update/mem_drv/mem_drv.c ****  */
 351:common/prog/firmware_update/mem_drv/mem_drv.c **** static void MEMDRV_waitForOperationComplete(void)
 352:common/prog/firmware_update/mem_drv/mem_drv.c **** {
 353:common/prog/firmware_update/mem_drv/mem_drv.c ****     while(MEMDRV_driver->isBusy())
 354:common/prog/firmware_update/mem_drv/mem_drv.c ****     {
 355:common/prog/firmware_update/mem_drv/mem_drv.c ****         HWDT_vTrigger();
 356:common/prog/firmware_update/mem_drv/mem_drv.c ****     }
 357:common/prog/firmware_update/mem_drv/mem_drv.c **** }
