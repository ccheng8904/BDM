 439:common/prog/firmware_update/mem_drv/mem_drv.c ****     }
 440:common/prog/firmware_update/mem_drv/mem_drv.c ****     *crc   = CRC_Update(*crc, readSize, readBuffer);
 441:common/prog/firmware_update/mem_drv/mem_drv.c ****     *size -= readSize;
 442:common/prog/firmware_update/mem_drv/mem_drv.c ****     *addr += readSize;
 443:common/prog/firmware_update/mem_drv/mem_drv.c ****     return MAL_ST_OK;
 444:common/prog/firmware_update/mem_drv/mem_drv.c **** }
