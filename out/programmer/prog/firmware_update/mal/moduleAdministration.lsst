 213:common/prog/firmware_update/mal/moduleAdministration.c **** 
 214:common/prog/firmware_update/mal/moduleAdministration.c **** #if defined(APP_VARIANT)
 215:common/prog/firmware_update/mal/moduleAdministration.c **** bool MAL_writeFirmwareIDs(void)
 216:common/prog/firmware_update/mal/moduleAdministration.c **** {
 217:common/prog/firmware_update/mal/moduleAdministration.c ****     /*lint -save -e934 Taking address of near auto variable [MISRA 2012 Rule 1.3, required], not a 
 218:common/prog/firmware_update/mal/moduleAdministration.c ****     struct MAL_fw_id_array firmwareIdTable;
 219:common/prog/firmware_update/mal/moduleAdministration.c ****     uint8_t fwidToWrite = 0;
 220:common/prog/firmware_update/mal/moduleAdministration.c ****     uint8_t moduleCount = MAL_GetMemModuleCount();
 221:common/prog/firmware_update/mal/moduleAdministration.c ****     uint32_t CrcLength = (sizeof(struct MAL_fw_id_entry) * FWU_FW_ID_MAX_COUNT);
 222:common/prog/firmware_update/mal/moduleAdministration.c **** 
 223:common/prog/firmware_update/mal/moduleAdministration.c ****     /* Initialize firmwareIdTable with empty entries */
 224:common/prog/firmware_update/mal/moduleAdministration.c ****     OTP_initializeFirmwareIDArray(&firmwareIdTable);
 225:common/prog/firmware_update/mal/moduleAdministration.c **** 
 226:common/prog/firmware_update/mal/moduleAdministration.c ****     /* Go trough each partition/module header and append FW ID */
 227:common/prog/firmware_update/mal/moduleAdministration.c ****     for(uint8_t moduleIndex = 0; moduleIndex < moduleCount; moduleIndex++)
 228:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 229:common/prog/firmware_update/mal/moduleAdministration.c ****         const struct MAL_partition_s *partition = MAL_GetMemModuleByIndex(moduleIndex);
 230:common/prog/firmware_update/mal/moduleAdministration.c ****         const struct MAL_ModuleHeader_s * header = MAL_PartitionToHeader(partition);
 231:common/prog/firmware_update/mal/moduleAdministration.c ****         
 232:common/prog/firmware_update/mal/moduleAdministration.c ****         /* Built in applications does not require FWID to be written */
 233:common/prog/firmware_update/mal/moduleAdministration.c ****         if(!MAL_isBuildInApplication(partition))
 234:common/prog/firmware_update/mal/moduleAdministration.c ****         {
 235:common/prog/firmware_update/mal/moduleAdministration.c ****             /* Problem with partition/module header should be caught by BM */
 236:common/prog/firmware_update/mal/moduleAdministration.c ****             if((partition != NULL) && (header != NULL))
 237:common/prog/firmware_update/mal/moduleAdministration.c ****             {
 238:common/prog/firmware_update/mal/moduleAdministration.c ****                 if((partition->mod_attributes & MAL_CTX_MF_NO_COMPATIBILITY_CHECK) == 0u)
 239:common/prog/firmware_update/mal/moduleAdministration.c ****                 {
 240:common/prog/firmware_update/mal/moduleAdministration.c ****                     /* mod_attributes does not contain module flag bit MAL_CTX_MF_NO_COMPATIBILITY_
 241:common/prog/firmware_update/mal/moduleAdministration.c ****                      * module's sw_version ID will be part of FWID table */
 242:common/prog/firmware_update/mal/moduleAdministration.c ****                     firmwareIdTable.entries[fwidToWrite].mod_number = partition->mod_number;
 243:common/prog/firmware_update/mal/moduleAdministration.c ****                     UTI_vMemCopy(header->sw_version.version.ID, firmwareIdTable.entries[fwidToWrite
 244:common/prog/firmware_update/mal/moduleAdministration.c ****                     fwidToWrite++;
 245:common/prog/firmware_update/mal/moduleAdministration.c ****                 }
 246:common/prog/firmware_update/mal/moduleAdministration.c ****             }
 247:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 248:common/prog/firmware_update/mal/moduleAdministration.c ****         
