 200:common/prog/firmware_update/mal/moduleAdministration.c **** bool MAL_isModuleIntegrityOk(const struct MAL_partition_s * partitionToStart)
 201:common/prog/firmware_update/mal/moduleAdministration.c **** {
 202:common/prog/firmware_update/mal/moduleAdministration.c ****     if(MAL_isBuildInApplication(partitionToStart))
 203:common/prog/firmware_update/mal/moduleAdministration.c ****     {   // check integrity of build-in application
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccUQgLlf.s 			page 5


 204:common/prog/firmware_update/mal/moduleAdministration.c ****         return MAL_isIntegrityOk(partitionToStart);
 205:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 206:common/prog/firmware_update/mal/moduleAdministration.c ****     else
 207:common/prog/firmware_update/mal/moduleAdministration.c ****     {   // check the integrity of product application
 208:common/prog/firmware_update/mal/moduleAdministration.c ****         return MAL_isApplicationIntegrityOk();
 209:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 210:common/prog/firmware_update/mal/moduleAdministration.c **** }
 211:common/prog/firmware_update/mal/moduleAdministration.c **** #endif
