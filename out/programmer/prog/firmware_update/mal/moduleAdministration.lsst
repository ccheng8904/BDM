 152:common/prog/firmware_update/mal/moduleAdministration.c **** 
 153:common/prog/firmware_update/mal/moduleAdministration.c **** uint32_t MAL_getPartitionSize(const struct MAL_partition_s * partition)
 154:common/prog/firmware_update/mal/moduleAdministration.c **** {
 155:common/prog/firmware_update/mal/moduleAdministration.c ****     uint32_t partitionSize = 0u;
 156:common/prog/firmware_update/mal/moduleAdministration.c ****     if(partition != NULL)
 157:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 158:common/prog/firmware_update/mal/moduleAdministration.c ****         partitionSize = (uint32_t)((partition->physical_end.addr - partition->physical_start.addr) 
 159:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 160:common/prog/firmware_update/mal/moduleAdministration.c ****     return partitionSize;
 161:common/prog/firmware_update/mal/moduleAdministration.c **** }
 162:common/prog/firmware_update/mal/moduleAdministration.c **** 
 163:common/prog/firmware_update/mal/moduleAdministration.c **** 
 164:common/prog/firmware_update/mal/moduleAdministration.c **** const struct MAL_ModuleHeader_s * MAL_PartitionToHeader( const struct MAL_partition_s *partition )
 165:common/prog/firmware_update/mal/moduleAdministration.c **** {
 166:common/prog/firmware_update/mal/moduleAdministration.c ****     static struct MAL_ModuleHeader_s moduleHeaderInRam;
 167:common/prog/firmware_update/mal/moduleAdministration.c ****     static const struct MAL_partition_s *actualPartition = NULL;
 168:common/prog/firmware_update/mal/moduleAdministration.c ****     if(partition == NULL)
 169:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 170:common/prog/firmware_update/mal/moduleAdministration.c ****         return NULL;
 171:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 172:common/prog/firmware_update/mal/moduleAdministration.c ****     if(actualPartition != partition)
 173:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 174:common/prog/firmware_update/mal/moduleAdministration.c ****         if(MAL_copyModuleHeaderToRAM(partition, &moduleHeaderInRam) != true)
 175:common/prog/firmware_update/mal/moduleAdministration.c ****         {
 176:common/prog/firmware_update/mal/moduleAdministration.c ****             return NULL;
 177:common/prog/firmware_update/mal/moduleAdministration.c ****         }
 178:common/prog/firmware_update/mal/moduleAdministration.c ****         actualPartition = partition;
 179:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 180:common/prog/firmware_update/mal/moduleAdministration.c ****     return &moduleHeaderInRam;
 181:common/prog/firmware_update/mal/moduleAdministration.c **** }
 182:common/prog/firmware_update/mal/moduleAdministration.c **** 
 183:common/prog/firmware_update/mal/moduleAdministration.c **** 
 184:common/prog/firmware_update/mal/moduleAdministration.c **** bool MAL_isBuildInApplication(const struct MAL_partition_s * partition)
 185:common/prog/firmware_update/mal/moduleAdministration.c **** {
 186:common/prog/firmware_update/mal/moduleAdministration.c ****     if(partition != NULL)
 187:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 188:common/prog/firmware_update/mal/moduleAdministration.c ****         enum MAL_ModuleEnum moduleId = partition->mod_number;
 189:common/prog/firmware_update/mal/moduleAdministration.c ****         return ((moduleId == MAL_PROGRAMMER_ID) || (moduleId == MAL_BP2_LOADER_ID));
 190:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 191:common/prog/firmware_update/mal/moduleAdministration.c ****     else
 192:common/prog/firmware_update/mal/moduleAdministration.c ****     {   // no valid partition given
 193:common/prog/firmware_update/mal/moduleAdministration.c ****         return false;
 194:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 195:common/prog/firmware_update/mal/moduleAdministration.c **** 
 196:common/prog/firmware_update/mal/moduleAdministration.c **** }
 197:common/prog/firmware_update/mal/moduleAdministration.c **** 
