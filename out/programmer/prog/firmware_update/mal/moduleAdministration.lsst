 101:common/prog/firmware_update/mal/moduleAdministration.c **** void MAL_initPartition(void)
 102:common/prog/firmware_update/mal/moduleAdministration.c **** {
 103:common/prog/firmware_update/mal/moduleAdministration.c ****     MAL_ModuleCount = 0u;
 104:common/prog/firmware_update/mal/moduleAdministration.c ****   #ifdef FWU_FLEX_PARTITION_USED
 105:common/prog/firmware_update/mal/moduleAdministration.c ****     MAL_flexPatRef = MAL_GetFlexPartitionTable();
 106:common/prog/firmware_update/mal/moduleAdministration.c ****   #endif
 107:common/prog/firmware_update/mal/moduleAdministration.c **** }
 108:common/prog/firmware_update/mal/moduleAdministration.c **** 
 109:common/prog/firmware_update/mal/moduleAdministration.c **** 
 110:common/prog/firmware_update/mal/moduleAdministration.c **** const struct MAL_partition_s * MAL_GetMemModule(enum MAL_ModuleEnum module)
 111:common/prog/firmware_update/mal/moduleAdministration.c **** {
 112:common/prog/firmware_update/mal/moduleAdministration.c ****     const struct MAL_partition_s *partition;
 113:common/prog/firmware_update/mal/moduleAdministration.c ****   #ifdef FWU_FLEX_PARTITION_USED
 114:common/prog/firmware_update/mal/moduleAdministration.c ****     partition = NULL;
 115:common/prog/firmware_update/mal/moduleAdministration.c ****     if (module != MAL_FLEX_PARTITION) // no flex table entry in flex table allowed!
 116:common/prog/firmware_update/mal/moduleAdministration.c ****     {   /* try flex partition */
 117:common/prog/firmware_update/mal/moduleAdministration.c ****         partition = MAL_searchMemModule( module, MAL_flexPatRef,
 118:common/prog/firmware_update/mal/moduleAdministration.c ****                                         (uint8_t)MAL_FLEX_PARTITION_ENTRIES );
 119:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 120:common/prog/firmware_update/mal/moduleAdministration.c ****     if ( partition == NULL )
 121:common/prog/firmware_update/mal/moduleAdministration.c ****   #endif
 122:common/prog/firmware_update/mal/moduleAdministration.c ****     {   /* no result, so try fixed table */
 123:common/prog/firmware_update/mal/moduleAdministration.c ****         partition = MAL_searchMemModule( module, MAL_DataAnchor.partitionTblFix,
 124:common/prog/firmware_update/mal/moduleAdministration.c ****                                         (uint8_t)MAL_FIX_PARTITION_ENTRIES );
 125:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 126:common/prog/firmware_update/mal/moduleAdministration.c ****     return partition;
 127:common/prog/firmware_update/mal/moduleAdministration.c **** }
 128:common/prog/firmware_update/mal/moduleAdministration.c **** 
