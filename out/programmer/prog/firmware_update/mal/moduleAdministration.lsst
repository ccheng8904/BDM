 136:common/prog/firmware_update/mal/moduleAdministration.c **** 
 137:common/prog/firmware_update/mal/moduleAdministration.c **** 
 138:common/prog/firmware_update/mal/moduleAdministration.c **** const struct MAL_partition_s * MAL_GetMemModuleByIndex(uint8_t index)
 139:common/prog/firmware_update/mal/moduleAdministration.c **** {
 140:common/prog/firmware_update/mal/moduleAdministration.c ****     MAL_createModuleDictionary();
 141:common/prog/firmware_update/mal/moduleAdministration.c **** 
 142:common/prog/firmware_update/mal/moduleAdministration.c ****     if (index < MAL_ModuleCount)
 143:common/prog/firmware_update/mal/moduleAdministration.c ****     {
 144:common/prog/firmware_update/mal/moduleAdministration.c ****         return MAL_GetMemModule(MAL_moduleDictionary[index]);
 145:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 146:common/prog/firmware_update/mal/moduleAdministration.c ****     else
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccUQgLlf.s 			page 4


 147:common/prog/firmware_update/mal/moduleAdministration.c ****     {   /* index out of range */
 148:common/prog/firmware_update/mal/moduleAdministration.c ****         return NULL;
 149:common/prog/firmware_update/mal/moduleAdministration.c ****     }
 150:common/prog/firmware_update/mal/moduleAdministration.c **** }
