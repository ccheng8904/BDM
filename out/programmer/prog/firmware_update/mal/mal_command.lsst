 189:common/prog/firmware_update/mal/mal_command.c **** 
 190:common/prog/firmware_update/mal/mal_command.c **** uint8_t MAL_CMD_WritePrematurelyEnd(uint16_t modNum, uint32_t overallDataWritten)
 191:common/prog/firmware_update/mal/mal_command.c **** {
 192:common/prog/firmware_update/mal/mal_command.c ****     if(!MAL_writeStarted) {return (uint8_t)MAL_ST_WRITE_ERROR;} // missing start
 193:common/prog/firmware_update/mal/mal_command.c ****     if(MAL_IsOk(MAL_checkWriteOperation(modNum)))
 194:common/prog/firmware_update/mal/mal_command.c ****     {
 195:common/prog/firmware_update/mal/mal_command.c ****         if((uint32_t)(MAL_dataLen - MAL_sizeLeft) != overallDataWritten)
 196:common/prog/firmware_update/mal/mal_command.c ****         {   // wrong data length
 197:common/prog/firmware_update/mal/mal_command.c ****             MAL_result = MAL_ST_WRITE_DATA_LEN_MISMATCH;
 198:common/prog/firmware_update/mal/mal_command.c ****         }
 199:common/prog/firmware_update/mal/mal_command.c ****         else
 200:common/prog/firmware_update/mal/mal_command.c ****         {
 201:common/prog/firmware_update/mal/mal_command.c ****             MAL_dataLen = overallDataWritten;  // new overall length
 202:common/prog/firmware_update/mal/mal_command.c ****             MAL_result  = MAL_finishWriting(); // flush and check crc
 203:common/prog/firmware_update/mal/mal_command.c ****         }
