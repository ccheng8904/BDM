 166:common/prog/firmware_update/mal/mal_command.c ****         if((MAL_sizeLeft == 0u) && (MAL_result == MAL_ST_OK))
 167:common/prog/firmware_update/mal/mal_command.c ****         {
 168:common/prog/firmware_update/mal/mal_command.c ****             MAL_result = MAL_finishWriting();
 169:common/prog/firmware_update/mal/mal_command.c ****         }
 170:common/prog/firmware_update/mal/mal_command.c ****     }
 171:common/prog/firmware_update/mal/mal_command.c ****     return (uint8_t)MAL_result;
 172:common/prog/firmware_update/mal/mal_command.c **** }
