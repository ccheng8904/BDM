 175:common/prog/firmware_update/mal/mal_command.c **** uint8_t MAL_CMD_WriteAppend(uint16_t modNum, uint16_t dataLen, const uint8_t *const data)
 176:common/prog/firmware_update/mal/mal_command.c **** {
 177:common/prog/firmware_update/mal/mal_command.c ****     if(!MAL_writeStarted) {return (uint8_t)MAL_ST_WRITE_ERROR;} // missing start
 178:common/prog/firmware_update/mal/mal_command.c ****     if( MAL_IsOk(MAL_checkWriteOperation(modNum)) &&
 179:common/prog/firmware_update/mal/mal_command.c ****         MAL_IsOk(MAL_handleWriteBlock(dataLen, data))) // write data
 180:common/prog/firmware_update/mal/mal_command.c ****     {   // writing successfully
 181:common/prog/firmware_update/mal/mal_command.c ****         if(MAL_sizeLeft == 0u)
 182:common/prog/firmware_update/mal/mal_command.c ****         {   // all data written
 183:common/prog/firmware_update/mal/mal_command.c ****             MAL_result = MAL_finishWriting(); // flush and check crc
 184:common/prog/firmware_update/mal/mal_command.c ****         }
 185:common/prog/firmware_update/mal/mal_command.c ****     }
 186:common/prog/firmware_update/mal/mal_command.c ****     return (uint8_t)MAL_result;
 187:common/prog/firmware_update/mal/mal_command.c **** }
