 154:common/prog/firmware_update/mal/mal_command.c **** uint8_t MAL_CMD_WriteStart(uint16_t modNum, uint32_t overallDataLen, uint16_t dataLen, const uint8_
 155:common/prog/firmware_update/mal/mal_command.c **** {
 156:common/prog/firmware_update/mal/mal_command.c ****     if( MAL_IsOk(MAL_checkWriteOperation(modNum)) &&
 157:common/prog/firmware_update/mal/mal_command.c ****         MAL_IsOk(MAL_checkAddressRange(0u, overallDataLen)) &&
 158:common/prog/firmware_update/mal/mal_command.c ****         MAL_IsOk(MAL_eraseModule()))
 159:common/prog/firmware_update/mal/mal_command.c ****     {   // all checks passed
 160:common/prog/firmware_update/mal/mal_command.c ****         MAL_crc = CRC_Init();
 161:common/prog/firmware_update/mal/mal_command.c ****         MAL_writeStarted = true;
 162:common/prog/firmware_update/mal/mal_command.c ****         MAL_currentAddr = 0u;
 163:common/prog/firmware_update/mal/mal_command.c ****         MAL_sizeLeft    = overallDataLen;
 164:common/prog/firmware_update/mal/mal_command.c ****         MAL_dataLen     = overallDataLen;
