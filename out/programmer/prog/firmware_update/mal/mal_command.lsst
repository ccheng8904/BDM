 292:common/prog/firmware_update/mal/mal_command.c ****  */
 293:common/prog/firmware_update/mal/mal_command.c **** static enum MAL_Status MAL_checkAddressRange(uint32_t address, uint32_t size)
 294:common/prog/firmware_update/mal/mal_command.c **** {
 295:common/prog/firmware_update/mal/mal_command.c ****     address += size;
 296:common/prog/firmware_update/mal/mal_command.c ****     if((address >= size) &&  // check for overflow
 297:common/prog/firmware_update/mal/mal_command.c ****        (MAL_getPartitionSize(MAL_OpenPartition) >= address)) // check range
 298:common/prog/firmware_update/mal/mal_command.c ****     {
 299:common/prog/firmware_update/mal/mal_command.c ****         return MAL_ST_OK;
 300:common/prog/firmware_update/mal/mal_command.c ****     }
