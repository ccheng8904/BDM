 214:common/prog/firmware_update/mal/mal_command.c **** /** collect and copy the device info of partition given by index
 215:common/prog/firmware_update/mal/mal_command.c ****  *  \param[in]  index:  index of requested partition
 216:common/prog/firmware_update/mal/mal_command.c ****  *  \param[out] modNum: number of module inside requested partition
 217:common/prog/firmware_update/mal/mal_command.c ****  *  \param[out] size:   size of partition
 218:common/prog/firmware_update/mal/mal_command.c ****  *  \param[out] name:   name of module inside requested partition
 219:common/prog/firmware_update/mal/mal_command.c ****  */
 220:common/prog/firmware_update/mal/mal_command.c **** static void MAL_copyDevInfo(uint8_t index, uint16_t *const modNum,
 221:common/prog/firmware_update/mal/mal_command.c ****                             uint32_t *const size, uint8_t *const name)
 222:common/prog/firmware_update/mal/mal_command.c **** {
 223:common/prog/firmware_update/mal/mal_command.c ****     const struct MAL_partition_s *partition = MAL_getPartition(index);
 224:common/prog/firmware_update/mal/mal_command.c ****     uint8_t nameLen  = MAL_getPartitionNameLen(partition);
 225:common/prog/firmware_update/mal/mal_command.c ****     
 226:common/prog/firmware_update/mal/mal_command.c ****     *modNum = (uint16_t)partition->mod_number;
 227:common/prog/firmware_update/mal/mal_command.c ****     *size   = MAL_getPartitionSize(partition);
 228:common/prog/firmware_update/mal/mal_command.c ****     memcpy(name, partition->mod_name, nameLen);
 229:common/prog/firmware_update/mal/mal_command.c **** }
 230:common/prog/firmware_update/mal/mal_command.c **** 
 231:common/prog/firmware_update/mal/mal_command.c **** 
 232:common/prog/firmware_update/mal/mal_command.c **** /** Processes the next partition index
 233:common/prog/firmware_update/mal/mal_command.c ****  *  \param[in,out] index
 234:common/prog/firmware_update/mal/mal_command.c ****  */
 235:common/prog/firmware_update/mal/mal_command.c **** static void MAL_processNextIndex(uint8_t *const index)
 236:common/prog/firmware_update/mal/mal_command.c **** {
 237:common/prog/firmware_update/mal/mal_command.c ****     (*index)++;
 238:common/prog/firmware_update/mal/mal_command.c ****     if (*index >= MAL_GetMemModuleCount()) {*index = 0u;}
 239:common/prog/firmware_update/mal/mal_command.c **** }
