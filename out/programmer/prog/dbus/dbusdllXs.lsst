  18:app/prog/dbus/dbusdllXs.c **** /** \file
  19:app/prog/dbus/dbusdllXs.c **** *     Application layer configuration of data link layer for D-Bus-2
  20:app/prog/dbus/dbusdllXs.c **** *
  21:app/prog/dbus/dbusdllXs.c **** *     This layer handles the message reception and transmission close to the bus-hardware,
  22:app/prog/dbus/dbusdllXs.c **** *     handling the following:
  23:app/prog/dbus/dbusdllXs.c **** *             - wrapping the message data into a frame as described below, which includes message l
  24:app/prog/dbus/dbusdllXs.c **** *               TargetAddress, MessageIdentifier, the data of the message and the attached CRC (16 
  25:app/prog/dbus/dbusdllXs.c **** *               all followed by an acknowledge from the receiving node (or sending node by broadcas
  26:app/prog/dbus/dbusdllXs.c **** *
  27:app/prog/dbus/dbusdllXs.c **** *     Frame: \image html dbusdll.gif
  28:app/prog/dbus/dbusdllXs.c **** */
  29:app/prog/dbus/dbusdllXs.c **** /*
  30:app/prog/dbus/dbusdllXs.c **** *     ___________________________________________________________________________
  31:app/prog/dbus/dbusdllXs.c **** *     |Msg.Len|   TA  |     MsgID     |    DATA ...             |      CRC       |
  32:app/prog/dbus/dbusdllXs.c **** *     ___________________________________________________________________________
