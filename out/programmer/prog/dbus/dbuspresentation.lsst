 588:common/prog/dbus/dbuspresentation.c ****         else
 589:common/prog/dbus/dbuspresentation.c ****         {
 590:common/prog/dbus/dbuspresentation.c ****             //Repeat, if DBUS locked
 591:common/prog/dbus/dbuspresentation.c ****             HandlingDone = false;
 592:common/prog/dbus/dbuspresentation.c ****         }
 593:common/prog/dbus/dbuspresentation.c ****     }
 594:common/prog/dbus/dbuspresentation.c ****     else
 595:common/prog/dbus/dbuspresentation.c ****     {
 596:common/prog/dbus/dbuspresentation.c ****         //nothing to do, if node is offline or nothing to send
 597:common/prog/dbus/dbuspresentation.c ****         HandlingDone = true;
 598:common/prog/dbus/dbuspresentation.c ****     }
 599:common/prog/dbus/dbuspresentation.c **** 
 600:common/prog/dbus/dbuspresentation.c ****     //Reset send-flag. Allow processing of other DBPL functions
 601:common/prog/dbus/dbuspresentation.c ****     if( HandlingDone != false )
 602:common/prog/dbus/dbuspresentation.c ****     {
