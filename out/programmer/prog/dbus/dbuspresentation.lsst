  28:common/prog/ped_fw/timer/system_timer.h **** /** \file
  29:common/prog/ped_fw/timer/system_timer.h ****  *
  30:common/prog/ped_fw/timer/system_timer.h ****  *  \brief    Public definitions and declarations for unit STIM.
  31:common/prog/ped_fw/timer/system_timer.h ****  *
  32:common/prog/ped_fw/timer/system_timer.h ****  *  \details  System timer library serves for single or periodic time
  33:common/prog/ped_fw/timer/system_timer.h ****  *            measurement and callback execution with resolution down to one
  34:common/prog/ped_fw/timer/system_timer.h ****  *            millisecond. System timer library contains two types of execution
  35:common/prog/ped_fw/timer/system_timer.h ****  *            handlers, interrupt handler and scheduler handler.
  36:common/prog/ped_fw/timer/system_timer.h ****  *
  37:common/prog/ped_fw/timer/system_timer.h ****  *            Scheduler handler is used for processing of less accurate timers.
  38:common/prog/ped_fw/timer/system_timer.h ****  *            Accuracy of these timers is given by time period of execution of
  39:common/prog/ped_fw/timer/system_timer.h ****  *            this handler. If accuracy of these timers is not sufficient, then
  40:common/prog/ped_fw/timer/system_timer.h ****  *            interrupt based timers (see next section) should be used instead.
  41:common/prog/ped_fw/timer/system_timer.h ****  *
  42:common/prog/ped_fw/timer/system_timer.h ****  *            Interrupt handler is called from hardware timer interrupt service
  43:common/prog/ped_fw/timer/system_timer.h ****  *            routine with period of integer value in milliseconds. This
  44:common/prog/ped_fw/timer/system_timer.h ****  *            handler is used for base time update and for processing of
  45:common/prog/ped_fw/timer/system_timer.h ****  *            accurate interrupt base timers (including callback execution).
  46:common/prog/ped_fw/timer/system_timer.h ****  *            For all ARM Cortex-M microcontrollers, SysTick timer is used by
  47:common/prog/ped_fw/timer/system_timer.h ****  *            default for this purpose.
  48:common/prog/ped_fw/timer/system_timer.h ****  *
  49:common/prog/ped_fw/timer/system_timer.h ****  *            Interrupt based timers should only be used if really necessary,
  50:common/prog/ped_fw/timer/system_timer.h ****  *            and respective callback functions should be kept as light as
  51:common/prog/ped_fw/timer/system_timer.h ****  *            possible. Otherwise they can have impact on other real-time
  52:common/prog/ped_fw/timer/system_timer.h ****  *            functions (UART/DBus handling, RTOS scheduling, ...)
  53:common/prog/ped_fw/timer/system_timer.h ****  *
  54:common/prog/ped_fw/timer/system_timer.h ****  *  Example of using system timer for precise single shot time measurement
  55:common/prog/ped_fw/timer/system_timer.h ****  *  \code
  56:common/prog/ped_fw/timer/system_timer.h ****  *  // Static definition of timer instance
  57:common/prog/ped_fw/timer/system_timer.h ****  *  static struct STIM_Timer TimerInstance;
  58:common/prog/ped_fw/timer/system_timer.h ****  *
  59:common/prog/ped_fw/timer/system_timer.h ****  *  // Initialization and start of timer (500 ms)
  60:common/prog/ped_fw/timer/system_timer.h ****  *  STIM_InitTimer(&TimerInstance, STIM_PROCESSING_INTERRUPT, 500u,
  61:common/prog/ped_fw/timer/system_timer.h ****  *      STIM_MODE_SINGLE, true, NULL);
  62:common/prog/ped_fw/timer/system_timer.h ****  *
  63:common/prog/ped_fw/timer/system_timer.h ****  *  // Waiting until timer is down
  64:common/prog/ped_fw/timer/system_timer.h ****  *  while(!STIM_IsTimerDown(&TimerInstance)) {}
  65:common/prog/ped_fw/timer/system_timer.h ****  *  \endcode
  66:common/prog/ped_fw/timer/system_timer.h ****  *
  67:common/prog/ped_fw/timer/system_timer.h ****  *  Example of using system timer for continuous periodic callback function execution
  68:common/prog/ped_fw/timer/system_timer.h ****  *  \code
  69:common/prog/ped_fw/timer/system_timer.h ****  *  // Callback function definition
  70:common/prog/ped_fw/timer/system_timer.h ****  *  int32_t TimerCallbackFunction(void *obj, uint32_t flags, int32_t data)
  71:common/prog/ped_fw/timer/system_timer.h ****  *  {
  72:common/prog/ped_fw/timer/system_timer.h ****  *      // User code ...
  73:common/prog/ped_fw/timer/system_timer.h ****  *      return 0;
  74:common/prog/ped_fw/timer/system_timer.h ****  *  }
  75:common/prog/ped_fw/timer/system_timer.h ****  *
  76:common/prog/ped_fw/timer/system_timer.h ****  *  // Static definitions of timer and callback instances (1 s)
  77:common/prog/ped_fw/timer/system_timer.h ****  *  static struct STIM_Timer TimerInstance;
  78:common/prog/ped_fw/timer/system_timer.h ****  *  static struct STDCB_Callback CallbackInstance;
  79:common/prog/ped_fw/timer/system_timer.h ****  *
  80:common/prog/ped_fw/timer/system_timer.h ****  *  // Initialization of callback and timer instances
  81:common/prog/ped_fw/timer/system_timer.h ****  *  STIM_InitCallback(&CallbackInstance, TimerCallbackFunction, NULL,
  82:common/prog/ped_fw/timer/system_timer.h ****  *      STIM_STATUS_TRIGGERED);
  83:common/prog/ped_fw/timer/system_timer.h ****  *  STIM_InitTimer(&TimerInstance, STIM_PROCESSING_SCHEDULER, 1000u,
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccWguxs8.s 			page 56


  84:common/prog/ped_fw/timer/system_timer.h ****  *      STIM_MODE_PERIODIC, true, &CallbackInstance);
  85:common/prog/ped_fw/timer/system_timer.h ****  *  \endcode
  86:common/prog/ped_fw/timer/system_timer.h ****  *
  87:common/prog/ped_fw/timer/system_timer.h ****  *  Example of using system timer as stopwatch:
  88:common/prog/ped_fw/timer/system_timer.h ****  *  \code
  89:common/prog/ped_fw/timer/system_timer.h ****  *  // Static definition of stopwatch instance
  90:common/prog/ped_fw/timer/system_timer.h ****  *  static struct STIM_Timer StopwatchInstance;
  91:common/prog/ped_fw/timer/system_timer.h ****  *
  92:common/prog/ped_fw/timer/system_timer.h ****  *  // Initialization and start of stopwatch
  93:common/prog/ped_fw/timer/system_timer.h ****  *  STIM_InitStopwatch(&StopwatchInstance, STIM_PROCESSING_INTERRUPT, true);
  94:common/prog/ped_fw/timer/system_timer.h ****  *
  95:common/prog/ped_fw/timer/system_timer.h ****  *  // User code ...
  96:common/prog/ped_fw/timer/system_timer.h ****  *
  97:common/prog/ped_fw/timer/system_timer.h ****  *  // Read measured time
  98:common/prog/ped_fw/timer/system_timer.h ****  *  STIM_Time_t measuredTime_ms = STIM_StopStopwatch(&StopwatchInstance);
  99:common/prog/ped_fw/timer/system_timer.h ****  *  \endcode
 100:common/prog/ped_fw/timer/system_timer.h ****  */
