2340:common/prog/dbus/dbuspresentation.c ****     {
2341:common/prog/dbus/dbuspresentation.c ****         /* OfflineDelay timer can be shared, because GoOffline event and 
2342:common/prog/dbus/dbuspresentation.c ****             Reset delay event can't occur at the same time, see DBPL_vGoOfflineService() */
