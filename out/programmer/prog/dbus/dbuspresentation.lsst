 498:common/prog/dbus/dbuspresentation.c ****       {
 499:common/prog/dbus/dbuspresentation.c ****          return ucModuleIndex;
 500:common/prog/dbus/dbuspresentation.c ****          //[MISRA 2004 Rule 14.7]: This function contains a second return path. However, this imple
 501:common/prog/dbus/dbuspresentation.c ****       }
 502:common/prog/dbus/dbuspresentation.c ****       else
 503:common/prog/dbus/dbuspresentation.c ****       {
 504:common/prog/dbus/dbuspresentation.c ****          //Index not found yet, continue searching.
 505:common/prog/dbus/dbuspresentation.c ****       }
 506:common/prog/dbus/dbuspresentation.c ****    }
 507:common/prog/dbus/dbuspresentation.c ****    //Module not found - 'cause it isn't defined
 508:common/prog/dbus/dbuspresentation.c ****    return 0U;      //If the requested module is not found in the table, the first index (0) is retu
 509:common/prog/dbus/dbuspresentation.c **** }
