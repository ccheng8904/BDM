 489:common/prog/dbus/dbuspresentation.c **** \return The index corresponding to the module\n
 490:common/prog/dbus/dbuspresentation.c ****  \b type: uint8_t\n
 491:common/prog/dbus/dbuspresentation.c ****  \b range: 0..(number of elements in DBPL_tModuleDict) - 1
 492:common/prog/dbus/dbuspresentation.c **** */
 493:common/prog/dbus/dbuspresentation.c **** uint8_t DBPL_ucGetModuleIndex(uint8_t ucMemoryModule)
 494:common/prog/dbus/dbuspresentation.c **** {
