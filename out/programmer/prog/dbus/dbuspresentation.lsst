 576:common/prog/dbus/dbuspresentation.c ****         {
 577:common/prog/dbus/dbuspresentation.c ****             /* Check whether a response to request should be sent */
 578:common/prog/dbus/dbuspresentation.c ****             if (DLL_bTransmitMessage(DBPL_tMessageBuffer.tBusIdentifier, DBPL_vSendResponse, DBPL_u
 579:common/prog/dbus/dbuspresentation.c ****             {
 580:common/prog/dbus/dbuspresentation.c ****                 //Message processing will be finished with this step
 581:common/prog/dbus/dbuspresentation.c ****                 HandlingDone = true;
 582:common/prog/dbus/dbuspresentation.c ****             }
 583:common/prog/dbus/dbuspresentation.c ****             else
 584:common/prog/dbus/dbuspresentation.c ****             {
 585:common/prog/dbus/dbuspresentation.c ****                 HandlingDone = false;
