 569:common/prog/dbus/dbuspresentation.c **** bool DBPL_SendServiceMessage( void )
 570:common/prog/dbus/dbuspresentation.c **** {
 571:common/prog/dbus/dbuspresentation.c ****     bool HandlingDone = false;
