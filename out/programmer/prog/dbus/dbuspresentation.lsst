 118:common/prog/ped_fw/timer/system_timer.h **** /** \brief    Timer status masks definitions
 119:common/prog/ped_fw/timer/system_timer.h ****  *
 120:common/prog/ped_fw/timer/system_timer.h ****  *  \details  These definitions are used when checking status of timer and for
 121:common/prog/ped_fw/timer/system_timer.h ****  *            enabling callback events. Status missed is active, when timer
 122:common/prog/ped_fw/timer/system_timer.h ****  *            handling misses one or more trigger events. This usually means,
 123:common/prog/ped_fw/timer/system_timer.h ****  *            that target time is too short for given execution period of timer
 124:common/prog/ped_fw/timer/system_timer.h ****  *            scheduler handle function.
 125:common/prog/ped_fw/timer/system_timer.h ****  */
 126:common/prog/ped_fw/timer/system_timer.h **** #define STIM_STATUS_TRIGGERED   0x01U   ///< Timer actual time has reached target time
 127:common/prog/ped_fw/timer/system_timer.h **** #define STIM_STATUS_MISSED      0x02U   ///< Timer trigger event has occurred multiple times withou
 128:common/prog/ped_fw/timer/system_timer.h **** #define STIM_STATUS_OVERFLOW    0x04U   ///< Timer actual time has overflown its type - this should
 129:common/prog/ped_fw/timer/system_timer.h **** /* All status masks combined */
 130:common/prog/ped_fw/timer/system_timer.h **** #define STIM_STATUS_ALL         (STIM_STATUS_TRIGGERED  | \
 131:common/prog/ped_fw/timer/system_timer.h ****                                  STIM_STATUS_MISSED     | \
 132:common/prog/ped_fw/timer/system_timer.h ****                                  STIM_STATUS_OVERFLOW)
 133:common/prog/ped_fw/timer/system_timer.h **** 
 134:common/prog/ped_fw/timer/system_timer.h **** 
 135:common/prog/ped_fw/timer/system_timer.h **** /** \brief    Timer base definitions
 136:common/prog/ped_fw/timer/system_timer.h ****  *  \details  This definitions are used in target time calculations.
 137:common/prog/ped_fw/timer/system_timer.h ****  */
 138:common/prog/ped_fw/timer/system_timer.h **** #define STIM_TIME_BASE_MS       1U                          ///< millisecond time base
 139:common/prog/ped_fw/timer/system_timer.h **** #define STIM_TIME_BASE_SEC      1000U                       ///< second time base
 140:common/prog/ped_fw/timer/system_timer.h **** #define STIM_TIME_BASE_MIN      (STIM_TIME_BASE_SEC * 60U)  ///< minute time base
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccWguxs8.s 			page 57


 141:common/prog/ped_fw/timer/system_timer.h **** #define STIM_TIME_BASE_HOUR     (STIM_TIME_BASE_MIN * 60U)  ///< hour time base
 142:common/prog/ped_fw/timer/system_timer.h **** #define STIM_TIME_BASE_DAY      (STIM_TIME_BASE_HOUR * 24U) ///< day time base
 143:common/prog/ped_fw/timer/system_timer.h **** 
 144:common/prog/ped_fw/timer/system_timer.h **** /*lint -save -e9026  "function like macro defined" */
 145:common/prog/ped_fw/timer/system_timer.h **** /** \brief    Definitions used to calculate target time.
