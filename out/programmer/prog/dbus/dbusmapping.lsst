  19:app/prog/dbus/dbusmapping.c **** /** \file
  20:app/prog/dbus/dbusmapping.c ****  *     Mapping library for D-Bus-2 data link layer using one specific UART channel
  21:app/prog/dbus/dbusmapping.c ****  *
  22:app/prog/dbus/dbusmapping.c ****  *     The mapping layer needs about 40 byte extra ROM (RAM unchanged) for implementation of the fo
  23:app/prog/dbus/dbusmapping.c ****  *     functions (compared to using macros, hence no mapping layer):
  24:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_vInit(uint8_t ucIndex)
  25:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_vEnable(void)
  26:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_vDisableTxEvent(void)
  27:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_vEnableTxEvent(void)
  28:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_vDisableRxEvent(void)
  29:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_vEnableRxEvent(void)
  30:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_bIsRxError(void)
  31:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_ucGetStatus(void)
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccv9udXE.s 			page 2


  32:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_ucGetRxData(void)
  33:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_vSetTxData(uint8_t Data)
  34:app/prog/dbus/dbusmapping.c ****  *     \li DBM_UART_bIsRxOnGoing(void)\n\n
  35:app/prog/dbus/dbusmapping.c ****  *     And in the \b opposite direction, mapping of:
  36:app/prog/dbus/dbusmapping.c ****  *     \li DLL_vHandleRxEvent(void)
  37:app/prog/dbus/dbusmapping.c ****  *     \li DLL_vHandleTxEvent(void)\n
