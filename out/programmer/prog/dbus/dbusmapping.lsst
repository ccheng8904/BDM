 174:app/prog/dbus/dbusmapping.c **** #ifdef __DBM_DBUS_MAPPING_LOCK_TX_DISABLE
 175:app/prog/dbus/dbusmapping.c **** /*
 176:app/prog/dbus/dbusmapping.c **** The following section is used for Renesas adaptation:
 177:app/prog/dbus/dbusmapping.c **** Tx interrupt is not disabled, it is just locked, so that to
 178:app/prog/dbus/dbusmapping.c **** the overlaying layer the tx interrupt seems to be disabled..*/
 179:app/prog/dbus/dbusmapping.c **** /** Value used for signalising that the tx event is NOT locked (the overlaying
 180:app/prog/dbus/dbusmapping.c ****    layer believes that the tx interrupt is re-enabled, because DBM_UART_vEnableTxEvent()
 181:app/prog/dbus/dbusmapping.c ****    has been called). */
 182:app/prog/dbus/dbusmapping.c **** #define DBM_UART_TX_EVENT_ENABLED            0
 183:app/prog/dbus/dbusmapping.c **** /** Value used for signalising that the tx event is locked
 184:app/prog/dbus/dbusmapping.c ****    (the overlaying layer believes that the tx interrupt is disabled,
 185:app/prog/dbus/dbusmapping.c ****     because DBM_UART_vDisableTxEvent() has been called). */
 186:app/prog/dbus/dbusmapping.c **** #define DBM_UART_DISABLE_TX_EVENT            1
 187:app/prog/dbus/dbusmapping.c **** /** Value used for signalising that a tx event has occurred during the
 188:app/prog/dbus/dbusmapping.c ****    time that it has been locked (the overlaying layer believes that the
 189:app/prog/dbus/dbusmapping.c ****    tx interrupt is currently disabled, because DBM_UART_vDisableTxEvent()
 190:app/prog/dbus/dbusmapping.c ****    has been called). */
 191:app/prog/dbus/dbusmapping.c **** #define DBM_UART_TX_EVENT_DURING_LOCK_STATE  2
 192:app/prog/dbus/dbusmapping.c **** static uint8_t DBM_UART_ucTxDisabled = 0U;
 193:app/prog/dbus/dbusmapping.c **** static bool DBM_UART_bTxEventAlreadyEnabled = 0U;
 194:app/prog/dbus/dbusmapping.c **** #endif //__DBM_DBUS_MAPPING_LOCK_TX_DISABLE
 195:app/prog/dbus/dbusmapping.c **** 
 196:app/prog/dbus/dbusmapping.c **** #ifdef __DBM_DBUS_MAPPING_LOCK_RX_DISABLE
 197:app/prog/dbus/dbusmapping.c **** /*
 198:app/prog/dbus/dbusmapping.c **** The following section is used for necessary Renesas adaptation:
 199:app/prog/dbus/dbusmapping.c **** Rx interrupt is not disabled, it is just locked,
 200:app/prog/dbus/dbusmapping.c **** so that to the overlaying layer the rx interrupt seems to be disabled.
 201:app/prog/dbus/dbusmapping.c **** */
 202:app/prog/dbus/dbusmapping.c **** /** Value used for signalising that the rx event is NOT locked
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccv9udXE.s 			page 5


 203:app/prog/dbus/dbusmapping.c ****    (the overlaying layer believes that the rx interrupt is re-enabled,
 204:app/prog/dbus/dbusmapping.c ****     because DBM_UART_vEnableRxEvent() has been called). */
 205:app/prog/dbus/dbusmapping.c **** #define DBM_UART_RX_EVENT_ENABLED            0
 206:app/prog/dbus/dbusmapping.c **** /** Value used for signalising that the rx event is locked
 207:app/prog/dbus/dbusmapping.c ****    (the overlaying layer believes that the rx interrupt is disabled,
 208:app/prog/dbus/dbusmapping.c ****     because DBM_UART_vDisableRxEvent() has been called). */
 209:app/prog/dbus/dbusmapping.c **** #define DBM_UART_DISABLE_RX_EVENT            1
 210:app/prog/dbus/dbusmapping.c **** /** Value used for signalising that an rx event has occurred during the time
 211:app/prog/dbus/dbusmapping.c ****    that it has been locked (the overlaying layer believes that the rx interrupt
 212:app/prog/dbus/dbusmapping.c ****    is currently disabled, because DBM_UART_vDisableRxEvent() has been called). */
 213:app/prog/dbus/dbusmapping.c **** #define DBM_UART_RX_EVENT_DURING_LOCK_STATE  2
 214:app/prog/dbus/dbusmapping.c **** /** Status byte used for not calling the rx interrupt handler if the
 215:app/prog/dbus/dbusmapping.c ****     rx interrupt has been disabled (the UART interrupt is in fact not disabled,
 216:app/prog/dbus/dbusmapping.c ****     but the overlaying layer believes this...)
 217:app/prog/dbus/dbusmapping.c **** */
 218:app/prog/dbus/dbusmapping.c **** static uint8_t DBM_UART_ucRxDisabled = 0U;
 219:app/prog/dbus/dbusmapping.c **** 
 220:app/prog/dbus/dbusmapping.c **** 
 221:app/prog/dbus/dbusmapping.c **** /** Variable used for keeping a byte, which is received during the time that
 222:app/prog/dbus/dbusmapping.c ****     the rx interrupt is locked, according to the state of DBM_UART_ucRxDisabled.
 223:app/prog/dbus/dbusmapping.c **** */
 224:app/prog/dbus/dbusmapping.c **** static uint8_t DBM_UART_ucRxData;
 225:app/prog/dbus/dbusmapping.c **** 
 226:app/prog/dbus/dbusmapping.c **** /** Variable used for keeping possible errors, which occur during the time that
 227:app/prog/dbus/dbusmapping.c ****     the rx interrupt is locked, according to the state of DBM_UART_ucRxDisabled.
 228:app/prog/dbus/dbusmapping.c **** */
 229:app/prog/dbus/dbusmapping.c **** static uint8_t DBM_UART_ucRxError;
 230:app/prog/dbus/dbusmapping.c **** #endif // __DBM_DBUS_MAPPING_LOCK_RX_DISABLE
