  57:app/prog/dbus/dbusmapping.c **** #ifdef DOXY_DEVELOPERS_DOC
  58:app/prog/dbus/dbusmapping.c **** /* Doxygen documentation of compiler switches */
  59:app/prog/dbus/dbusmapping.c **** 
  60:app/prog/dbus/dbusmapping.c **** /** Compiler switch. When defined functional safety is regarded.
  61:app/prog/dbus/dbusmapping.c **** */ #define __DBM_DBUS_MAPPING_INCLUDE_FUNCSAFE
  62:app/prog/dbus/dbusmapping.c **** 
  63:app/prog/dbus/dbusmapping.c **** /** Compiler switch. When defined an external interrupt is used for
  64:app/prog/dbus/dbusmapping.c ****     determining IDLE state. This is usedful for controller, which don't have
  65:app/prog/dbus/dbusmapping.c ****     ReceiveOngoing or IDLE flags available.
  66:app/prog/dbus/dbusmapping.c **** */ #define __DBM_USE_IRQ_FOR_IDLE_DETECTION
  67:app/prog/dbus/dbusmapping.c **** 
  68:app/prog/dbus/dbusmapping.c **** /** Compiler switch handled by the make process. When defined initally the
  69:app/prog/dbus/dbusmapping.c ****     transmit interrupt handler will be called manually. This is due to the fact
  70:app/prog/dbus/dbusmapping.c ****     that some controllers do not set the interrupt pending flag after enabling
  71:app/prog/dbus/dbusmapping.c ****     the transmit interrupt, when the transmit buffer is empty.
  72:app/prog/dbus/dbusmapping.c **** */ #define __DBM_INITIAL_MANUAL_TX_INT_CALL_NEEDED
  73:app/prog/dbus/dbusmapping.c **** 
  74:app/prog/dbus/dbusmapping.c **** /** Compiler switch. When defined RxInterrupt is not disabled, when requested, but locked.
  75:app/prog/dbus/dbusmapping.c **** */ #define __DBM_DBUS_MAPPING_LOCK_RX_DISABLE
  76:app/prog/dbus/dbusmapping.c **** 
  77:app/prog/dbus/dbusmapping.c **** /** Compiler switch. When defined TxInterrupt is not disabled, when requested, but locked.
  78:app/prog/dbus/dbusmapping.c **** */ #define __DBM_DBUS_MAPPING_LOCK_TX_DISABLE
  79:app/prog/dbus/dbusmapping.c **** 
  80:app/prog/dbus/dbusmapping.c **** /** Compiler switch. Definition needed for mapping D-Bus-2 mapping layer to a specific DBUS_UART_CH
  81:app/prog/dbus/dbusmapping.c **** */ #define DBUS_UART_CHANNEL 0
  82:app/prog/dbus/dbusmapping.c **** 
  83:app/prog/dbus/dbusmapping.c **** /** Compiler switch for removing the defined UART error counters. Usage introduced to the D-Bus-2 L
  84:app/prog/dbus/dbusmapping.c **** */ #define __DBM_EXCLUDE_ERROR_COUNTERS
  85:app/prog/dbus/dbusmapping.c **** #endif
