 553:common/prog/dbus/bal.c ****       {
 554:common/prog/dbus/bal.c ****          if (DLL_GET_ACKNOWLEDGE(ucAcknowledge) == DLL_ACK_TRANSMISSION_ABORTED)
 555:common/prog/dbus/bal.c ****          {
 556:common/prog/dbus/bal.c ****             //Collision appeared
