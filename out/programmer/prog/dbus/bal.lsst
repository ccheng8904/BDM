 491:common/prog/dbus/bal.c ****          BAL_uiTransmitFlagSubsystemIndex |= (uint16_t)((uint16_t)1u<<(uint16_t)ucSubsystemIndex); 
 492:common/prog/dbus/bal.c ****          UTI_vSetBit(BAL_tBusObject[ucSubsystemIndex].pucMessageToTransmitBits, ucMessageNumber, tr
