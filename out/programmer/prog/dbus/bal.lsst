 579:common/prog/dbus/bal.c ****             }
 580:common/prog/dbus/bal.c ****          }
 581:common/prog/dbus/bal.c ****          //The message, which was tried sent last time has not yet been acknowledged. Check whether
 582:common/prog/dbus/bal.c ****          if (BAL_ucTransmissionAttempts >= BAL_ucMaxRetries)
