 589:common/prog/dbus/bal.c ****             return;
 590:common/prog/dbus/bal.c ****          }
 591:common/prog/dbus/bal.c ****       }
 592:common/prog/dbus/bal.c ****       BAL_ucTransmissionAttempts = 0U;  //Reset the counter, which counts the retries of last messa
 593:common/prog/dbus/bal.c ****       BAL_ucMaxRetries = 0U;
 594:common/prog/dbus/bal.c ****    }
 595:common/prog/dbus/bal.c ****    else
 596:common/prog/dbus/bal.c ****    {
 597:common/prog/dbus/bal.c ****       //This is a service message.
 598:common/prog/dbus/bal.c ****       if (DLL_GET_ACKNOWLEDGE(ucAcknowledge) == DLL_ACK_OK)
 599:common/prog/dbus/bal.c ****       {
