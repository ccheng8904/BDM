 497:common/prog/dbus/bal.c ****          BAL_vNotifyError((uint8_t)BAL_ERROR_UNKNOWN_MESSAGE_FOR_TRANSMISSION);
 498:common/prog/dbus/bal.c ****       }
 499:common/prog/dbus/bal.c ****    }
 500:common/prog/dbus/bal.c **** 
 501:common/prog/dbus/bal.c ****    //Set eventflag, to run DBR_Handle_BAL()
 502:common/prog/dbus/bal.c ****    DBR_RunEventdrivenDbusTask( DBR_ED_TASK_BAL );
 503:common/prog/dbus/bal.c **** 
 504:common/prog/dbus/bal.c ****    BAL_vExitCriticalSectionforSending();
 505:common/prog/dbus/bal.c **** }
