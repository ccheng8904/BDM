 271:common/prog/mem_utility/ring_buffer.c **** 
 272:common/prog/mem_utility/ring_buffer.c **** bool RBUF_readBuff(struct RBUF_ringBuffer *rb, uint8_t *buff, RBUF_size_t len)
 273:common/prog/mem_utility/ring_buffer.c **** {
 274:common/prog/mem_utility/ring_buffer.c ****     if(RBUF_getBytesToRead(rb) >= len)
 275:common/prog/mem_utility/ring_buffer.c ****     {
 276:common/prog/mem_utility/ring_buffer.c ****         RBUF_popn(rb, buff, len);
 277:common/prog/mem_utility/ring_buffer.c ****         return true;
 278:common/prog/mem_utility/ring_buffer.c ****     }
 279:common/prog/mem_utility/ring_buffer.c ****     else
 280:common/prog/mem_utility/ring_buffer.c ****     {
 281:common/prog/mem_utility/ring_buffer.c ****         return false; // not enough data available
 282:common/prog/mem_utility/ring_buffer.c ****     }
 283:common/prog/mem_utility/ring_buffer.c **** }
 284:common/prog/mem_utility/ring_buffer.c **** 
 285:common/prog/mem_utility/ring_buffer.c **** 
 286:common/prog/mem_utility/ring_buffer.c **** RBUF_size_t RBUF_readAll(struct RBUF_ringBuffer *rb, uint8_t *buff, RBUF_size_t maxLen)
 287:common/prog/mem_utility/ring_buffer.c **** {
