 387:common/prog/mem_utility/ring_buffer.c **** /** pops a number of byte form the tail of ring buffer.
 388:common/prog/mem_utility/ring_buffer.c ****  *  \note The caller is responsible to make sure that enough bytes are available
 389:common/prog/mem_utility/ring_buffer.c ****  *        in the ring buffer
 390:common/prog/mem_utility/ring_buffer.c ****  *
 391:common/prog/mem_utility/ring_buffer.c ****  *  \param rb   pointer to ring buffer object
 392:common/prog/mem_utility/ring_buffer.c ****  *  \param data data buffer where to pop data
 393:common/prog/mem_utility/ring_buffer.c ****  */
 394:common/prog/mem_utility/ring_buffer.c **** static void RBUF_popn(struct RBUF_ringBuffer *rb, uint8_t *data, RBUF_size_t len)
 395:common/prog/mem_utility/ring_buffer.c **** {
 396:common/prog/mem_utility/ring_buffer.c ****     for(RBUF_size_t i=0; i<len; i++)
 397:common/prog/mem_utility/ring_buffer.c ****     {
 398:common/prog/mem_utility/ring_buffer.c ****         data[i] = rb->buffer[rb->read];
 399:common/prog/mem_utility/ring_buffer.c ****         RBUF_incrementReadIdx(rb);
 400:common/prog/mem_utility/ring_buffer.c ****     }
