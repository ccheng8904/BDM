 372:common/prog/mem_utility/ring_buffer.c ****  *  \note The caller is responsible to make sure that at least one byte is available
 373:common/prog/mem_utility/ring_buffer.c ****  *        in the ring buffer
 374:common/prog/mem_utility/ring_buffer.c ****  *
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccp18Fjf.s 			page 8


 375:common/prog/mem_utility/ring_buffer.c ****  *  \param rb   pointer to ring buffer object
 376:common/prog/mem_utility/ring_buffer.c ****  *  \return     byte form tail of ring buffer
 377:common/prog/mem_utility/ring_buffer.c ****  */
 378:common/prog/mem_utility/ring_buffer.c **** static uint8_t RBUF_pop(struct RBUF_ringBuffer *rb)
 379:common/prog/mem_utility/ring_buffer.c **** {
