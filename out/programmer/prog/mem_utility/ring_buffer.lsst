 304:common/prog/mem_utility/ring_buffer.c **** 
 305:common/prog/mem_utility/ring_buffer.c **** RBUF_size_t RBUF_getBytesToRead(const struct RBUF_ringBuffer *rb)
 306:common/prog/mem_utility/ring_buffer.c **** {
 307:common/prog/mem_utility/ring_buffer.c ****     RBUF_disableIrq();
 308:common/prog/mem_utility/ring_buffer.c ****     RBUF_size_t writeIdx = rb->write;
 309:common/prog/mem_utility/ring_buffer.c ****     RBUF_size_t readIdx = rb->read;
 310:common/prog/mem_utility/ring_buffer.c ****   #ifdef RBUF_WRITE_REENTRANT
 311:common/prog/mem_utility/ring_buffer.c ****     if(rb->reentered > 0u)
 312:common/prog/mem_utility/ring_buffer.c ****     {   // incoming data reception
 313:common/prog/mem_utility/ring_buffer.c ****         writeIdx = rb->incoming;
 314:common/prog/mem_utility/ring_buffer.c ****     }
 315:common/prog/mem_utility/ring_buffer.c ****   #endif
 316:common/prog/mem_utility/ring_buffer.c ****     RBUF_enableIrq();
 317:common/prog/mem_utility/ring_buffer.c ****     if (writeIdx >= readIdx)
ARM GAS  C:\Users\SX2605~1.HOD\AppData\Local\Temp\ccp18Fjf.s 			page 7


 318:common/prog/mem_utility/ring_buffer.c ****     {
 319:common/prog/mem_utility/ring_buffer.c ****         return (RBUF_size_t)(writeIdx - readIdx);
 320:common/prog/mem_utility/ring_buffer.c ****     }
 321:common/prog/mem_utility/ring_buffer.c ****     else
 322:common/prog/mem_utility/ring_buffer.c ****     {
 323:common/prog/mem_utility/ring_buffer.c ****         return (RBUF_size_t)((rb->size + writeIdx) - readIdx);
 324:common/prog/mem_utility/ring_buffer.c ****     }
 325:common/prog/mem_utility/ring_buffer.c **** }
 326:common/prog/mem_utility/ring_buffer.c **** 
 327:common/prog/mem_utility/ring_buffer.c **** 
 328:common/prog/mem_utility/ring_buffer.c **** RBUF_size_t RBUF_getCapacity(const struct RBUF_ringBuffer *rb)
 329:common/prog/mem_utility/ring_buffer.c **** {
