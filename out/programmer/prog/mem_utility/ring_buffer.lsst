 185:common/prog/mem_utility/ring_buffer.c **** 
 186:common/prog/mem_utility/ring_buffer.c ****     /* Start protected writing into ring buffer
 187:common/prog/mem_utility/ring_buffer.c ****        Protect incoming data to be read before finished */
 188:common/prog/mem_utility/ring_buffer.c ****     RBUF_size_t myIndex = RBUF_openWriteOperation(rb, len);
