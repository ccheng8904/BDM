 475:common/prog/mem_utility/ring_buffer.c **** static void RBUF_closeWriteOperation(struct RBUF_ringBuffer *rb)
 476:common/prog/mem_utility/ring_buffer.c **** {
 477:common/prog/mem_utility/ring_buffer.c ****   #ifdef RBUF_WRITE_REENTRANT
 478:common/prog/mem_utility/ring_buffer.c ****     RBUF_disableIrq();
 479:common/prog/mem_utility/ring_buffer.c ****     rb->reentered--;
 480:common/prog/mem_utility/ring_buffer.c ****     if(rb->reentered == 0u)
 481:common/prog/mem_utility/ring_buffer.c ****     {   //no nested write operation ongoing!
 482:common/prog/mem_utility/ring_buffer.c ****         rb->incoming = rb->write;
 483:common/prog/mem_utility/ring_buffer.c ****     }
 484:common/prog/mem_utility/ring_buffer.c ****     RBUF_enableIrq();
