 338:common/prog/mem_utility/ring_buffer.c **** /** pushes a single byte to the head of the ring buffer.
 339:common/prog/mem_utility/ring_buffer.c ****  *  \note The caller is responsible to make sure that at least one byte is free
 340:common/prog/mem_utility/ring_buffer.c ****  *        in ring buffer
 341:common/prog/mem_utility/ring_buffer.c ****  *
 342:common/prog/mem_utility/ring_buffer.c ****  *  \param rb   pointer to ring buffer object
 343:common/prog/mem_utility/ring_buffer.c ****  *  \param data byte to push
 344:common/prog/mem_utility/ring_buffer.c ****  */
 345:common/prog/mem_utility/ring_buffer.c **** static void RBUF_push(struct RBUF_ringBuffer *rb, uint8_t data)
 346:common/prog/mem_utility/ring_buffer.c **** {
 347:common/prog/mem_utility/ring_buffer.c ****     rb->buffer[rb->write] = data;
 348:common/prog/mem_utility/ring_buffer.c ****     RBUF_incrementWriteIdx(rb);
 349:common/prog/mem_utility/ring_buffer.c **** }
 350:common/prog/mem_utility/ring_buffer.c **** 
 351:common/prog/mem_utility/ring_buffer.c **** 
 352:common/prog/mem_utility/ring_buffer.c **** /** pushes a buffer of bytes to the head of the ring buffer.
 353:common/prog/mem_utility/ring_buffer.c ****  *  \note The caller is responsible to make sure that enough space is available
 354:common/prog/mem_utility/ring_buffer.c ****  *        in ring buffer
 355:common/prog/mem_utility/ring_buffer.c ****  *
 356:common/prog/mem_utility/ring_buffer.c ****  *  \param rb     pointer to ring buffer object
 357:common/prog/mem_utility/ring_buffer.c ****  *  \param data   buffer to push
 358:common/prog/mem_utility/ring_buffer.c ****  *  \param len    number of bytes to push
 359:common/prog/mem_utility/ring_buffer.c ****  *  \param index  position in ring buffer to copy data
 360:common/prog/mem_utility/ring_buffer.c ****  */
 361:common/prog/mem_utility/ring_buffer.c **** static void RBUF_pushn(const struct RBUF_ringBuffer *rb, const uint8_t *data, RBUF_size_t len, RBUF
 362:common/prog/mem_utility/ring_buffer.c **** {
 363:common/prog/mem_utility/ring_buffer.c ****     for(RBUF_size_t i=0; i<len; i++)
 364:common/prog/mem_utility/ring_buffer.c ****     {
 365:common/prog/mem_utility/ring_buffer.c ****         rb->buffer[index] = data[i];
 366:common/prog/mem_utility/ring_buffer.c ****         RBUF_addToIndex(rb, &index,1u);
 367:common/prog/mem_utility/ring_buffer.c ****     }
 368:common/prog/mem_utility/ring_buffer.c **** }
