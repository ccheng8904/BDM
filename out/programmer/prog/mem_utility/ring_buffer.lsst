 162:common/prog/mem_utility/ring_buffer.c **** {
 163:common/prog/mem_utility/ring_buffer.c ****     if(len == 0u){return 0u;} // length of zero always ok
 164:common/prog/mem_utility/ring_buffer.c ****     
 165:common/prog/mem_utility/ring_buffer.c ****     RBUF_disableIrq();
 166:common/prog/mem_utility/ring_buffer.c ****     RBUF_size_t wrlen = RBUF_getFreeSpaceIntern(rb);
 167:common/prog/mem_utility/ring_buffer.c ****     if( wrlen > len){wrlen = len;}
 168:common/prog/mem_utility/ring_buffer.c ****     /* Start protected writing into ring buffer
 169:common/prog/mem_utility/ring_buffer.c ****        Protect incoming data to be read before finished */
 170:common/prog/mem_utility/ring_buffer.c ****     RBUF_size_t myIndex = RBUF_openWriteOperation(rb, wrlen);
 171:common/prog/mem_utility/ring_buffer.c ****     RBUF_enableIrq();
 172:common/prog/mem_utility/ring_buffer.c ****     if(myIndex != RBUF_invalidIndex)
 173:common/prog/mem_utility/ring_buffer.c ****     {
 174:common/prog/mem_utility/ring_buffer.c ****         RBUF_pushn(rb, data, wrlen, myIndex);
 175:common/prog/mem_utility/ring_buffer.c ****         RBUF_closeWriteOperation(rb);
 176:common/prog/mem_utility/ring_buffer.c ****         return wrlen;
 177:common/prog/mem_utility/ring_buffer.c ****     }
 178:common/prog/mem_utility/ring_buffer.c ****     return 0;
 179:common/prog/mem_utility/ring_buffer.c **** }
