 289:common/prog/mem_utility/ring_buffer.c ****     
 290:common/prog/mem_utility/ring_buffer.c ****     if (len > maxLen){len = maxLen;}
 291:common/prog/mem_utility/ring_buffer.c ****     RBUF_popn(rb, buff, len);
