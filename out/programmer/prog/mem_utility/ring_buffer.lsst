 412:common/prog/mem_utility/ring_buffer.c ****     {   //no nested write operation ongoing!
 413:common/prog/mem_utility/ring_buffer.c ****         rb->incoming = rb->write;
 414:common/prog/mem_utility/ring_buffer.c ****     }
 415:common/prog/mem_utility/ring_buffer.c ****   #endif
 416:common/prog/mem_utility/ring_buffer.c **** }
