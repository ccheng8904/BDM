{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    // All build tasks are forwarded by make.bat to common\build\makefile (GNU make)
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make link",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "make relink",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "relink"
            ],
            "problemMatcher": []
        },
        {
            "label": "make all",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "all"
            ],
            "problemMatcher": []
        },
        {
            "label": "make clean_all",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "clean_all"
            ],
            "problemMatcher": []
        },
        {
            "label": "make release",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "release"
            ],
            "problemMatcher": []
        },
        {
            // Prefer J-Link direct flash; if the device is unsupported or the
            // J-Link command fails, the script automatically falls back to WinFlash.
            "label": "make flash (prefer J-Link)",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "flash"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            // Flash only, no rebuild; tries J-Link first and falls back to WinFlash.
            "label": "make flash_no_link (prefer J-Link)",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "flash_no_link"
            ],
            "problemMatcher": []
        },
        {
            "label": "make verify (WinFlash UART)",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "verify"
            ],
            "problemMatcher": []
        },
        {
            // Start the J-Link GDB server in its own terminal before debugging
            // with the "J-Link Debug BDM (external GDB server)" launch configuration
            "label": "jlink gdb server",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "debug"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            // Connectivity check without a debugger: starts the J-Link GDB
            // server for 5 s and lists the detected J-Link probes
            "label": "jlink connect check",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "debug",
                "batch"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "gdb attach (console)",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "gdb"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
